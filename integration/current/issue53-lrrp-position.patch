diff --git a/core/dmr/dmrLrrp.c b/core/dmr/dmrLrrp.c
index 055c779..4bb8a0c 100644
--- a/core/dmr/dmrLrrp.c
+++ b/core/dmr/dmrLrrp.c
@@ -272,6 +272,86 @@ static int putRequestId(uint8_t *out, const uint8_t *requestId, int requestIdLen
 	return n + requestIdLength;
 }
 
+#if CONFIG_DMR_LRRP
+int lrrpBuildImmediateRequest(uint32_t id, uint8_t out[LRRP_MAX_DOCUMENT])
+{
+	const uint8_t key[4] = { id >> 24, id >> 16, id >> 8, id };
+	uint8_t tokens[7];
+	int n = putRequestId(tokens, key, (int)sizeof key);
+	tokens[n++] = 0x50;  // request position with an accuracy radius
+	return finishDocument(0x05, tokens, n, out);
+}
+
+static uint32_t read_u32(reader_t *r)
+{
+	uint32_t v = 0;
+	for (unsigned i = 0; i < 4; i++)
+		v = (v << 8) | readByte(r);
+	return v;
+}
+
+bool lrrpDecodeImmediateReport(const uint8_t *payload, int length, uint32_t id,
+				       bool *fix, int32_t *lat, int32_t *lon)
+{
+	if (length < 2 || payload[0] != DOC_IMMEDIATE_RESPONSE)
+		return false;
+	reader_t r = { .d = payload, .i = 1, .end = length };
+	uint32_t n = readUintvar(&r);
+	if (r.error || n != (uint32_t)(length - r.i))
+		return false;
+	uint32_t result = LRRP_RESULT_SUCCESS, latitude = 0, longitude = 0;
+	bool matched = false, found = false, result_seen = false;
+	while (!r.error && r.i < r.end) {
+		switch (readByte(&r)) {
+		case TOK_REQUEST_ID:
+			if (matched || readUintvar(&r) != 4 || read_u32(&r) != id)
+				return false;
+			matched = true;
+			break;
+		case TOK_RESULT:
+			if (result_seen)
+				return false;
+			result = readUintvar(&r);
+			result_seen = true;
+			break;
+		case TOK_RESULT_OK:
+			if (result_seen)
+				return false;
+			result_seen = true;
+			break;
+		case TOK_POSITION_RADIUS:
+			if (found)
+				return false;
+			latitude = read_u32(&r);
+			longitude = read_u32(&r);
+			skipUfloatvar(&r);
+			found = true;
+			break;
+		case TOK_INFO_TIME:
+			for (unsigned i = 0; i < 5; i++)
+				readByte(&r);
+			break;
+		case TOK_DIRECTION:
+			readByte(&r);
+			break;
+		case TOK_SPEED_HOR:
+			skipUfloatvar(&r);
+			break;
+		default:
+			return false;
+		}
+	}
+	if (r.error || !matched || (!found && result == LRRP_RESULT_SUCCESS))
+		return false;
+	*fix = found && result == LRRP_RESULT_SUCCESS;
+	int32_t mag = (int32_t)((((uint64_t)latitude & 0x7fffffffu) * 900000000u + (1u << 30)) >> 31);
+	*lat = latitude >> 31 ? -mag : mag;
+	int64_t signed_lon = longitude >> 31 ? (int64_t)longitude - INT64_C(4294967296) : longitude;
+	*lon = (int32_t)(signed_lon * INT64_C(3600000000) / INT64_C(4294967296));
+	return true;
+}
+#endif
+
 // A coordinate in 1e-7 degree, as dmr_gps_range takes it: minutes10000 / 600000 degree is minutes10000 * 50 / 3 in
 // 1e-7, rounded half up
