index e82d31d..c21180c 100644
--- a/tests/host/dmrDataServiceTest.c
+++ b/tests/host/dmrDataServiceTest.c
@@ -632,6 +632,67 @@ static void testLrrp(void)
 }
 
 
+#if CONFIG_DMR_LRRP
+static void answerLocation(uint32_t src, uint32_t token, const lrrpPosition_t *position)
+{
+	uint8_t doc[LRRP_MAX_DOCUMENT];
+	lrrpRequest_t req;
+	int n = lrrpBuildImmediateRequest(token, doc);
+	CHECK(lrrpDecodeRequest(doc, n, &req));
+	n = lrrpBuildImmediateResponse(&req, position, doc);
+	dmrBurst_t bursts[DMR_DATA_MAX_BURSTS];
+	int count = dmrDataBuildUDP(false, OUR_ID, src, DMR_UDP_PORT_LRRP, DMR_UDP_PORT_LRRP,
+				    doc, n, DMR_TYPE_RATE_1_2, 1, bursts, DMR_DATA_MAX_BURSTS);
+	rxBursts(bursts, count);
+}
+
+static void testLocationQuery(void)
+{
+	reset();
+	settings.lrrpReply = false;  // asking does not turn on sharing one's own location
+	CHECK(!dmr_lrrp_request_position(ch.ownId));
+	CHECK(dmr_lrrp_request_position(LRRP_SERVER));
+	CHECK(!dmr_lrrp_request_position(LRRP_SERVER));
+	runMainTask(700);
+	CHECK(countLrrp(0x05) == 1 && lrrpQuery.sent);
+	uint32_t token = lrrpQuery.token;
+	answerLocation(LRRP_SERVER + 1, token, NULL);
+	answerLocation(LRRP_SERVER, token + 1, NULL);
+	CHECK(lrrpQuery.dst == LRRP_SERVER);
+	lrrpPosition_t found;
+	lrrpPositionFromE7(-338500000, 1512100000, 0xffff, 0xffff, 0xffffffff, 0, &found);
+	answerLocation(LRRP_SERVER, token, &found);
+	dmrDataEvent_t e = dmr_data_last_event();
+	CHECK(e.kind == DMR_DATA_EV_POSITION && e.id == LRRP_SERVER);
+	CHECK(e.lat_e7 >= -338500010 && e.lat_e7 <= -338499990);
+	CHECK(e.lon_e7 >= 1512099990 && e.lon_e7 <= 1512100010);
+
+	CHECK(dmr_lrrp_request_position(LRRP_SERVER));
+	runMainTask(700);
+	answerLocation(LRRP_SERVER, lrrpQuery.token, NULL);
+	CHECK(dmr_data_last_event().kind == DMR_DATA_EV_POSITION_NO_FIX);
+
+	CHECK(dmr_lrrp_request_position(LRRP_SERVER));
+	runMainTask(15000);
+	CHECK(dmr_data_last_event().kind == DMR_DATA_EV_POSITION_FAILED);
+
+	CHECK(dmr_lrrp_request_position(LRRP_SERVER));
+	runMainTask(10);
+	ch.channelKey++;
+	runMainTask(20);
+	CHECK(dmr_data_last_event().kind == DMR_DATA_EV_POSITION_FAILED);
+
+	// Even a channel change before the next radio-task tick must cancel a queued position request.
+	int sent = countLrrp(0x05);
+	CHECK(dmr_lrrp_request_position(LRRP_SERVER));
+	ch.channelKey++;
+	runMainTask(700);
+	CHECK(countLrrp(0x05) == sent);
+	CHECK(dmr_data_last_event().kind == DMR_DATA_EV_POSITION_FAILED);
+	settings.lrrpReply = true;
+}
+#endif
