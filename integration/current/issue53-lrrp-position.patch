+			lrrpQuery.serial = now ^ channel.channelKey ^ channel.ownId;
+		lrrpQuery.token = ++lrrpQuery.serial;
+		lrrpQuery.since = now;
+		lrrpQuery.submitted = lrrpQuery.sent = false;
