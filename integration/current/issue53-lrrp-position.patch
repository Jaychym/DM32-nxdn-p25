+#if CONFIG_DMR_LRRP
+static void test_immediate_query(void)
+{
+	uint8_t wire[LRRP_MAX_DOCUMENT];
+	lrrpRequest_t req;
+	uint32_t token = 0x81a53f09u;
+	int n = lrrpBuildImmediateRequest(token, wire);
+	static const uint8_t expected[] = { 5, 7, 0x22, 4, 0x81, 0xa5, 0x3f, 9, 0x50 };
+	CHECK(n == (int)sizeof expected && memcmp(wire, expected, sizeof expected) == 0);
+	CHECK(lrrpDecodeRequest(wire, n, &req) && req.requestIdLength == 4 && req.wanted == LRRP_WANT_ACCURACY);
+	lrrpPosition_t pos;
+	lrrpPositionFromE7(194891520, -988700190, 0xffff, 0xffff, 0xffffffff, 0, &pos);
+	bool fix;
+	int32_t lat, lon;
+	n = lrrpBuildImmediateResponse(&req, &pos, wire);
+	CHECK(lrrpDecodeImmediateReport(wire, n, token, &fix, &lat, &lon) && fix);
+	CHECK(lat >= 194891510 && lat <= 194891530);
+	CHECK(lon >= -988700200 && lon <= -988700180);
+	CHECK(!lrrpDecodeImmediateReport(wire, n, token + 1, &fix, &lat, &lon));
+	CHECK(!lrrpDecodeImmediateReport(wire, n - 1, token, &fix, &lat, &lon));
+	n = lrrpBuildImmediateResponse(&req, NULL, wire);
+	CHECK(lrrpDecodeImmediateReport(wire, n, token, &fix, &lat, &lon) && !fix);
+}
+#endif
+
