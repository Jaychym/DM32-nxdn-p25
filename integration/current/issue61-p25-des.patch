@@ -108 +108,36 @@ test("DMR AES-128 and AES-256 can use the same ID independently", () => {
 });
+
+test("P25 DES-OFB lists only DES keys and preserves the selected cipher on disk", () => {
+	const m = empty();
+	const p25 = newChannel({ name: "P25", rxHz: 433000000, txHz: 433000000 });
+	setKind(m, p25, 2);
+	m.channels.push(p25);
+	m.keyring = [{ alg: 0x81, id: 0, key: "133457799BBCDFF1" }, { alg: 0x84, id: 5, key: "AB".repeat(32) }];
+	const fields = channelForm(m, (s) => s, { features: "P25,P25_DES" });
+	const aes = fields.find((f) => f.key === "k2.aes");
+	const des = fields.find((f) => f.key === "k2.des");
+	assert.ok(des.show(p25));
+	assert.deepEqual(des.options(p25).map(([id]) => id), [null, 0]);
+	assert.deepEqual(aes.options(p25).map(([id]) => id), [null, 5]);
+	aes.set(p25, 5);
+	des.set(p25, 0);
+	aes.set(p25, null);
+	assert.equal(aes.get(p25), null);
+	assert.equal(des.get(p25), 0);
+	const image = encode(m);
+	const restored = decode(image);
+	assert.equal(restored.channels[0].params.des, true);
+	assert.equal(restored.channels[0].params.aes, false);
+	assert.equal(restored.channels[0].params.keyId, 0);
+	assert.ok(restored.keyring.some((k) => k.alg === 0x81 && k.key === "133457799BBCDFF1"));
+	assert.equal(validKeyHex(0x81, "AB".repeat(32)), false);
+	const exported = image.clone();
+	withoutSecrets(exported.bytes);
+	assert.deepEqual(decode(exported).keyring, []);
+	aes.set(p25, 5);
+	assert.equal(des.get(p25), null);
+	assert.equal(aes.get(p25), 5);
+	const disabled = channelForm(m, (s) => s, { features: "P25" }).find((f) => f.key === "k2.des");
+	assert.equal(Boolean(disabled.show(p25)), false);
+	assert.ok(disabled.show(restored.channels[0]));
+});
