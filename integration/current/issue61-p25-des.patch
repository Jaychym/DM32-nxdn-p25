+		if (after_lsd)
+			des_ofb_skip(&o->des, 2);
+		des_ofb_xor(&o->des, voice, P25_IMBE_BYTES);
+		return;
+	}
+#else
+	(void)alg;
+#endif
+	if (after_lsd)
+		aes_ofb_skip(&o->aes, 2);
+	aes_ofb_xor(&o->aes, voice, P25_IMBE_BYTES);
