+	41,52,31,37,47,55, 30,40,51,45,33,48, 44,49,39,56,34,53, 46,42,50,36,29,32,
+};
+static const uint8_t shift[] = { 1,1,2,2,2,2,2,2,1,2,2,2,2,2,2,1 };
+static const uint8_t s[8][4][16] = {
