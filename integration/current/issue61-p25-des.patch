+static void ofb_start(p25_ofb_t *o, uint8_t alg, const uint8_t *key, const uint8_t *mi, bool ldu2)
+{
+#if CONFIG_P25_DES
+	if (alg == P25_ALGID_DES_OFB) {
+		des_ofb_init(&o->des, key, mi);
+		// Skip the first OFB block and the header interval. LDU2 follows an LDU1 including its LSD.
+		des_ofb_skip(&o->des, DES_BLOCK_BYTES + P25_IMBE_BYTES +
+			     (ldu2 ? P25_VOICE_FRAMES * P25_IMBE_BYTES + 2u : 0u));
+		return;
+	}
+#else
+	(void)alg;
+#endif
+	p25_aes_start(&o->aes, key, mi, ldu2);
