+#if CONFIG_P25_DES
+#include "des.h"
+
+// FIPS 46-3, pp. 10–16. Positions are one-based from the most significant bit.
+static const uint8_t ip[] = {
+	58,50,42,34,26,18,10,2, 60,52,44,36,28,20,12,4,
+	62,54,46,38,30,22,14,6, 64,56,48,40,32,24,16,8,
