+
+static uint64_t permute(uint64_t input, uint8_t bits, const uint8_t *positions, size_t n)
+{
+	uint64_t output = 0;
+	for (size_t i = 0; i < n; i++)
+		output = (output << 1) | ((input >> (bits - positions[i])) & 1u);
+	return output;
+}
+
+static uint64_t read64(const uint8_t b[8])
+{
+	uint64_t v = 0;
+	for (size_t i = 0; i < 8; i++)
+		v = (v << 8) | b[i];
+	return v;
+}
+
+static uint32_t rotate28(uint32_t v, uint8_t n)
+{
+	return ((v << n) | (v >> (28u - n))) & 0x0FFFFFFFu;
+}
+
+static uint64_t encrypt(uint64_t block, uint64_t key)
+{
+	uint32_t c = (uint32_t)(key >> 28), d = (uint32_t)key & 0x0FFFFFFFu;
+	uint64_t state = permute(block, 64, ip, sizeof ip);
+	uint32_t l = (uint32_t)(state >> 32), r = (uint32_t)state;
+
+	for (size_t round = 0; round < sizeof shift; round++) {
+		c = rotate28(c, shift[round]);
+		d = rotate28(d, shift[round]);
+		uint64_t subkey = permute(((uint64_t)c << 28) | d, 56, pc2, sizeof pc2);
+		uint64_t expanded = permute(r, 32, expand, sizeof expand) ^ subkey;
+		uint32_t substituted = 0;
+		for (uint8_t i = 0; i < 8; i++) {
+			uint8_t chunk = (uint8_t)((expanded >> (42u - 6u * i)) & 0x3Fu);
+			uint8_t row = (uint8_t)(((chunk >> 4) & 2u) | (chunk & 1u));
+			uint8_t col = (uint8_t)((chunk >> 1) & 15u);
+			substituted = (substituted << 4) | s[i][row][col];
+		}
+		uint32_t next = l ^ (uint32_t)permute(substituted, 32, p, sizeof p);
+		l = r;
+		r = next;
+	}
+	return permute(((uint64_t)r << 32) | l, 64, fp, sizeof fp);
+}
+
+void des_ofb_init(des_ofb_t *o, const uint8_t key[DES_KEY_BYTES], const uint8_t iv[DES_BLOCK_BYTES])
+{
+	o->key = permute(read64(key), 64, pc1, sizeof pc1);
+	o->feedback = read64(iv);
+	o->pos = DES_BLOCK_BYTES;
+}
+
+static void step(des_ofb_t *o)
+{
+	if (o->pos == DES_BLOCK_BYTES) {
+		o->feedback = encrypt(o->feedback, o->key);
+		o->pos = 0;
+	}
+}
+
+void des_ofb_xor(des_ofb_t *o, uint8_t *buf, size_t n)
+{
+	for (size_t i = 0; i < n; i++) {
+		step(o);
+		buf[i] ^= (uint8_t)(o->feedback >> (56u - 8u * o->pos));
+		o->pos++;
+	}
+}
+
+void des_ofb_skip(des_ofb_t *o, size_t n)
+{
+	while (n != 0) {
+		step(o);
+		size_t available = DES_BLOCK_BYTES - o->pos;
+		size_t take = n < available ? n : available;
+		o->pos += (uint8_t)take;
+		n -= take;
+	}
+}
+#endif
diff --git a/core/crypto/des.h b/core/crypto/des.h
new file mode 100644
index 0000000..8f5446c
--- /dev/null
+++ b/core/crypto/des.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+#ifndef RFOUNDRY_DES_H
+#define RFOUNDRY_DES_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define DES_KEY_BYTES 8u
+#define DES_BLOCK_BYTES 8u
+
+// Single DES in full-block OFB mode (FIPS 46-3, SP 800-38A).
+typedef struct {
+	uint64_t key;			// the 56 effective key bits, in PC-1 order
+	uint64_t feedback;		// the keystream block
+	uint8_t pos;			// octets already consumed in the block
+} des_ofb_t;
+
+void des_ofb_init(des_ofb_t *o, const uint8_t key[DES_KEY_BYTES], const uint8_t iv[DES_BLOCK_BYTES]);
+void des_ofb_xor(des_ofb_t *o, uint8_t *buf, size_t n);
+void des_ofb_skip(des_ofb_t *o, size_t n);
+
+#endif
