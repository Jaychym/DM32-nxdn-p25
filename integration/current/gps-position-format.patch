+	}
+	void (*coord)(sbuf_t *, int32_t, char, char) = format == UI_POS_DMS ? sb_dms : sb_coord;
+	char buf[24];
+	sbuf_t b;
+	sb_init(&b, buf, sizeof buf);
+	coord(&b, p->lat_e7, 'N', 'S');
+	if (!row(y, TR(GPS_LABEL_LAT, "Lat"), buf, ui_col.fg))
+		return false;
+	sb_init(&b, buf, sizeof buf);
+	coord(&b, p->lon_e7, 'E', 'W');
+	return row(y, TR(GPS_LABEL_LON, "Lon"), buf, ui_col.fg);
+}
