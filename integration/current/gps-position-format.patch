+#if CONFIG_GPS_UTM
+typedef struct {
+	uint8_t zone;
+	uint32_t east, north;
+} gps_utm_t;
+
+// WGS 84. Snyder, USGS PP 1395, equations (8-9), (8-10), (3-21).
+static bool project_utm(int32_t lat_e7, int32_t lon_e7, gps_utm_t *utm)
+{
+	if (lat_e7 < -800000000 || lat_e7 > 840000000 || lon_e7 < -1800000000 || lon_e7 > 1800000000)
+		return false;
+	unsigned zone = lon_e7 == 1800000000 ? 60u : (uint32_t)(lon_e7 + 1800000000LL) / 60000000u + 1u;
+	if (lat_e7 >= 560000000 && lat_e7 < 640000000 && lon_e7 >= 30000000 && lon_e7 < 120000000)
+		zone = 32;
+	if (lat_e7 >= 720000000 && lon_e7 >= 0 && lon_e7 < 420000000)
+		zone = lon_e7 < 90000000 ? 31 : lon_e7 < 210000000 ? 33 : lon_e7 < 330000000 ? 35 : 37;
+	const double rad = 0.017453292519943295;
+	const double a = 6378137.0, k = 0.9996;
+	const double e2 = 0.0066943799901413165, e4 = e2 * e2, e6 = e4 * e2;
+	const double ep2 = e2 / (1.0 - e2);
+	double phi = lat_e7 * (1e-7 * rad);
+	double dlambda = (lon_e7 * 1e-7 - ((int)zone * 6 - 183)) * rad;
+	double s = sin(phi), c = cos(phi), s2 = s * s, c2 = c * c;
+	double t = s2 / c2, ecc = ep2 * c2;
+	double v = a / sqrt(1.0 - e2 * s2);
+	double d = dlambda * c, d2 = d * d, d4 = d2 * d2;
+	// sin(2 phi), sin(4 phi), and sin(6 phi) from the same sine and cosine.
+	double s2p = 2.0 * s * c, s4p = 2.0 * s2p * (c2 - s2);
+	double s6p = s2p * (3.0 - 4.0 * s2p * s2p);
+	double m = a * ((1.0 - e2 / 4.0 - 3.0 * e4 / 64.0 - 5.0 * e6 / 256.0) * phi
+		 - (3.0 * e2 / 8.0 + 3.0 * e4 / 32.0 + 45.0 * e6 / 1024.0) * s2p
+		 + (15.0 * e4 / 256.0 + 45.0 * e6 / 1024.0) * s4p - (35.0 * e6 / 3072.0) * s6p);
+	double east = 500000.0 + k * v * d * (1.0 + (1.0 - t + ecc) * d2 / 6.0
+		 + (5.0 - 18.0 * t + t * t + 72.0 * ecc - 58.0 * ep2) * d4 / 120.0);
+	double north = k * (m + v * (s / c) * d2 * (0.5 + (5.0 - t + 9.0 * ecc + 4.0 * ecc * ecc) * d2 / 24.0
+		 + (61.0 - 58.0 * t + t * t + 600.0 * ecc - 330.0 * ep2) * d4 / 720.0));
+	if (lat_e7 < 0)
+		north += 10000000.0;
+	utm->zone = (uint8_t)zone;
+	utm->east = (uint32_t)(east + 0.5);
+	utm->north = (uint32_t)(north + 0.5);
+	return true;
+}
+
+static bool draw_utm(const ui_position_t *p, int *y)
+{
+	static int32_t lat, lon;
+	static bool valid, cached;
+	static gps_utm_t u;
+	if (!cached || lat != p->lat_e7 || lon != p->lon_e7) {
+		lat = p->lat_e7;
+		lon = p->lon_e7;
+		valid = project_utm(lat, lon, &u);
+		cached = true;
+	}
+	if (!valid)
+		return row(y, "UTM", "-", ui_col.dim);
+
+	char buf[24];
+	sbuf_t b;
+	sb_init(&b, buf, sizeof buf);
+	sb_u32(&b, u.zone, 1);
+	sb_chr(&b, lat < 0 ? 'S' : 'N');
+	sb_chr(&b, ' ');
+	sb_u32(&b, u.east, 1);
+	sb_chr(&b, 'E');
+	if (!row(y, "UTM", buf, ui_col.fg))
+		return false;
+	sb_init(&b, buf, sizeof buf);
+	sb_u32(&b, u.north, 1);
+	sb_chr(&b, 'N');
+	return row(y, "", buf, ui_col.fg);
+}
+#endif
