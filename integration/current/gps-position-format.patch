+static void gps_format_checks(void)
+{
+	static const struct { uint8_t format; const char *expect; } cases[] = {
+		{ UI_POS_DEGREES, "expect:shows=42.360100_N" },
+		{ UI_POS_DMS, "expect:shows=42_21'36.3\"N expect:hides=42.360100_N" },
+		{ UI_POS_GRID, "expect:shows=FN42li expect:hides=42.360100_N" },
+#if CONFIG_GPS_UTM
+		// Boston (42.3601 N, 71.0589 W), independently projected with PROJ EPSG:32619.
+		{ UI_POS_UTM, "expect:shows=19N_330448E expect:shows=4691812N expect:hides=42.360100_N" },
+#endif
+	};
+	char err[300];
+	for (int g = 0; g < sim_geom_count; g++) {
+		for (size_t i = 0; i < sizeof cases / sizeof cases[0]; i++) {
+			sim_reset(&sim_geoms[g], SIM_MAP_K);
+			ui_svc_setting_set(UI_SET_POS_FORMAT, cases[i].format);
+			if (!sim_run("ok 6 2 expect:screen=gps expect:shows=4_km/h", err, sizeof err) ||
+			    !sim_run(cases[i].expect, err, sizeof err)) {
+				printf("FAIL GPS format %u [%s]: %s\n", cases[i].format, sim_geoms[g].name, err);
+				fails++;
+			}
+		}
+	}
+}
+#endif
+
