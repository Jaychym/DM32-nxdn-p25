 static bool dual_wait_service(radio_sm_t *sm, const radio_status_t *st, uint32_t now_ms)
 {
 	scan_t *sc = &sm->scan;
 	uint32_t dwell = sc->cfg.dwell_ms;
 	sc->cfg.delay_ms = sm->set.dual_delay_ms;	// a new setting applies at once
 	if (sm->dual_peek) {
+#if CONFIG_DMR || CONFIG_AIR
+		bool playing = false;
+#if CONFIG_DMR
+		playing = sm->view.ch.mode == RADIO_MODE_DMR && sm->view.dmr.state == RDMR_RX;
+#endif
+#if CONFIG_AIR
+		playing = playing || (air_mode(sm->view.ch.mode) && air_heard(sm) == AIR_HEARD_PLAYED);
+#endif
+		if (playing) {
+			sm->dual_peek = false;
+			dual_busy_set(sm, (uint8_t)(sm->view.dual_busy & ~(1u << sm->dual_at)));
+			sc->phase = SCAN_PH_LISTEN;
+			sc->phase_ms = now_ms;
+			return false;	// scan_service holds the playing call on this frequency
+		}
+#endif
 		uint32_t since = now_ms - sc->tuned_ms;
 		if (since >= sc->cfg.settle_ms && scan_carrier_heard(sm, st, now_ms)) {
 			sm->dual_peek_heard = true;
