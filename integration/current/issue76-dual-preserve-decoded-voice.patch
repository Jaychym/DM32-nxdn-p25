+// A call which starts playing during a look lasts past that look on either side of the watch.
+static void test_dual_dmr_call_during_peek(void)
+{
+	const radio_dual_ref_t home = { false, 0, 0 }, dmr = { false, 0, 5 };
+	for (uint8_t side = 0; side < 2; side++) {
+		start();
+		dual(side ? home : dmr, side ? dmr : home, (uint8_t)!side);
+		signal_on(0, 146520000, 30, no_tone);
+		run(300);
+		CHECK(on_ref(home) && sm.view.scan_phase == SCAN_PH_HOLD);
+		hw.sig[0].hz = 0;
+		CHECK(wait_on(dmr, 500) && sm.dual_peek);
+		uint8_t lc[9];
+		mk_lc(lc, 9, 9995555);
+		run(25);
+		burst_lc(lc, 1, false);
+		burst_voice(0, 1, NULL);
+		run(25);
+		CHECK(on_ref(dmr) && sm.view.dmr.state == RDMR_RX && aud.pcm);
+		for (uint8_t b = 1; b < 6; b++) {
+			burst_voice(b, 1, b == 5 ? lc : NULL);
+			run(60);
+		}
+		CHECK(on_ref(dmr) && sm.view.scan_phase == SCAN_PH_HOLD && !sm.dual_peek);
+		CHECK(sm.view.dmr.state == RDMR_RX && aud.pcm && sm.dual_sel == (uint8_t)!side);
+		burst_lc(lc, 1, true);
+		run(100);
+		CHECK(on_ref(dmr) && sm.view.scan_phase == SCAN_PH_RESUME);
+		CHECK(wait_on(home, 1300) && sm.view.scan == SCAN_DUAL);
+	}
+}
