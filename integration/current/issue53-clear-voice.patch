-	bool voice_lock = ui_voice_lock_for_tx(v);
+	if (!titled && st == RS_IDLE && !v->hotspot && !v->aprs_tx && lx + f->w + voice_lock_width(f) <= rx) {
+		bool voice_lock = ui_voice_lock_for_tx(v), voice_clear = ui_voice_clear_for_tx(v);
 #if CONFIG_DUAL_WATCH
-	if (s->dual.on)
-		voice_lock = s->home_compact_dual && s->dual.pane[s->dual.sel].tx_voice_lock;
+		if (s->dual.on) {
+			const ui_dual_pane_t *pane = &s->dual.pane[s->dual.sel];
+			voice_lock = pane->tx_voice_lock;
+			voice_clear = pane->tx_voice_clear;
+		}
 #endif
-	if (!titled && st == RS_IDLE && !v->hotspot && voice_lock && lx + f->w + voice_lock_width(f) <= rx)
-		lx = draw_voice_lock(f, lx + f->w / 2, ty, swarn);
+		if (voice_lock)
+			lx = draw_voice_lock(f, lx + f->w / 2, ty, swarn);
+		else if (voice_clear)
+			lx = draw_clear_voice(f, lx + f->w / 2, ty, sfg);
+	}
 #if CONFIG_DUAL_WATCH
 	if (s->dual.on && !v->aprs_tx && strip_fits(f, lx, rx, TR(TOP_CHIP_DUAL, "DUAL")))
 		lx = gfx_text(f, lx + f->w, ty, TR(TOP_CHIP_DUAL, "DUAL"), swarn);
