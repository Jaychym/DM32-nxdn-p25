--- a/core/ui/ui_screens.c
+++ b/core/ui/ui_screens.c
@@ -504,6 +504,29 @@ bool ui_voice_lock_for_tx(const radio_view_t *v)
 	}
 }
 
+bool ui_voice_clear_for_tx(const radio_view_t *v)
+{
+#if CONFIG_DMR
+	return v->ch.mode == RADIO_MODE_DMR && v->dmr.active && v->dmr.codec &&
+	       !v->ch.rx_only && !v->aprs_tx && !v->tx_auto && !v->hotspot &&
+	       !v->dmr.privacy && v->dmr.tx_privacy == RDMR_PRIVACY_NONE;
+#else
+	(void)v;
+	return false;
+#endif
+}
+
+static int draw_clear_voice(const font_t *f, int x, int y, color_t color)
+{
+	int d = voice_lock_height(f) - 2;
+	int top = y + (f->h - d) / 2;
+	gfx_hline(x + 1, top, d - 2, color);
+	gfx_hline(x + 1, top + d - 1, d - 2, color);
+	gfx_vline(x, top + 1, d - 2, color);
+	gfx_vline(x + d - 1, top + 1, d - 2, color);
+	return x + d + f->w / 2;
+}
+
 // Status strip (P2): state pill, mode, monitor, lock, unread messages, signal, battery.
 // A titled screen (prefix and / or name) on a display under UI_TALL_PX high merges its title into the strip
