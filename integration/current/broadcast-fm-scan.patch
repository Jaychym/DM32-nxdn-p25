+@pytest.mark.feature("bcast_fm")
+def test_broadcast_vfo_scan_grid(radio):
+    need_vfo(radio, "BCAST_FM")
+    if radio.link.view(["features"]).get("scan.built") != "1":
+        skip("not_built", "built without CONFIG_SCAN")
+    with radio.vfo_session():
+        v = tune(radio, BCAST_HZ)
+        step = int(v["vfo_step_hz"])
+        assert step in (100000, 200000), v
+        last = BCAST_HZ + step
+        tune(radio, last)
+        # The requested range starts between stations. Wrapping must land on the first station on the grid.
+        radio.link.scan_vfo(BCAST_HZ - step - step // 4, last + step // 4)
+        try:
+            v = radio.wait_for(lambda view: view.get("scan") == "vfo" and view.get("rx_hz") != str(last),
+                               sections=("core", "features"), what="broadcast scan past its wrap")
+            assert v.get("bcast") == "1" and int(v["rx_hz"]) in (BCAST_HZ - step, BCAST_HZ), v
+        finally:
+            radio.link.scan("cancel")
+            radio.wait_for(lambda view: view.get("scan") == "off", sections=("features",), what="scan off")
