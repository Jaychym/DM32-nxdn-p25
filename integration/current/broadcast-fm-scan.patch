+#if CONFIG_SCAN
+static void test_bcast_scan(void)
+{
+	start();
+	req(RREQ_VFO_SET, 107900000);
+	bc.sig_khz = 65100;
+	bc.rssi = 70;
+	bc.settle_ms = 2u * RADIO_POLL_MS;
+	req(RREQ_SCAN, RSCAN_TOGGLE);
+	CHECK(sm.view.scan == SCAN_VFO && sm.view.bcast && bc.khz == 65100);
+	run(RADIO_POLL_MS);
+	CHECK(sm.view.scan_phase == SCAN_PH_LISTEN && bc.khz == 65100 && !bc.audio);
+	run(RADIO_POLL_MS);
+	CHECK(sm.view.scan_phase == SCAN_PH_HOLD && sm.view.state == RS_RX && bc.audio && bc.khz == 65100);
+	req(RREQ_SCAN, RSCAN_STOP);
+
+	// A manually entered off-grid frequency should not shift the scan's channel grid.
+	bc.settle_ms = 0;
+	req(RREQ_VFO_SET, 90250000);
+	req(RREQ_SCAN, RSCAN_TOGGLE);
+	CHECK(sm.view.scan == SCAN_VFO && bc.khz == 90300);
+	req(RREQ_SCAN, RSCAN_CANCEL);
+	CHECK(sm.view.ch.rx_hz == 90250000);
+
+	// At 100 kHz spacing, the scan wraps before leaving the broadcast receiver for air-band AM.
+	radio_settings_t s = sm.set;
+	s.bcast_step = RADIO_BCAST_STEP_100;
+	radio_sm_set_settings(&sm, &s, now);
+	int am_calls = hw.am_calls;
+	req(RREQ_VFO_SET, 107900000);
+	req(RREQ_SCAN, RSCAN_TOGGLE);
+	CHECK(sm.view.scan == SCAN_VFO && sm.view.bcast && bc.khz == 65000);
+	CHECK(hw.am_calls == am_calls && hw.tx_calls == 0);
+	req(RREQ_SCAN, RSCAN_STOP);
+
+	// A tuner that fails to settle should not leave the scan stuck on one frequency.
+	bc.settle_ms = 1000;
+	req(RREQ_VFO_SET, 90150000);
+	req(RREQ_SCAN, RSCAN_TOGGLE);
+	CHECK(bc.khz == 90200);
+	run(250);
+	CHECK(sm.view.scan == SCAN_VFO && bc.khz == 90300);
+}
+#endif
+
