diff --git a/core/ui/ui_rssi.c b/core/ui/ui_rssi.c
new file mode 100644
index 0000000..87d72a1
--- /dev/null
+++ b/core/ui/ui_rssi.c
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// Copyright (c) 2026 lyra XE1POC
+#include "config.h"
+#if CONFIG_RSSI_GRAPH
+#include "ui_nav.h"
+#include "fmt.h"
+
+#define SAMPLE_MS 100u
+#define MAX_SECONDS 30u
+#define HISTORY_SIZE (MAX_SECONDS * 1000u / SAMPLE_MS + 1u)
+#define FIXED_LO (-150)
+#define FIXED_HI (-30)
+#define RSSI_OFFSET 160
+
+static const uint8_t seconds[] = { 2, 5, 10, 20, MAX_SECONDS };
+static uint8_t window;
+static bool auto_scale;
+static uint8_t history[HISTORY_SIZE]; // dBm + RSSI_OFFSET, or zero for a missing sample
+static uint16_t next, count;
+static uint32_t frequency, last_ms;
+
+static void append(uint8_t sample)
+{
+	history[next] = sample;
+	next = (uint16_t)((next + 1u) % HISTORY_SIZE);
+	if (count < HISTORY_SIZE)
+		count++;
+}
+
+static uint8_t sample_at(unsigned age)
+{
+	return history[(next + HISTORY_SIZE - 1u - age) % HISTORY_SIZE];
+}
+
+void ui_rssi_tick(const radio_view_t *v, uint32_t now_ms)
+{
+	if (frequency != v->ch.rx_hz) {
+		frequency = v->ch.rx_hz;
+		count = next = 0;
+	}
+	unsigned elapsed = count ? (now_ms - last_ms) / SAMPLE_MS : 1u;
+	if (elapsed == 0)
+		return;
+
+	last_ms = count ? last_ms + elapsed * SAMPLE_MS : now_ms;
+	if (elapsed >= HISTORY_SIZE) {
+		count = next = 0;
+	} else {
+		for (unsigned n = 1; n < elapsed; n++)
+			append(0);
+	}
+
+	uint8_t sample = 0;
+	if (frequency && v->rssi_sample_hz == frequency && now_ms - v->rssi_sample_ms < SAMPLE_MS &&
+	    v->state != RS_TX && !v->rx_sleeping && !v->scan && v->rssi_sample_dbm < 0) {
+		int encoded = v->rssi_sample_dbm + RSSI_OFFSET;
+		sample = encoded > 0 ? (uint8_t)encoded : 1u;
+	}
+	append(sample);
+	ui_dirty();
+}
+
+static void scale_range(unsigned visible, int *lo, int *hi)
+{
+	*lo = FIXED_LO;
+	*hi = FIXED_HI;
+	if (!auto_scale)
+		return;
+
+	uint8_t weakest = 255, strongest = 0;
+	for (unsigned age = 0; age < visible; age++) {
+		uint8_t s = sample_at(age);
+		if (!s)
+			continue;
+		if (s < weakest)
+			weakest = s;
+		if (s > strongest)
+			strongest = s;
+	}
+	if (!strongest)
+		return;
+
+	// Snap to 10 dB, with headroom and at least a 20 dB span.
+	*lo = ((int)weakest - 1) / 10 * 10 - RSSI_OFFSET;
+	*hi = ((int)strongest / 10 + 1) * 10 - RSSI_OFFSET;
+	if (*hi - *lo < 20)
+		*lo = *hi - 20;
+}
+
+static void draw_value(const font_t *font, int x, int y, int value, color_t color)
+{
+	char text[8];
+	sbuf_t b;
+	sb_init(&b, text, sizeof text);
+	sb_i32(&b, value);
+	gfx_text(font, x, y, text, color);
+}
+
+static void graph_draw(void)
+{
+	const radio_view_t *v = ui_view();
+	const font_t *font = ui_layout.small;
+	const font_t *tick = ui_layout.tiny;
+	const char *scale = auto_scale ? TR(VALUE_AUTO, "Auto") : TR(POS_VALUE_FIXED, "Fixed");
+	char text[24];
+	sbuf_t b;
+	sb_init(&b, text, sizeof text);
+	sb_u32(&b, seconds[window], 1);
+	sb_str(&b, " s ");
+	sb_str(&b, scale);
+	gfx_clear(ui_col.bg);
+	int y = ui_draw_top(v, &ui_st, TR(RSSI_GRAPH_TITLE, "RSSI graph"), text) + 2;
+
+	sb_init(&b, text, sizeof text);
+	sb_freq(&b, v->ch.rx_hz);
+	gfx_text(font, 0, y, text, ui_col.fg);
+
+	sb_init(&b, text, sizeof text);
+	uint8_t current = count ? sample_at(0) : 0;
+	if (current)
+		sb_i32(&b, (int)current - RSSI_OFFSET);
+	else
+		sb_str(&b, "--");
+	sb_str(&b, " dBm");
+	int w = gfx_width();
+	gfx_text(font, w - gfx_text_width(font, text), y, text, ui_col.fg);
+
+	unsigned span = seconds[window] * 1000u / SAMPLE_MS;
+	unsigned visible = count < span + 1u ? count : span + 1u;
+	int lo, hi;
+	scale_range(visible, &lo, &hi);
+	int left = gfx_text_width(tick, "-160") + 3, right = w - 1;
+	int top = y + font->h + 4, bottom = ui_layout.hint_y - tick->h - 3;
+	if (bottom > top && right > left) {
+		int mid = (top + bottom) / 2;
+		gfx_hline(left, top, right - left + 1, ui_col.line);
+		gfx_hline(left, mid, right - left + 1, ui_col.line);
+		gfx_hline(left, bottom, right - left + 1, ui_col.line);
+		gfx_vline(left, top, bottom - top + 1, ui_col.line);
+		draw_value(tick, 0, top, hi, ui_col.dim);
+		draw_value(tick, 0, mid - tick->h / 2, (lo + hi) / 2, ui_col.dim);
+		draw_value(tick, 0, bottom - tick->h, lo, ui_col.dim);
+
+		int last_x = -1, last_y = 0;
+		for (unsigned age = visible; age-- > 0;) {
+			uint8_t s = sample_at(age);
+			if (!s) {
+				last_x = -1;
+				continue;
+			}
+			int x = right - (int)(age * (unsigned)(right - left) / span);
+			int dbm = (int)s - RSSI_OFFSET;
+			int plot_y = dbm < lo ? bottom : dbm > hi ? top : top + (hi - dbm) * (bottom - top) / (hi - lo);
+			if (last_x < 0) {
+				gfx_pixel(x, plot_y, ui_col.rx);
+			} else {
+				gfx_hline(last_x, last_y, x - last_x + 1, ui_col.rx);
+				int first = plot_y < last_y ? plot_y : last_y;
+				int last = plot_y > last_y ? plot_y : last_y;
+				gfx_vline(x, first, last - first + 1, ui_col.rx);
+			}
+			last_x = x;
+			last_y = plot_y;
+		}
+		sb_init(&b, text, sizeof text);
+		sb_chr(&b, '-');
+		sb_u32(&b, seconds[window], 1);
+		sb_str(&b, " s");
+		gfx_text(tick, left, bottom + 1, text, ui_col.dim);
+		gfx_text(tick, w - gfx_text_width(tick, "0 s"), bottom + 1, "0 s", ui_col.dim);
+	}
+	ui_draw_bottom(&ui_st, TR(RSSI_GRAPH_HINT, "Up/Down Time  OK Scale"));
+	ui_draw_banner(&ui_st);
+}
+
+static bool graph_key(const input_event_t *ev)
+{
+	if (ev->gesture == GESTURE_PRESS && ev->action == ACT_SELECT) {
+		auto_scale = !auto_scale;
+	} else if ((ev->gesture == GESTURE_PRESS || ev->gesture == GESTURE_REPEAT) &&
+	           (ev->action == ACT_NAV_UP || ev->action == ACT_NAV_DOWN)) {
+		if (ev->action == ACT_NAV_UP && window + 1u < sizeof seconds)
+			window++;
+		else if (ev->action == ACT_NAV_DOWN && window)
+			window--;
+	} else {
+		return false;
+	}
+	ui_dirty();
+	return true;
+}
+
+static void graph_enter(void)
+{
+	next = count = 0;
+}
+
+void ui_rssi_reset(void)
+{
+	window = 1;
+	auto_scale = false;
+	graph_enter();
+}
+
+const ui_scr_def_t ui_rssi_graph_screen = {
+	.name = "rssi-graph", .flags = SF_FIELD, .prefix = TRN(RSSI_GRAPH_TITLE, "RSSI graph"),
+	.draw = graph_draw, .key = graph_key, .enter = graph_enter,
+};
+#endif
