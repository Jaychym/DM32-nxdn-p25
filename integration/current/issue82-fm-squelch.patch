@@ -1190,6 +1190,49 @@ static void test_channel_squelch(void)
 	setup_codeplug();
 }
 
+static void test_fm_squelch_level_one_margin(void)
+{
+	setup_codeplug();
+	start();
+	req(RREQ_SQUELCH, 1 - RADIO_SQUELCH_DEFAULT);
+
+	rx_signal(65, true);
+	poll_for(RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_IDLE && !hw.audio);	// the default threshold is still 64
+	fake_radio.fm_squelch_l1_margin = 2;
+	rx_signal(66, true);
+	poll_for(RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_IDLE && !hw.audio);	// a reading exactly at the opening line stays shut
+	rx_signal(65, true);
+	poll_for(RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_RX && hw.audio);	// a weak carrier in the board's opening margin
+	rx_signal(66, true);
+	poll_for(3 * RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_RX && hw.audio);	// the hysteresis still holds through a small fade
+	rx_signal(68, true);
+	poll_for(RADIO_SQL_CLOSE_POLLS * RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_IDLE && !hw.audio);	// the weakest documented idle noise still closes it
+
+	req(RREQ_SQUELCH, 1);
+	rx_signal(61, true);
+	poll_for(RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_IDLE && !hw.audio);	// level 2 still opens below 61
+	rx_signal(60, true);
+	poll_for(RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_RX && hw.audio);
+
+	req(RREQ_ZONE, 2);
+	req(RREQ_CH_STEP, 1);				// RX DCS 754
+	req(RREQ_SQUELCH, 1 - sm.view.squelch);
+	rx_signal(65, false);
+	poll_for(RADIO_TONE_ON_POLLS * RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_IDLE && !hw.audio);
+	rx_signal(65, true);
+	poll_for(RADIO_TONE_ON_POLLS * RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_RX && hw.audio);	// a larger carrier margin still requires the RX tone
+	fake_radio.fm_squelch_l1_margin = 0;
+}
+
