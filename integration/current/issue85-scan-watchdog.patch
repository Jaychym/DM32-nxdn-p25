+static void test_radio_task_deadlines(void)
+{
+	uint32_t due = 100;
+	CHECK(radio_deadline_advance(due, RADIO_POLL_MS, 105) == 125);
+	CHECK(radio_deadline_advance(due, RADIO_POLL_MS, 125) == 150);
+	for (int i = 0; i < 200; i++) {
+		uint32_t finished = due + 35;	// a retune that outlasts the polling period
+		due = radio_deadline_advance(due, RADIO_POLL_MS, finished);
+		CHECK(due == finished + RADIO_POLL_MS);
+	}
+	CHECK(radio_deadline_advance(UINT32_MAX - 19, RADIO_POLL_MS, UINT32_MAX - 3) == 5);
+	CHECK(radio_deadline_advance(UINT32_MAX - 19, RADIO_POLL_MS, 9) == 34);
+}
+
 int main(void)
 {
+	test_radio_task_deadlines();
 	test_scan_engine();
 	test_battery_module();
 	test_beep_module();
