diff --git a/core/radio/radio_deadline.h b/core/radio/radio_deadline.h
new file mode 100644
index 0000000..b485fd3
--- /dev/null
+++ b/core/radio/radio_deadline.h
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// Copyright (c) 2026 lyra XE1POC
+#ifndef RADIO_DEADLINE_H
+#define RADIO_DEADLINE_H
+
+#include <stdint.h>
+
+// Preserve periodic scheduling until an operation overruns, then allow a full interval for other tasks to run.
+// The RTOS counter wraps. The subtraction compares deadlines within half a counter period.
+static inline uint32_t radio_deadline_advance(uint32_t due, uint32_t period, uint32_t finished)
+{
+	uint32_t next = due + period;
+	return (int32_t)(finished - next) >= 0 ? finished + period : next;
+}
+
+#endif
