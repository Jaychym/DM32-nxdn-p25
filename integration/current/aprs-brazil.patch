 	CHECK(pb.fix_lat == -337000000 && pb.fix_lon == 1512000000 && pb.fix_alt_m == -12 && b.interval_s == 900 &&
 	      b.distance_m == 2500 && b.level == 63 && b.txdelay == 45 && b.via == APRS_VIA_BOTH && b.dmr_dst == 5057 &&
 	      b.digi == 2);
+	// The appended preset persists without changing the stored Custom region ID.
+	CHECK(APRS_REGION_CUSTOM == 6 && aprs_region_hz(APRS_REGION_CUSTOM) == 0);
+	c.region = APRS_REGION_BR;
+	aprs_set_cfg(&c, now);
+	reload_settings();
+	run(200);
+	aprs_get_cfg(&b);
+	CHECK(b.region == APRS_REGION_BR && aprs_cfg_freq(&b) == 145570000u && b.freq_hz == 145825000u);
