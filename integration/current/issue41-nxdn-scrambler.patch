+static void test_nxdn_scrambler(void)
+{
+	setup_codeplug_nxdn();
+	add(3, "NXDN scrambler", 446100000, RADIO_MODE_DMR, false, 2);
+	chans[3].kind = CODEPLUG_KIND_NXDN_SCRAMBLER;
+	chans[3].system = CODEPLUG_SYSTEM_NONE;
+	stored_nxdn[3] = (nxdn_conv_cfg_t){ .conv = { .rate9600 = true, .scramble = true, .kid = 4, .tx_ran = 1 },
+					    .unit_id = 4321, .target = 20 };
+	start();
+	aud.feed = true;
+	int before = hw.tx_calls;
+#if CONFIG_NXDN_SCRAMBLER
+	const uint8_t key4[] = { CODEPLUG_SYSTEM_NONE, NXDN_CIPHER_SCRAMBLE, 4, 0, 0, 0x34, 0x12 };
+	const uint8_t key7[] = { CODEPLUG_SYSTEM_NONE, NXDN_CIPHER_SCRAMBLE, 7, 0, 0, 0x10, 0x32 };
+	kv_t3_clear();
+	kv_t3_set(CODEPLUG_KEY_TRAFFIC, key4, sizeof key4);
+	kv_t3_set(CODEPLUG_KEY_TRAFFIC + 1, key7, sizeof key7);
+	for (int rate = 0; rate <= 1; rate++) {
+		stored_nxdn[3].conv.rate9600 = rate != 0;
+		req(RREQ_ZONE_POS, 0);
+		req(RREQ_ZONE_POS, 2);
+		CHECK(radio_nxdn_running() && sm.view.ch.kind == CODEPLUG_KIND_NXDN_SCRAMBLER);
+		CHECK(((sm.view.nxdn.flags & RADIO_NXDN_9600) != 0) == (rate != 0));
+		nfar_scramble_tx = true;
+		nfar_scramble_id = 7; // RX uses the call's different installed key, not the TX selection.
+		nfar_begin(rate != 0, 1, 2001, false, 20);
+		CHECK(nxdn_engine_tx_prepare(&nfar) && nxdn_engine_tx_go(&nfar));
+		nfar_tx = true;
+		run(1100);
+		CHECK((sm.view.nxdn.flags & (RADIO_NXDN_ENC | RADIO_NXDN_PLAYED)) == (RADIO_NXDN_ENC | RADIO_NXDN_PLAYED));
+		nxdn_engine_tx_stop(&nfar);
+		run(550);
+		nfar_scramble_id = 8;
+		nfar_begin(rate != 0, 1, 2001, false, 20);
+		CHECK(nxdn_engine_tx_prepare(&nfar) && nxdn_engine_tx_go(&nfar));
+		nfar_tx = true;
+		run(1100);
+		CHECK((sm.view.nxdn.flags & (RADIO_NXDN_ENC | RADIO_NXDN_PLAYED)) == RADIO_NXDN_ENC);
+		nxdn_engine_tx_stop(&nfar);
+		run(550);
+		nfar_scramble_tx = false;
+		nfar_begin(rate != 0, 1, 2001, false, 20);
+		req(RREQ_PTT, 1);
+		CHECK(sm.view.state == RS_TX && hw.keyed);
+		run(1550);
+		req(RREQ_PTT, 0);
+		run(600);
+		CHECK(nfar_heard.call.vcall.cipher == NXDN_CIPHER_SCRAMBLE && nfar_heard.call.vcall.key_id == 4);
+		CHECK(nfar_heard.voice >= 30 && nfar_heard.enc >= 20);
+	}
+	nfar_stop();
+	before = hw.tx_calls;
+	// Deleting the stored key while still tuned refuses PTT without a channel change.
+	kv_t3_clear();
+#else
+	req(RREQ_ZONE_POS, 2);
+#endif
+	req(RREQ_PTT, 1);
+	CHECK(sm.view.state == RS_TX_DENIED && !hw.keyed && hw.tx_calls == before);
+	CHECK(sm.view.tx_deny == (CONFIG_NXDN_SCRAMBLER ? TXDENY_REFUSED : TXDENY_MODE));
