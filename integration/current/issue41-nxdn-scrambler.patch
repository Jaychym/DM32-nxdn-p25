+	const uint8_t key0[] = { CODEPLUG_SYSTEM_NONE, NXDN_CIPHER_SCRAMBLE, 0, 0, 0, 0x01, 0x00 };
+	const uint8_t key5[] = { CODEPLUG_SYSTEM_NONE, NXDN_CIPHER_SCRAMBLE, 5, 0, 0, 0x34, 0x12 };
