+	memset(keys, 0, sizeof(*keys) * (NXDN_CP_KID_MAX + 1u));
+	codeplug_kv_begin(&c, CODEPLUG_KEY_TRAFFIC, CODEPLUG_KEY_TRAFFIC + 0x3FFu);
