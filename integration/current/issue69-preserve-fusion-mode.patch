+test("A partial CSV preserves an existing YSF mode and transmit permission", () => {
+	const m = empty();
+	importTable(m, "Name,Mode,RX Frequency,RX Only,YSF DT,RX DG-ID\nRelay,Yaesu System Fusion,446.125,Yes,DN,17\n");
+	for (const partial of ["Name,RX Frequency\nRelay,446.25\n", "Name,RX Frequency,Mode,RX Only\nRelay,446.30,,\n"]) {
+		assert.deepEqual(importTable(m, partial).problems, []);
+		const [c] = decode(encode(m)).channels;
+		assert.equal(c.kind, 6);
+		assert.equal(c.tagTx, false);
+		assert.equal(c.params.dt, 2);
+		assert.equal(c.params.rxDgid, 17);
+	}
+	const records = m.channels;
+	for (const table of [undefined, "channels"]) {
+		assert.throws(() => importTable(m, "Relay,446.30,YSF\n", table), { code: "not_a_table" });
+		assert.equal(m.channels, records);
+	}
+});
+
+test("An invalid explicit channel mode cannot create a default FM channel", () => {
+	const m = empty();
+	const result = importTable(m, "Name,RX Frequency,Mode\nRelay,446.125,YSF-unknown\n");
+	assert.equal(result.added, 0);
+	assert.equal(result.problems[0].skipped, true);
+	assert.equal(m.channels.length, 0);
+	assert.equal(importTable(m, "Name,RX Frequency,Mode\nRelay,446.125,FM\n").added, 1);
+	assert.equal(m.channels[0].mode, "fm");
+});
+
