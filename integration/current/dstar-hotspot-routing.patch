@@ -38,6 +38,23 @@
 	assert.equal(saved.tagTx, true);
 	saved.tagTx = false;
 	assert.equal(round(first).channels.find((c) => c.name === "DV simplex").tagTx, false);
+});
+
+test("D-STAR: hotspot routes use fixed call fields and echo in the last column", () => {
+	const m = empty();
+	const ch = newChannel({ name: "DV node", rxHz: 433450000, txHz: 433450000 });
+	m.channels.push(ch);
+	setKind(m, ch, 9);
+	ch.params = { ur: "e", rpt1: "n0abc b", rpt2: "n0abc g" };
+	const first = round(m);
+	const saved = first.channels.find((c) => c.name === "DV node");
+	assert.deepEqual(saved.params, { ur: "       E", rpt1: "N0ABC  B", rpt2: "N0ABC  G" });
+	assert.ok(!validate(first).some((p) => p.code === "dstar_route_pair" || p.code === "dstar_rpt_format"));
+	saved.params.rpt2 = "";
+	assert.ok(validate(first).some((p) => p.code === "dstar_route_pair"));
+	saved.params.rpt1 = "";
+	saved.params.ur = "";
+	assert.deepEqual(round(first).channels.find((c) => c.name === "DV node").params, { ur: "", rpt1: "", rpt2: "" });
 });
 
