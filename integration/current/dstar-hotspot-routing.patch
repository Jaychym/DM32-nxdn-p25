+		if (!prev?.length && !calls.some(Boolean)) return grow(prev, 0);
+		const v = grow(prev, KEYS.length * CALL_LEN);
+		calls.forEach((call, i) => {
+			for (let j = 0; j < CALL_LEN; j++) v[i * CALL_LEN + j] = call.charCodeAt(j) || 0x20;
+		});
