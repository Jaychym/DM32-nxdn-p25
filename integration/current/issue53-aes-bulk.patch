+test("Bulk Edit AES selects installed keys of one scheme and clears only AES", () => {
+	const m = empty();
+	const byAlg = (token) => KEY_ALGS.find((x) => x.token === token);
+	m.keyring = ["dmr", "p25", "nxdn"].map((name, n) => ({ alg: byAlg(name).alg, id: n + 1, key: "ce".repeat(32) }));
+	const modes = [[0, "dmr"], [2, "p25"], [4, "nxdn"]];
+	for (const [n, [kind, mode]] of modes.entries()) {
+		const rows = [newChannel({ name: "One", mode: "dmr" }), newChannel({ name: "Two", mode: "dmr" })];
+		rows.forEach((r) => { r.kind = kind; });
+		const f = bulkColumns("channels", m, t, { rows }).find((c) => c.key === "bulkAes");
+		assert.equal(f.label, `editor.keys.alg.${mode}`);
+		assert.deepEqual(f.options().map(([k]) => k), [null, n + 1]);
+		for (const r of rows) assert.equal(f.set(r, n + 1), undefined);
+		for (const r of rows) {
+			assert.equal(kind ? r.params.aes : r.dmrPrivacy === DMR_PRIV.aes, true);
+			assert.equal(kind ? r.params.keyId : r.dmrPrivacyKey, n + 1);
+			f.set(r, null);
+			assert.equal(kind ? r.params.aes : r.dmrPrivacy === DMR_PRIV.aes, false);
+		}
+		if (!kind) {
+			rows[0].dmrPrivacy = DMR_PRIV.basic;
+			rows[0].dmrPrivacyKey = 23;
+			f.set(rows[0], null);
+			assert.equal(rows[0].dmrPrivacyKey, 23);
+		}
+		rows.push(newChannel({ name: "FM" }));
+		assert.equal(bulkColumns("channels", m, t, { rows }).some((c) => c.key === "bulkAes"), false);
+	}
+});
+
