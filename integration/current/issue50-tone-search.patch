+@pytest.mark.feature("tone_scan", optional=True)
+@pytest.mark.rf
+@pytest.mark.bench_service
+@pytest.mark.needs_switch("VFO_FM")
+@pytest.mark.parametrize("row, want, sub", [
+    (0, "ctcss:719", {"ctcss": 71.9}),
+    (1, "dcs_inv:19", {"dcs": "023I"}),
+], ids=["ctcss", "inverted-dcs"])
+def test_rx_tone_search_bench(radio, sdr_bench, pytestconfig, row, want, sub):
+    if "tone_search" not in radio.view(["channel"]):
+        skip("no_hw", "no receive tone search on this board")
+    mhz = rig(pytestconfig, "fm-mhz")
+    hz = round(mhz * 1e6)
+    radio.skip_out_of_band(hz)
+    radio.go_home()
+    with radio.vfo_session():
+        radio.link.vfo_set(hz)
+        radio.wait_for(lambda v: v.get("rx_hz") == str(hz) and v.get("mode") == "fm", what="FM VFO tuned")
+        before = radio.view(["channel"])
+        try:
+            for key in ("select", "6", "up", "select"):
+                radio.press(key)
+            assert radio.screen() == "tonescan"
+            if row:
+                radio.press("down")
+            radio.press("select")
+            with sdr_bench.lease():
+                tx = sdr_bench.fm_tx_start(mhz, FALLBACK_PROGRAM, **sub)
+                found = radio.wait_for(lambda v: v.get("tone_search") == "found", 5,
+                                       sections=("channel",), what="the tone search match")
+                assert not tx.wait(5).get("cut")
+            assert found["tone_search_tone"] == want, found
+            assert found["ch.rx_tone"] == before["ch.rx_tone"], found
+            for _ in range(2 - row):
+                radio.press("down")
+            radio.press("select")
+            applied = radio.wait_for(lambda v: v.get("ch.rx_tone") == want, 1,
+                                     sections=("channel",), what="the result applied to RX")
+            assert applied["ch.tx_tone"] == before["ch.tx_tone"], applied
+        finally:
+            radio.go_home()
+            kind, value = before["ch.rx_tone"].split(":")
+            radio.link.tone(2, kind, int(value))
