+#if CONFIG_TONE_SCAN
+static void tone_scan_request(radio_sm_t *sm, int32_t cmd, bool busy, uint32_t now_ms)
+{
+	if (cmd == RADIO_TSCAN_CANCEL) {
+		tone_scan_end(sm, RADIO_TSCAN_IDLE);
+		return;
+	}
+	if (busy || sm->ptt || sm->standby || sm->view.monitor || sm->view.ch.mode != RADIO_MODE_FM ||
+	    sm->view.am || sm->view.bcast || parked(&sm->view.ch) || board.radio->rx_tone_test == NULL)
+		return;
+#if CONFIG_SCAN
+	if (scan_on(&sm->scan))
+		return;
+#endif
+	if (cmd == RADIO_TSCAN_APPLY) {
+		if (sm->view.tone_scan_phase == RADIO_TSCAN_FOUND) {
+			uint32_t arg = (uint32_t)radio_tone_arg(RADIO_TONE_RX, sm->view.tone_scan_tone);
+			tone_scan_end(sm, RADIO_TSCAN_IDLE);
+			set_subtone(sm, arg, false, now_ms);
+		}
+		return;
+	}
+	if (cmd != RADIO_TSCAN_CTCSS && cmd != RADIO_TSCAN_DCS)
+		return;
+	tone_scan_end(sm, RADIO_TSCAN_IDLE);
+	end_reception(sm, now_ms);
+	sm->tone_scan_dcs = cmd == RADIO_TSCAN_DCS;
+	sm->tone_trial = sm->tone_scan_dcs ? TONES_CTCSS_COUNT + 1u : 1u;
+	sm->tone_scan_ms = now_ms;
+	sm->tone_matches = 0;
+	sm->view.tone_scan_phase = RADIO_TSCAN_WAIT;
+	outputs(sm);
+	changed(sm);
+}
+#endif
