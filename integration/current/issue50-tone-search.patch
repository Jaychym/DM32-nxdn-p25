+#if CONFIG_TONE_SCAN
+#define TONE_SCAN_LIMIT_MS 120000u
+#define TONE_SCAN_CTCSS_MS 325u
+#define TONE_SCAN_DCS_MS 450u
+
+static void tone_scan_trial(radio_sm_t *sm, uint32_t now_ms)
+{
+	subtone_t tone = tones_picker(sm->tone_trial);
+	if (!board.radio->rx_tone_test(&tone)) {
+		tone_scan_end(sm, RADIO_TSCAN_NONE);
+		return;
+	}
+	sm->tone_matches = 0;
+	sm->tone_trial_ms = now_ms;
+	if (sm->view.tone_scan_phase != RADIO_TSCAN_CHECK) {
+		sm->view.tone_scan_phase = RADIO_TSCAN_CHECK;
+		changed(sm);
+	}
+}
+
+static void tone_scan_poll(radio_sm_t *sm, const radio_status_t *st, uint32_t now_ms)
+{
+	if (now_ms - sm->tone_scan_ms >= TONE_SCAN_LIMIT_MS) {
+		tone_scan_end(sm, RADIO_TSCAN_NONE);
+		return;
+	}
+	if (!carrier_heard(sm, st->noise)) {
+		if (sm->view.tone_scan_phase != RADIO_TSCAN_WAIT) {
+			sm->view.tone_scan_phase = RADIO_TSCAN_WAIT;
+			changed(sm);
+		}
+		return;
+	}
+	if (sm->view.tone_scan_phase == RADIO_TSCAN_WAIT) {
+		tone_scan_trial(sm, now_ms);
+		return;
+	}
+	uint32_t age = now_ms - sm->tone_trial_ms;
+	uint32_t settle_ms = sm->tone_scan_dcs ? 250u : 150u;
+	if (age >= settle_ms) {
+		sm->tone_matches = st->tone_ok ? (uint8_t)(sm->tone_matches + 1u) : 0;
+		if (sm->tone_matches == 3) {
+			sm->view.tone_scan_tone = tones_picker(sm->tone_trial);
+			tone_scan_end(sm, RADIO_TSCAN_FOUND);
+			return;
+		}
+	}
+	if (age >= (sm->tone_scan_dcs ? TONE_SCAN_DCS_MS : TONE_SCAN_CTCSS_MS)) {
+		uint16_t end = sm->tone_scan_dcs ? TONES_PICKER_COUNT : 1u + TONES_CTCSS_COUNT;
+		if (++sm->tone_trial == end) {
+			tone_scan_end(sm, RADIO_TSCAN_NONE);
+		} else {
+			tone_scan_trial(sm, now_ms);
+		}
+	}
+}
+#endif
