+#if CONFIG_TONE_SCAN
+static bool tone_scan_active(const radio_sm_t *sm)
+{
+	return sm->view.tone_scan_phase == RADIO_TSCAN_WAIT || sm->view.tone_scan_phase == RADIO_TSCAN_CHECK;
