+
+static void tone_scan_end(radio_sm_t *sm, uint8_t phase)
+{
+	if (tone_scan_active(sm)) {
+		board.radio->rx_tone_test(&sm->view.ch.rx_tone);
+		reset_tone(sm);
+	}
+	if (sm->view.tone_scan_phase != phase) {
+		sm->view.tone_scan_phase = phase;
+		if (phase != RADIO_TSCAN_FOUND)
+			sm->view.tone_scan_tone = (subtone_t){ TONE_NONE, 0 };
+		changed(sm);
+	}
+}
+#endif
