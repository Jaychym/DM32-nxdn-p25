diff --git a/tests/host/nxdnTrunkTest.c b/tests/host/nxdnTrunkTest.c
new file mode 100644
index 0000000..125f75e
--- /dev/null
+++ b/tests/host/nxdnTrunkTest.c
@@ -0,0 +1,301 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// NXDN Type-C trunking follower (core/nxdn/nxdn_trunk.c): SITE_INFO's direct frequency assignment, the linear plan,
+// which assignments are followed, the return to the control channel and the rejoin guard.
+#include <stdio.h>
+#include <string.h>
+
+#include "../../core/nxdn/nxdn.h"
+#include "../../core/nxdn/nxdn_trunk.h"
+
+static int failures, checks;
+#define CHECK(c, ...) do { checks++; if (!(c)) { failures++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static uint32_t tuned[16];
+static unsigned ntuned;
+static void tune(uint32_t hz, void *ctx) { (void)ctx; if (ntuned < 16) tuned[ntuned] = hz; ntuned++; }
+
+// VCALL_ASSGN: call type, source, destination; chan10 or (DFA) the 16-bit outbound frequency number
+static void assgn(uint8_t *m, uint8_t type, uint8_t call_type, uint16_t src, uint16_t dst, uint16_t chan, bool dfa)
+{
+	memset(m, 0, NXDN_CAC_MSG_BYTES);
+	m[0] = type;
+	m[2] = (uint8_t)(call_type << 5);
+	m[3] = (uint8_t)(src >> 8); m[4] = (uint8_t)src;
+	m[5] = (uint8_t)(dst >> 8); m[6] = (uint8_t)dst;
+	if (dfa) {
+		m[7] = 0x01;	// call timer bits, bandwidth 01
+		m[8] = (uint8_t)(chan >> 8); m[9] = (uint8_t)chan;
+	} else {
+		m[7] = (uint8_t)(0x14 | ((chan >> 8) & 3));	// call timer bits around the channel's top two
+		m[8] = (uint8_t)chan;
+	}
+}
+
+static void site_info(uint8_t *m, bool dfa, uint8_t step, uint8_t base)
+{
+	memset(m, 0, NXDN_CAC_MSG_BYTES);
+	m[0] = NXDN_MSG_SITE_INFO;
+	m[11] = (uint8_t)((dfa ? 0x80 : 0) | (step & 3) << 5 | (base & 7) << 2);
+}
+
+// ── The transmit side ──
+static uint8_t sent_msg[8][NXDN_LCAC_MSG_BYTES];
+static uint32_t sent_hz[8];
+static unsigned nsent;
+static bool send_ok = true;
+static bool sendf(uint32_t hz, const uint8_t *msg, void *ctx)
+{
+	(void)ctx;
+	if (!send_ok)
+		return false;
+	if (nsent < 8) {
+		memcpy(sent_msg[nsent], msg, NXDN_LCAC_MSG_BYTES);
+		sent_hz[nsent] = hz;
+	}
+	nsent++;
+	return true;
+}
+
+static void reg_resp(uint8_t *m, uint16_t unit, uint8_t cause)
+{
+	memset(m, 0, NXDN_CAC_MSG_BYTES);
+	m[0] = NXDN_MSG_REG;
+	m[4] = (uint8_t)(unit >> 8); m[5] = (uint8_t)unit;
+	m[8] = cause;
+}
+
+static void vcall_resp(uint8_t *m, uint16_t src, uint16_t dst, uint8_t cause)
+{
+	memset(m, 0, NXDN_CAC_MSG_BYTES);
+	m[0] = NXDN_MSG_VCALL_REQ;
+	m[2] = (uint8_t)(NXDN_CALL_GROUP << 5);
+	m[3] = (uint8_t)(src >> 8); m[4] = (uint8_t)src;
+	m[5] = (uint8_t)(dst >> 8); m[6] = (uint8_t)dst;
+	m[7] = cause;
+}
+
+static void testTx(void)
+{
+	nxdn_trunk_t t;
+	uint8_t m[NXDN_CAC_MSG_BYTES];
+	nxdn_trunk_cfg_t cfg = { .cc_hz = 451000000u, .cc_tx_hz = 456000000u, .base_hz = 450000000u, .spacing_hz = 6250,
+				 .group = 100, .unit_id = 321, .tx = true, .talk_dst = 100, .rate9600 = false };
+	uint32_t now = 1000;
+
+	ntuned = 0;
+	nxdn_trunk_begin(&t, &cfg, tune, sendf, NULL, now);
+	CHECK(t.reg == NXDN_REG_IDLE && nxdn_trunk_can_talk(&t) == NXDN_TALK_NOT_REG, "tx: registration first");
+	// SITE_INFO: registration goes out on the inbound frequency, with the location and our unit and group
+	site_info(m, false, 0, 0);
+	m[1] = 0x12; m[2] = 0x34; m[3] = 0x56;
+	nxdn_trunk_msg(&t, m, now);
+	nxdn_trunk_tick(&t, false, now);
+	CHECK(nsent == 1 && sent_hz[0] == 456000000u && sent_msg[0][0] == NXDN_MSG_REG && t.reg == NXDN_REG_WAIT,
+	      "REG_REQ sent: %u", nsent);
+	CHECK(sent_msg[0][4] == 0x01 && sent_msg[0][5] == 0x41 && sent_msg[0][6] == 0 && sent_msg[0][7] == 100 &&
+	      ((uint32_t)(sent_msg[0][1] & 7) << 16 | sent_msg[0][2] << 8 | sent_msg[0][3]) == (0x123456u >> 5), "REG_REQ fields");
+	// No answer: sent again after the answer time, three tries in all, then a later round
+	now += NXDN_TRUNK_ANSWER_MS;
+	nxdn_trunk_tick(&t, false, now);
+	now += NXDN_TRUNK_ANSWER_MS;
+	nxdn_trunk_tick(&t, false, now);
+	CHECK(nsent == 3, "REG_REQ tries: %u", nsent);
+	now += NXDN_TRUNK_ANSWER_MS;
+	nxdn_trunk_tick(&t, false, now);
+	CHECK(t.reg == NXDN_REG_RETRY && nsent == 3, "no answer: retry later");
+	now += NXDN_TRUNK_RETRY_MS;
+	nxdn_trunk_tick(&t, false, now);
+	CHECK(t.reg == NXDN_REG_WAIT && nsent == 4, "next round");
+	// Another unit's answer is not ours; ours registers
+	reg_resp(m, 322, 0x01);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(t.reg == NXDN_REG_WAIT, "someone else's REG_RESP");
+	reg_resp(m, 321, 0x01);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(t.reg == NXDN_REG_READY && nxdn_trunk_can_talk(&t) == NXDN_TALK_OK, "registered");
+
+	// PTT: VCALL_REQ for group 100, 4800 EHR
+	nsent = 0;
+	nxdn_trunk_ptt(&t, true, now);
+	CHECK(nsent == 1 && sent_msg[0][0] == NXDN_MSG_VCALL_REQ && sent_msg[0][2] == (NXDN_CALL_GROUP << 5) &&
+	      sent_msg[0][3] == 0x01 && sent_msg[0][4] == 0x41 && sent_msg[0][6] == 100 && t.req == NXDN_REQ_WAIT, "VCALL_REQ");
+	// Accepted, then queued, then the assignment to us: on the voice channel, transmit at its plan + duplex offset
+	vcall_resp(m, 321, 100, NXDN_CAUSE_VD_ACCEPTED);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(t.req == NXDN_REQ_WAIT, "accepted: wait for the assignment");
+	vcall_resp(m, 321, 100, 0x3F);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(t.req == NXDN_REQ_QUEUED, "queued");
+	now += 3000;
+	nxdn_trunk_tick(&t, false, now);
+	CHECK(t.req == NXDN_REQ_QUEUED && nsent == 1, "queued: nothing sent again");
+	unsigned before = ntuned;
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_GROUP, 321, 100, 40, false);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(t.req == NXDN_REQ_TALK && t.state == NXDN_TRUNK_VOICE && ntuned == before + 1 && tuned[before] == 450250000u &&
+	      t.talk_hz == 455250000u, "assigned: rx %u tx %u", (unsigned)tuned[before], (unsigned)t.talk_hz);
+	// No voice heard while we talk does not take us back
+	now += 5000;
+	nxdn_trunk_tick(&t, false, now);
+	CHECK(t.state == NXDN_TRUNK_VOICE, "talking holds the channel");
+	nxdn_trunk_ptt(&t, false, now);
+	nxdn_trunk_talk_end(&t, now);
+	CHECK(t.state == NXDN_TRUNK_CONTROL && t.req == NXDN_REQ_IDLE && tuned[ntuned - 1] == cfg.cc_hz, "talk end");
+
+	// Refused
+	nxdn_trunk_ptt(&t, true, now);
+	vcall_resp(m, 321, 100, 0x22);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(t.req == NXDN_REQ_DENIED && t.cause == 0x22, "denied");
+	nxdn_trunk_ptt(&t, false, now);
+	CHECK(t.req == NXDN_REQ_IDLE, "release clears");
+	// No answer at all: three tries then timeout
+	nsent = 0;
+	nxdn_trunk_ptt(&t, true, now);
+	for (unsigned i = 0; i < 3; i++) {
+		now += NXDN_TRUNK_ANSWER_MS;
+		nxdn_trunk_tick(&t, false, now);
+	}
+	CHECK(t.req == NXDN_REQ_TIMEOUT && nsent == 3, "timeout after %u", nsent);
+	nxdn_trunk_ptt(&t, false, now);
+	// Released before the assignment: the assignment then is not ours to take
+	nxdn_trunk_ptt(&t, true, now);
+	nxdn_trunk_ptt(&t, false, now);
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_GROUP, 321, 100, 40, false);
+	before = ntuned;
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(t.req == NXDN_REQ_IDLE && t.state == NXDN_TRUNK_VOICE && t.follows > 0, "released: followed as a listener");
+	now += NXDN_TRUNK_VOICE_LOST_MS;
+	nxdn_trunk_tick(&t, false, now);
+
+	// DFA: the inbound frequency number is where we transmit
+	site_info(m, true, 2, 3);
+	nxdn_trunk_msg(&t, m, now);
+	nxdn_trunk_ptt(&t, true, now);
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_GROUP, 321, 100, 40000, true);
+	m[10] = (uint8_t)(44000 >> 8); m[11] = (uint8_t)44000;
+	nxdn_trunk_msg(&t, m, now + 2000);
+	CHECK(t.req == NXDN_REQ_TALK && t.voice_hz == 450000000u && t.talk_hz == 455000000u, "DFA talk %u / %u",
+	      (unsigned)t.voice_hz, (unsigned)t.talk_hz);
+	nxdn_trunk_talk_end(&t, now + 3000);
+	nxdn_trunk_ptt(&t, false, now + 3000);
+
+	// Listen only: no registration, PTT refused
+	cfg.tx = false;
+	nsent = 0;
+	nxdn_trunk_begin(&t, &cfg, tune, sendf, NULL, now);
+	nxdn_trunk_tick(&t, false, now + 5000);
+	CHECK(nsent == 0 && nxdn_trunk_can_talk(&t) == NXDN_TALK_OFF, "listen only");
+}
+
+int main(void)
+{
+	nxdn_trunk_t t;
+	uint8_t m[NXDN_CAC_MSG_BYTES];
+	nxdn_trunk_cfg_t cfg = { .cc_hz = 451000000u, .base_hz = 450000000u, .spacing_hz = 6250, .group = 100,
+				 .unit_id = 321, .all_groups = false };
+	uint32_t now = 1000;
+
+	// Begin: on the control channel
+	nxdn_trunk_begin(&t, &cfg, tune, NULL, NULL, now);
+	CHECK(ntuned == 1 && tuned[0] == cfg.cc_hz && t.state == NXDN_TRUNK_CONTROL, "begin tunes the control channel");
+
+	// Another group: not followed; our group by plan: channel 523 = 450 MHz + 523 x 6.25 kHz
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_GROUP, 5, 200, 10, false);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(ntuned == 1 && t.state == NXDN_TRUNK_CONTROL, "another group stays");
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_GROUP, 5, 100, 523, false);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(ntuned == 2 && tuned[1] == 450000000u + 523u * 6250u && t.state == NXDN_TRUNK_VOICE && t.src == 5,
+	      "our group by plan: %u", (unsigned)tuned[1]);
+
+	// Voice keeps it there; silence for the lost time brings it back
+	for (unsigned i = 0; i < 30; i++) {
+		now += 100;
+		nxdn_trunk_tick(&t, true, now);
+	}
+	CHECK(t.state == NXDN_TRUNK_VOICE, "voice holds the channel");
+	now += NXDN_TRUNK_VOICE_LOST_MS - 100;
+	nxdn_trunk_tick(&t, false, now);
+	CHECK(t.state == NXDN_TRUNK_VOICE, "not lost yet");
+	now += 100;
+	nxdn_trunk_tick(&t, false, now);
+	CHECK(t.state == NXDN_TRUNK_CONTROL && ntuned == 3 && tuned[2] == cfg.cc_hz && t.voice_lost == 1, "back on silence");
+
+	// The same assignment repeated right after: not rejoined; after the guard it is
+	assgn(m, NXDN_MSG_VCALL_ASSGN_DUP, NXDN_CALL_GROUP, 5, 100, 523, false);
+	nxdn_trunk_msg(&t, m, now + 100);
+	CHECK(ntuned == 3 && t.refused == NXDN_TRUNK_REFUSE_REJOIN, "rejoin guard");
+	now += NXDN_TRUNK_REJOIN_MS;
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(ntuned == 4 && t.state == NXDN_TRUNK_VOICE, "followed again after the guard");
+	// A voice channel that never carries voice: back after the grace
+	now += NXDN_TRUNK_VOICE_LOST_MS;
+	nxdn_trunk_tick(&t, false, now);
+	CHECK(t.state == NXDN_TRUNK_CONTROL && ntuned == 5, "no voice at all: back");
+	// A CAC message while on a voice channel (still in the pipe) is ignored
+	t.state = NXDN_TRUNK_VOICE;
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_GROUP, 6, 100, 7, false);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(ntuned == 5, "no assignment taken on a voice channel");
+	t.state = NXDN_TRUNK_CONTROL;
+
+	// All call and an individual call to us are followed; one to another unit isn't
+	now += 5000;
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_INDIVIDUAL, 9, 322, 1, false);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(ntuned == 5, "a unit call to someone else");
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_INDIVIDUAL, 9, 321, 1, false);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(ntuned == 6 && t.unit_call && tuned[5] == 450006250u, "a unit call to us");
+	now += NXDN_TRUNK_VOICE_LOST_MS;
+	nxdn_trunk_tick(&t, false, now);
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_GROUP, 9, NXDN_ID_ALL, 2, false);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(ntuned == 8 && t.state == NXDN_TRUNK_VOICE, "all call");
+	now += NXDN_TRUNK_VOICE_LOST_MS;
+	nxdn_trunk_tick(&t, false, now);
+
+	// DFA: SITE_INFO says step 1.25 kHz, base 400 MHz; the 16-bit number is the frequency, the plan is not used
+	site_info(m, true, 2, 3);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(t.site_known && t.dfa && t.step == 2 && t.base == 3, "site info");
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_GROUP, 5, 100, 40000, true);
+	CHECK(nxdn_trunk_chan_hz(&t, m) == 400000000u + 40000u * 1250u, "DFA frequency %u", (unsigned)nxdn_trunk_chan_hz(&t, m));
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(ntuned == 10 && tuned[9] == 450000000u, "DFA followed: %u", (unsigned)tuned[9]);
+	now += NXDN_TRUNK_VOICE_LOST_MS;
+	nxdn_trunk_tick(&t, false, now);
+	// A site whose base is system specific (0): refused, not tuned to nonsense
+	site_info(m, true, 3, 0);
+	nxdn_trunk_msg(&t, m, now);
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_GROUP, 5, 100, 12, true);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(ntuned == 11 && t.refused == NXDN_TRUNK_REFUSE_NO_PLAN && t.state == NXDN_TRUNK_CONTROL, "unknown base refused");
+
+	// Without a plan, channel numbers can't be followed; with every group, any group is
+	cfg.base_hz = 0;
+	cfg.all_groups = true;
+	nxdn_trunk_begin(&t, &cfg, tune, NULL, NULL, now);
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_GROUP, 5, 777, 12, false);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(t.state == NXDN_TRUNK_CONTROL && t.refused == NXDN_TRUNK_REFUSE_NO_PLAN && t.refusals == 1, "no plan");
+	site_info(m, false, 0, 0);
+	nxdn_trunk_msg(&t, m, now);
+	cfg.base_hz = 440000000u;
+	t.cfg = cfg;
+	assgn(m, NXDN_MSG_VCALL_ASSGN, NXDN_CALL_GROUP, 5, 777, 12, false);
+	nxdn_trunk_msg(&t, m, now);
+	CHECK(t.state == NXDN_TRUNK_VOICE && t.voice_hz == 440075000u, "every group, plan after RCN 0: %u", (unsigned)t.voice_hz);
+	// The longest call: back even with voice
+	for (uint32_t i = 0; i <= NXDN_TRUNK_CALL_MAX_MS / 100; i++) {
+		now += 100;
+		nxdn_trunk_tick(&t, true, now);
+	}
+	CHECK(t.state == NXDN_TRUNK_CONTROL && t.call_max == 1, "call max");
+
+	testTx();
+	printf("nxdnTrunkTest: %d checks, %d failed\n", checks, failures);
+	return failures ? 1 : 0;
+}
