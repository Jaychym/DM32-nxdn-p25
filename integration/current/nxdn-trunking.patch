diff --git a/core/nxdn/nxdn_trunk.c b/core/nxdn/nxdn_trunk.c
new file mode 100644
index 0000000..9f1ed51
--- /dev/null
+++ b/core/nxdn/nxdn_trunk.c
@@ -0,0 +1,391 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// NXDN Type-C trunking (nxdn_trunk.h)
+#include "nxdn_trunk.h"
+
+#include <string.h>
+
+#include "nxdn.h"
+
+// SITE_INFO's channel access information: RCN 1 = direct frequency assignment, then a step and a base. Base 4 is
+// 750 MHz as DSD-FME reads it (SDRTrunk reads 450 MHz): to confirm on air (nxdn-trunking.md 2)
+static const uint32_t dfa_base_hz[8] = { 0, 100000000u, 330000000u, 400000000u, 750000000u, 0, 0, 0 };
+static const uint16_t dfa_step_hz[4] = { 0, 0, 1250, 3125 };
+
+static uint16_t u16(const uint8_t *m, uint8_t at) { return (uint16_t)(m[at] << 8 | m[at + 1]); }
+static void put16(uint8_t *m, uint8_t at, uint16_t v) { m[at] = (uint8_t)(v >> 8); m[at + 1] = (uint8_t)v; }
+
+// VCALL_ASSGN: type, CC option, call type (3) and voice option (5), source, destination, call timer (6), then the
+// channel: 10 bits, or with DFA 2 bits of bandwidth, the outbound frequency number OFN and the inbound one IFN
+static uint32_t dfa_hz(const nxdn_trunk_t *t, uint16_t fn)
+{
+	uint32_t base = dfa_base_hz[t->base & 7], step = dfa_step_hz[t->step & 3];
+
+	return base != 0 && step != 0 ? base + (uint32_t)fn * step : 0;
+}
+
+static bool dfa_on(const nxdn_trunk_t *t)
+{
+	return t->site_known && t->dfa;
+}
+
+uint32_t nxdn_trunk_chan_hz(const nxdn_trunk_t *t, const uint8_t *msg)
+{
+	if (dfa_on(t))
+		return dfa_hz(t, u16(msg, 8));
+	uint16_t ch = (uint16_t)((msg[7] & 3) << 8 | msg[8]);
+	return t->cfg.base_hz != 0 ? t->cfg.base_hz + (uint32_t)ch * t->cfg.spacing_hz : 0;
+}
+
+// Where we transmit on an assigned channel: DFA's inbound number, else the control channel's duplex offset
+static uint32_t talk_hz(const nxdn_trunk_t *t, const uint8_t *msg, uint32_t rx_hz)
+{
+	if (dfa_on(t))
+		return dfa_hz(t, u16(msg, 10));
+	uint32_t cc_tx = t->cfg.cc_tx_hz ? t->cfg.cc_tx_hz : t->cfg.cc_hz;
+	return rx_hz + (cc_tx - t->cfg.cc_hz);
+}
+
+static void enter(nxdn_trunk_t *t, uint8_t state, uint32_t hz, uint32_t now)
+{
+	t->state = state;
+	t->t_state = now;
+	t->t_heard = now;	// the voice channel's grace for its first frame
+	if (state == NXDN_TRUNK_CONTROL)
+		t->t_cc = now;
+	if (t->tune)
+		t->tune(hz, t->ctx);
+}
+
+void nxdn_trunk_begin(nxdn_trunk_t *t, const nxdn_trunk_cfg_t *cfg, void (*tune)(uint32_t hz, void *ctx),
+		      bool (*send)(uint32_t hz, const uint8_t *msg, void *ctx), void *ctx, uint32_t now)
+{
+	memset(t, 0, sizeof *t);
+	t->cfg = *cfg;
+	t->tune = tune;
+	t->send = send;
+	t->ctx = ctx;
+	t->reg = cfg->tx && cfg->unit_id != 0 ? NXDN_REG_IDLE : NXDN_REG_OFF;
+	t->backoff = NXDN_TRUNK_RETRY_MS;
+	enter(t, NXDN_TRUNK_CONTROL, cfg->cc_hz, now);
+}
+
+void nxdn_trunk_end(nxdn_trunk_t *t)
+{
+	t->state = NXDN_TRUNK_OFF;
+}
+
+static bool wanted(const nxdn_trunk_t *t, uint8_t call_type, uint16_t dst)
+{
+	if (call_type == NXDN_CALL_INDIVIDUAL)
+		return t->cfg.unit_id != 0 && dst == t->cfg.unit_id;
+	return t->cfg.all_groups || dst == NXDN_ID_ALL || (t->cfg.group != 0 && dst == t->cfg.group);
+}
+
+// ── Inbound messages (long CAC, 16 octets) ──
+// REG_REQ: registration option (5 bits) and the location ID's first 19 bits, our unit, the group, subscriber type,
+// version
+static void build_reg(const nxdn_trunk_t *t, uint8_t *m)
+{
+	uint32_t loc = t->location >> 5;	// 19 bits
+
+	memset(m, 0, NXDN_LCAC_MSG_BYTES);
+	m[0] = NXDN_MSG_REG;
+	m[1] = (uint8_t)((loc >> 16) & 7);
+	m[2] = (uint8_t)(loc >> 8);
+	m[3] = (uint8_t)loc;
+	put16(m, 4, t->cfg.unit_id);
+	put16(m, 6, t->cfg.talk_unit ? t->cfg.group : t->cfg.talk_dst);
+}
+
+// VCALL_REQ: CC option, call type and voice option, source, destination
+static void build_vcall_req(const nxdn_trunk_t *t, uint8_t *m)
+{
+	memset(m, 0, NXDN_LCAC_MSG_BYTES);
+	m[0] = NXDN_MSG_VCALL_REQ;
+	m[2] = (uint8_t)((t->cfg.talk_unit ? NXDN_CALL_INDIVIDUAL : NXDN_CALL_GROUP) << 5 |
+			 (t->cfg.rate9600 ? NXDN_VOICE_9600_EHR : NXDN_VOICE_4800_EHR));
+	put16(m, 3, t->cfg.unit_id);
+	put16(m, 5, t->cfg.talk_dst);
+}
+
+// The pending request (registration, or a voice request while PTT asks) goes out once more
+static void send_pending(nxdn_trunk_t *t, uint32_t now)
+{
+	uint8_t m[NXDN_LCAC_MSG_BYTES];
+	uint32_t hz = t->cfg.cc_tx_hz ? t->cfg.cc_tx_hz : t->cfg.cc_hz;
+
+	if (t->req == NXDN_REQ_WAIT) {
+		build_vcall_req(t, m);
+	} else {
+		build_reg(t, m);
+	}
+	t->t_sent = now;
+	if (!t->send || !t->send(hz, m, t->ctx)) {
+		t->send_fail++;
+		return;		// (tried again at the next answer timeout, the try not counted)
+	}
+	t->tries++;
+	t->sent = true;
+	if (t->req == NXDN_REQ_WAIT)
+		t->req_tx++;
+	else
+		t->reg_tx++;
+}
+
+static void start_request(nxdn_trunk_t *t, uint32_t now)
+{
+	t->tries = 0;
+	t->sent = false;
+	send_pending(t, now);
+}
+
+static bool registered(uint8_t cause)
+{
+	// Accepted, or the location accepted with the group failed or refused (with or without a valid ESN)
+	switch (cause) {
+	case 0x01: case 0x04: case 0x05: case 0x21: case 0x24: case 0x25:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static void reg_resp(nxdn_trunk_t *t, const uint8_t *msg, uint32_t now)
+{
+	if (t->reg != NXDN_REG_WAIT || u16(msg, 4) != t->cfg.unit_id)
+		return;
+	t->sent = false;
+	t->cause = msg[8];
+	if (registered(msg[8])) {
+		t->reg = NXDN_REG_READY;
+		t->reg_ok++;
+		t->backoff = NXDN_TRUNK_RETRY_MS;
+	} else {
+		t->reg = NXDN_REG_DENIED;
+		t->denials++;
+		t->t_sent = now;
+	}
+}
+
+static void vcall_resp(nxdn_trunk_t *t, const uint8_t *msg, uint32_t now)
+{
+	uint8_t cause = msg[7];
+
+	if ((t->req != NXDN_REQ_WAIT && t->req != NXDN_REQ_QUEUED) || u16(msg, 3) != t->cfg.unit_id)
+		return;
+	t->sent = false;
+	if (cause == NXDN_CAUSE_VD_ACCEPTED)
+		return;			// the assignment follows
+	if (cause >= NXDN_CAUSE_VD_QUEUE_LO && cause <= NXDN_CAUSE_VD_QUEUE_HI) {
+		if (t->req != NXDN_REQ_QUEUED)
+			t->t_req = now;
+		t->req = NXDN_REQ_QUEUED;
+		return;
+	}
+	t->cause = cause;
+	t->req = NXDN_REQ_DENIED;
+	t->denials++;
+}
+
+static void assign(nxdn_trunk_t *t, const uint8_t *msg, uint32_t now)
+{
+	uint8_t call_type = msg[2] >> 5;
+	uint16_t src = u16(msg, 3), dst = u16(msg, 5);
+	uint16_t chan = dfa_on(t) ? u16(msg, 8) : (uint16_t)((msg[7] & 3) << 8 | msg[8]);
+	uint32_t hz = nxdn_trunk_chan_hz(t, msg);
+
+	t->assigns++;
+	// Ours: the voice request granted
+	if ((t->req == NXDN_REQ_WAIT || t->req == NXDN_REQ_QUEUED) && src == t->cfg.unit_id && dst == t->cfg.talk_dst) {
+		uint32_t thz = hz != 0 ? talk_hz(t, msg, hz) : 0;
+
+		t->sent = false;
+		if (hz == 0 || thz == 0) {
+			t->req = NXDN_REQ_NO_CHAN;
+			return;
+		}
+		t->req = NXDN_REQ_TALK;
+		t->req_ok++;
+		t->talk_hz = thz;
+		t->chan = chan;
+		t->dst = dst;
+		t->src = src;
+		t->unit_call = call_type == NXDN_CALL_INDIVIDUAL;
+		t->voice_hz = hz;
+		enter(t, NXDN_TRUNK_VOICE, hz, now);
+		return;
+	}
+	if (t->req != NXDN_REQ_IDLE || !wanted(t, call_type, dst))
+		return;		// (while asking, the control channel is not left for another call)
+	if (chan == t->left_chan && dst == t->left_dst && now - t->t_left < NXDN_TRUNK_REJOIN_MS) {
+		t->refused = NXDN_TRUNK_REFUSE_REJOIN;
+		return;
+	}
+	if (hz == 0) {
+		t->refused = NXDN_TRUNK_REFUSE_NO_PLAN;
+		t->refusals++;
+		return;
+	}
+	t->refused = NXDN_TRUNK_REFUSE_NONE;
+	t->chan = chan;
+	t->dst = dst;
+	t->src = src;
+	t->unit_call = call_type == NXDN_CALL_INDIVIDUAL;
+	t->voice_hz = hz;
+	t->follows++;
+	enter(t, NXDN_TRUNK_VOICE, hz, now);
+}
+
+void nxdn_trunk_msg(nxdn_trunk_t *t, const uint8_t *msg, uint32_t now)
+{
+	if (t->state != NXDN_TRUNK_CONTROL)
+		return;		// (a CAC that was in the pipe when we left)
+	t->msgs++;
+	switch (nxdn_msg_type(msg)) {
+	case NXDN_MSG_SITE_INFO:
+		// Location ID, bits 8-31; channel access information, bits 88-111: RCN, step (2), base (3)
+		t->site_known = true;
+		t->location = (uint32_t)msg[1] << 16 | (uint32_t)msg[2] << 8 | msg[3];
+		t->dfa = (msg[11] & 0x80) != 0;
+		t->step = (uint8_t)((msg[11] >> 5) & 3);
+		t->base = (uint8_t)((msg[11] >> 2) & 7);
+		break;
+	case NXDN_MSG_VCALL_ASSGN:
+	case NXDN_MSG_VCALL_ASSGN_DUP:
+		assign(t, msg, now);
+		break;
+	case NXDN_MSG_REG:
+		reg_resp(t, msg, now);
+		break;
+	case NXDN_MSG_VCALL_REQ:	// outbound: VCALL_RESP
+		vcall_resp(t, msg, now);
+		break;
+	default:
+		break;
+	}
+}
+
+static void back_to_control(nxdn_trunk_t *t, uint32_t now)
+{
+	t->left_chan = t->chan;
+	t->left_dst = t->dst;
+	t->t_left = now;
+	enter(t, NXDN_TRUNK_CONTROL, t->cfg.cc_hz, now);
+}
+
+// The transmit side's timers, on the control channel
+static void tx_tick(nxdn_trunk_t *t, uint32_t now)
+{
+	if (t->state != NXDN_TRUNK_CONTROL || t->reg == NXDN_REG_OFF)
+		return;
+	if (t->req == NXDN_REQ_WAIT) {
+		if (now - t->t_sent < NXDN_TRUNK_ANSWER_MS)
+			return;
+		if (t->tries >= NXDN_TRUNK_TRIES) {
+			t->req = NXDN_REQ_TIMEOUT;
+			t->timeouts++;
+			t->sent = false;
+		} else {
+			send_pending(t, now);
+		}
+		return;
+	}
+	if (t->req == NXDN_REQ_QUEUED) {
+		if (now - t->t_req >= NXDN_TRUNK_QUEUE_MS) {
+			t->req = NXDN_REQ_TIMEOUT;
+			t->timeouts++;
+		}
+		return;
+	}
+	switch (t->reg) {
+	case NXDN_REG_IDLE:
+		if (t->site_known || now - t->t_cc >= NXDN_TRUNK_SITE_MS) {
+			t->reg = NXDN_REG_WAIT;
+			start_request(t, now);
+		}
+		break;
+	case NXDN_REG_WAIT:
+		if (now - t->t_sent < NXDN_TRUNK_ANSWER_MS)
+			break;
+		if (t->tries < NXDN_TRUNK_TRIES) {
+			send_pending(t, now);
+			break;
+		}
+		t->reg = NXDN_REG_RETRY;
+		t->timeouts++;
+		t->sent = false;
+		break;
+	case NXDN_REG_RETRY:
+	case NXDN_REG_DENIED:
+		if (now - t->t_sent >= t->backoff) {
+			t->backoff = t->backoff * 2 > NXDN_TRUNK_RETRY_MAX ? NXDN_TRUNK_RETRY_MAX : t->backoff * 2;
+			t->reg = NXDN_REG_WAIT;
+			start_request(t, now);
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+void nxdn_trunk_tick(nxdn_trunk_t *t, bool rx_active, uint32_t now)
+{
+	if (t->state == NXDN_TRUNK_VOICE) {
+		if (t->req == NXDN_REQ_TALK) {
+			// Our own channel: the caller transmits and says when it is over; a guard if it never does
+			if (now - t->t_state >= NXDN_TRUNK_TALK_MAX_MS)
+				nxdn_trunk_talk_end(t, now);
+			return;
+		}
+		if (rx_active)
+			t->t_heard = now;
+		if (now - t->t_heard >= NXDN_TRUNK_VOICE_LOST_MS)
+			t->voice_lost++;
+		else if (now - t->t_state >= NXDN_TRUNK_CALL_MAX_MS)
+			t->call_max++;
+		else
+			return;
+		back_to_control(t, now);
+		return;
+	}
+	tx_tick(t, now);
+}
+
+uint8_t nxdn_trunk_can_talk(const nxdn_trunk_t *t)
+{
+	if (t->reg == NXDN_REG_OFF)
+		return NXDN_TALK_OFF;
+	if (t->state == NXDN_TRUNK_OFF)
+		return NXDN_TALK_NO_CC;
+	if (t->reg != NXDN_REG_READY)
+		return NXDN_TALK_NOT_REG;
+	return NXDN_TALK_OK;
+}
+
+void nxdn_trunk_ptt(nxdn_trunk_t *t, bool down, uint32_t now)
+{
+	if (!down) {
+		if (t->req == NXDN_REQ_WAIT || t->req == NXDN_REQ_QUEUED)
+			t->sent = false;
+		if (t->req != NXDN_REQ_TALK)
+			t->req = NXDN_REQ_IDLE;	// a request not granted yet is dropped; a finished one forgotten
+		t->ptt = false;
+		return;
+	}
+	t->ptt = true;
+	if (nxdn_trunk_can_talk(t) != NXDN_TALK_OK || t->req == NXDN_REQ_TALK)
+		return;
+	if (t->state == NXDN_TRUNK_VOICE)
+		back_to_control(t, now);	// listening to a call: ask from the control channel
+	t->req = NXDN_REQ_WAIT;
+	start_request(t, now);
+}
+
+void nxdn_trunk_talk_end(nxdn_trunk_t *t, uint32_t now)
+{
+	if (t->req != NXDN_REQ_TALK)
+		return;
+	t->req = NXDN_REQ_IDLE;
+	back_to_control(t, now);
+}
diff --git a/core/nxdn/nxdn_trunk.h b/core/nxdn/nxdn_trunk.h
new file mode 100644
index 0000000..7e094e5
--- /dev/null
+++ b/core/nxdn/nxdn_trunk.h
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// NXDN Type-C trunking (docs/spec/nxdn-trunking.md): camp on a site's control channel, read its CAC, follow voice
+// channel assignments (VCALL_ASSGN) for our group, every group, or calls to our unit, and come back when the call's
+// voice stops. Channel numbers become frequencies through the site's direct frequency assignment (SITE_INFO) or,
+// without it, the channel's linear plan. With the transmit side on it also registers (REG_REQ) and, on PTT, asks
+// for a voice channel (VCALL_REQ); the assignment to us puts the caller on the voice channel to transmit. Section
+// numbers are NXDN TS 1-A's; field positions as the open decoders read them (nxdn-trunking.md 2).
+//
+// Pure: no RTOS call, no board call. Time comes in as a millisecond tick; tuning and inbound bursts go out through
+// the caller's hooks. One task calls everything (the radio task: CAC messages reach it through the caller's queue).
+#ifndef RFOUNDRY_NXDN_TRUNK_H
+#define RFOUNDRY_NXDN_TRUNK_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define NXDN_TRUNK_VOICE_LOST_MS	1000	// no voice frame on the voice channel for this long: back to control
+#define NXDN_TRUNK_CALL_MAX_MS		120000	// on a voice channel at most (listening)
+#define NXDN_TRUNK_REJOIN_MS		1500	// the call just left: its repeated assignments are not followed again
+// The transmit side
+#define NXDN_TRUNK_SITE_MS		2000	// on the control channel without SITE_INFO yet: register anyway
+#define NXDN_TRUNK_ANSWER_MS		1000	// a request without an answer: sent again
+#define NXDN_TRUNK_TRIES		3	// sends of one request
+#define NXDN_TRUNK_RETRY_MS		10000	// registration unanswered or refused: the wait before the next round, doubled
+#define NXDN_TRUNK_RETRY_MAX		60000
+#define NXDN_TRUNK_QUEUE_MS		10000	// a queued voice request: the longest wait for its assignment
+#define NXDN_TRUNK_TALK_MAX_MS		(NXDN_TRUNK_CALL_MAX_MS + 10000)	// on our voice channel at most
+
+// Layer 3 (6.4) as the control channel carries them
+#define NXDN_MSG_VCALL_REQ	0x01	// inbound; outbound the same type is VCALL_RESP
+#define NXDN_MSG_REG		0x20	// REG_REQ inbound, REG_RESP outbound
+#define NXDN_CAUSE_VD_ACCEPTED	0x10
+#define NXDN_CAUSE_VD_QUEUE_LO	0x30	// 0x30-0x3F: queued
+#define NXDN_CAUSE_VD_QUEUE_HI	0x3F
+
+enum { NXDN_TRUNK_OFF, NXDN_TRUNK_CONTROL, NXDN_TRUNK_VOICE };
+// Why the last wanted assignment was not followed
+enum { NXDN_TRUNK_REFUSE_NONE, NXDN_TRUNK_REFUSE_NO_PLAN, NXDN_TRUNK_REFUSE_REJOIN };
+// Registration (reg)
+enum {
+	NXDN_REG_OFF,		// the transmit side is off
+	NXDN_REG_IDLE,		// to register once the control channel is heard
+	NXDN_REG_WAIT,		// REG_REQ sent, waiting for REG_RESP
+	NXDN_REG_READY,		// registered
+	NXDN_REG_DENIED,	// refused (cause): tried again later
+	NXDN_REG_RETRY,		// no answer: tried again later
+};
+// A voice request (req)
+enum {
+	NXDN_REQ_IDLE,
+	NXDN_REQ_WAIT,		// VCALL_REQ sent (or to be sent), waiting for the assignment
+	NXDN_REQ_QUEUED,	// the site queued it
+	NXDN_REQ_TALK,		// assigned: on our voice channel, talk_hz is where to transmit
+	NXDN_REQ_DENIED,	// refused (cause)
+	NXDN_REQ_TIMEOUT,	// no answer, or queued too long
+	NXDN_REQ_NO_CHAN,	// assigned a channel whose frequencies can't be known
+};
+// nxdn_trunk_can_talk
+enum { NXDN_TALK_OK, NXDN_TALK_OFF, NXDN_TALK_NO_CC, NXDN_TALK_NOT_REG };
+
+typedef struct {
+	uint32_t cc_hz;		// the control channel
+	uint32_t cc_tx_hz;	// its inbound frequency (where bursts go); 0 = cc_hz
+	uint32_t base_hz;	// channel numbers without DFA: base_hz + number x spacing_hz; 0 none
+	uint32_t spacing_hz;
+	uint16_t group;		// the group followed, 0 none
+	uint16_t unit_id;	// ours: individual calls to it are followed; the source of what we send
+	bool all_groups;	// every group call of the site
+	// The transmit side
+	bool tx;		// register and ask for voice channels (unit_id set)
+	uint16_t talk_dst;	// what PTT calls: a group, or a unit with talk_unit
+	bool talk_unit;
+	bool rate9600;		// the voice option asked for
+} nxdn_trunk_cfg_t;
+
+typedef struct {
+	void (*tune)(uint32_t hz, void *ctx);
+	// One inbound burst on hz: msg is a long CAC message (NXDN_LCAC_MSG_BYTES). False: it can't go now (sent again
+	// at the next try)
+	bool (*send)(uint32_t hz, const uint8_t *msg, void *ctx);
+	void *ctx;
+	nxdn_trunk_cfg_t cfg;
+	uint8_t state;		// NXDN_TRUNK_*
+	uint8_t refused;	// NXDN_TRUNK_REFUSE_* of the last wanted assignment not followed
+	bool site_known;	// SITE_INFO heard: dfa, step and base below are the site's
+	bool dfa;
+	uint8_t step, base;
+	uint32_t location;	// the site's location ID (24 bits)
+	uint32_t t_state, t_heard, t_left, t_cc;
+	// The call followed (now, or last)
+	uint32_t voice_hz;
+	uint16_t chan, dst, src;
+	bool unit_call;
+	uint16_t left_chan, left_dst;
+	// The transmit side
+	uint8_t reg, req;	// NXDN_REG_*, NXDN_REQ_*
+	uint8_t cause;		// the last refusal's cause
+	uint8_t tries;
+	bool sent;		// the pending request went: waiting for its answer
+	bool ptt;
+	uint32_t t_sent, t_req, backoff;
+	uint32_t talk_hz;	// our voice channel's transmit frequency
+	uint32_t msgs, assigns, follows, refusals, voice_lost, call_max;
+	uint32_t reg_tx, reg_ok, req_tx, req_ok, denials, timeouts, send_fail;
+} nxdn_trunk_t;
+
+// Tune to the control channel and listen there
+void nxdn_trunk_begin(nxdn_trunk_t *t, const nxdn_trunk_cfg_t *cfg, void (*tune)(uint32_t hz, void *ctx),
+		      bool (*send)(uint32_t hz, const uint8_t *msg, void *ctx), void *ctx, uint32_t now);
+void nxdn_trunk_end(nxdn_trunk_t *t);
+// A CAC message (NXDN_CAC_MSG_BYTES) from the control channel
+void nxdn_trunk_msg(nxdn_trunk_t *t, const uint8_t *msg, uint32_t now);
+// At least every 100 ms. rx_active: the engine is receiving a call (voice is coming on the channel tuned)
+void nxdn_trunk_tick(nxdn_trunk_t *t, bool rx_active, uint32_t now);
+// The frequency of an assignment's channel field (its message), 0 when it can't be known (tests and the view)
+uint32_t nxdn_trunk_chan_hz(const nxdn_trunk_t *t, const uint8_t *msg);
+
+// ── The transmit side (cfg.tx) ──
+uint8_t nxdn_trunk_can_talk(const nxdn_trunk_t *t);	// NXDN_TALK_*
+// PTT pressed: a VCALL_REQ for cfg.talk_dst goes out (from a voice channel heard, back to control first); released
+// before the assignment: dropped
+void nxdn_trunk_ptt(nxdn_trunk_t *t, bool down, uint32_t now);
+// Our transmission on the assigned channel ended (or never started): back to the control channel
+void nxdn_trunk_talk_end(nxdn_trunk_t *t, uint32_t now);
+
+#endif
