+// ── CAC: the outbound control channel (Type-C trunking, docs/spec/nxdn-trunking.md 2) ──
+static uint8_t cac_got[8][NXDN_CAC_MSG_BYTES];
+static unsigned cac_n;
+static void on_cac(const uint8_t *msg, void *ctx)
+{
+	(void)ctx;
+	if (cac_n < 8)
+		memcpy(cac_got[cac_n], msg, NXDN_CAC_MSG_BYTES);
+	cac_n++;
+}
+
+static void cac_frame(uint8_t *frame, const uint8_t in[NXDN_CAC_BYTES])
+{
+	memset(frame, 0, NXDN_FRAME_BYTES);
+	nxdn_frame_begin(frame, NXDN_LICH(NXDN_RF_RCCH, NXDN_USC_CAC, 0, NXDN_DIR_OUTBOUND));
+	nxdn_cac_put(frame, in);
+}
+
+static void testCac(void)
+{
+	uint8_t frame[NXDN_FRAME_BYTES], in[NXDN_CAC_BYTES], out[NXDN_CAC_BYTES];
+	unsigned caught = 0;
+
+	for (unsigned run = 0; run < 200; run++) {
+		fill(in, sizeof in);
+		in[NXDN_CAC_BYTES - 1] &= 0xE0;		// 155 bits: the last octet's top three
+		cac_frame(frame, in);
+		CHECK(nxdn_lich_get(frame, NULL) == NXDN_LICH(NXDN_RF_RCCH, NXDN_USC_CAC, 0, NXDN_DIR_OUTBOUND), "CAC LICH kept");
+		CHECK(nxdn_cac_get(frame, NULL, &work, out) == 0 && !memcmp(out, in, sizeof in), "CAC clean");
+		// Bit errors at least 42 apart in the coded stream (the interleaver spreads a burst that far): corrected.
+		// Coded bit y is air bit (y % 12) x 25 + y / 12 of the CAC (25 x 12)
+		unsigned nerr = run % 7;
+		for (unsigned k = 0; k < nerr; k++) {
+			unsigned y = (k * 43 + run * 7) % 300, a = (y % 12) * 25 + y / 12;
+			uint16_t sym = (uint16_t)(NXDN_SACCH_SYM + a / 2);
+			air_sym_put(frame, sym, (uint8_t)(air_sym_get(frame, sym) ^ ((a & 1) ? 1 : 2)));
+		}
+		int e = nxdn_cac_get(frame, NULL, &work, out);
+		CHECK(e >= 0 && !memcmp(out, in, sizeof in), "CAC %u errors: %d", nerr, e);
+		// Garbage: the CRC-16 turns it away
+		cac_frame(frame, in);
+		for (unsigned k = 0; k < 60; k++)
+			flip_sign(frame, (uint16_t)(NXDN_SACCH_SYM + rng() % 150));
+		caught += nxdn_cac_get(frame, NULL, &work, out) < 0 || memcmp(out, in, sizeof in) == 0;
+	}
+	CHECK(caught > 195, "CRC-16 catches %u of 200", caught);
+
+	// Through the framer: a control channel's frames back to back. A conventional receiver drops them all; with the
+	// CAC hook each message comes out, and another RAN's are dropped
+	static uint8_t fbuf[NXDN_FRAME_BYTES];
+	static int8_t fsoft[NXDN_FRAME_SYMS];
+	static nxdn_call_rx_t c;
+	uint8_t msgs[6][NXDN_CAC_BYTES];
+
+	for (unsigned ran = 0; ran < 3; ran++) {
+		for (unsigned hook = 0; hook < 2; hook++) {
+			rng_state = 0xCAC0 + ran;
+			tx_n = 0;
+			noise_syms(100);
+			for (uint16_t i = 0; i < NXDN_PREAMBLE_SYMS; i++)
+				tx_air[tx_n++] = air_sym_get(nxdn_preamble, i);
+			for (unsigned f = 0; f < 6; f++) {
+				fill(msgs[f], NXDN_CAC_BYTES);
+				msgs[f][0] = NXDN_SR(3, 7);		// RAN 7
+				msgs[f][NXDN_CAC_BYTES - 1] &= 0xE0;
+				cac_frame(frame, msgs[f]);
+				for (uint16_t i = 0; i < NXDN_FRAME_SYMS; i++)
+					tx_air[tx_n++] = air_sym_get(frame, i);
+			}
+			noise_syms(400);
+			memset(&got, 0, sizeof got);
+			cac_n = 0;
+			nxdn_call_rx_init(&c, ran == 0 ? NXDN_RAN_ANY : ran == 1 ? 7 : 9, &sink, NULL);
+			if (hook)
+				c.rx.cac = on_cac;
+			air_framer_t fr;
+			air_framer_init(&fr, &nxdn_air_mode, &c.rx, fbuf, fsoft, NXDN_FRAME_SYMS);
+			for (uint32_t at = 0; at < tx_n; at += 48) {
+				uint8_t hard[12] = { 0 };
+				uint16_t n = (uint16_t)(tx_n - at < 48 ? tx_n - at : 48);
+				air_chunk_t ch = { .t_us = at * 417u, .nsyms = n, .sync_at = -1, .hard = hard, .soft = NULL };
+
+				for (uint16_t i = 0; i < n; i++)
+					air_sym_put(hard, i, tx_air[at + i]);
+				air_framer_rx(&fr, &ch);
+			}
+			CHECK(got.starts == 0, "CAC frames are no call (ran %u hook %u)", ran, hook);
+			if (!hook || ran == 2) {
+				CHECK(cac_n == 0, "no CAC handed on (ran %u hook %u): %u", ran, hook, cac_n);
+				continue;
+			}
+			CHECK(cac_n >= 5 && cac_n <= 6, "CAC messages %u of 6 (ran %u)", cac_n, ran);
+			unsigned skip = 6 - (cac_n < 6 ? cac_n : 6);
+			for (unsigned k = 0; k < cac_n && k < 6; k++)
+				CHECK(!memcmp(cac_got[k], &msgs[k + skip][1], NXDN_CAC_MSG_BYTES), "CAC message %u (ran %u)", k, ran);
+		}
+	}
+	CHECK(c.rx.ran_rejects >= 5, "another RAN's CAC dropped: %u", (unsigned)c.rx.ran_rejects);
+}
+
+// ── Long CAC: a subscriber's control channel burst (inbound RCCH) ──
+static void testLongCac(void)
+{
+	uint8_t frame[NXDN_FRAME_BYTES], in[NXDN_LCAC_BYTES], out[NXDN_LCAC_BYTES];
+
+	for (unsigned run = 0; run < 200; run++) {
+		fill(in, sizeof in);
+		memset(frame, 0, sizeof frame);
+		nxdn_frame_begin(frame, NXDN_LICH(NXDN_RF_RCCH, NXDN_USC_LCAC, 0, NXDN_DIR_INBOUND));
+		nxdn_lcac_put(frame, in);
+		CHECK(nxdn_lich_get(frame, NULL) == 0x08, "long CAC LICH 0x08");
+		CHECK(nxdn_lcac_get(frame, NULL, &work, out) == 0 && !memcmp(out, in, sizeof in), "long CAC clean");
+		// Nothing past the long CAC (symbol 144 on) is written
+		for (uint16_t s = NXDN_LCAC_SYMS; s < NXDN_FRAME_SYMS; s++)
+			CHECK(air_sym_get(frame, s) == 0, "long CAC stays in its 126 symbols");
+		unsigned nerr = run % 4;
+		for (unsigned k = 0; k < nerr; k++) {
+			unsigned y = (k * 61 + run * 5) % 252, a = (y % 12) * 21 + y / 12;
+			uint16_t sym = (uint16_t)(NXDN_SACCH_SYM + a / 2);
+			air_sym_put(frame, sym, (uint8_t)(air_sym_get(frame, sym) ^ ((a & 1) ? 1 : 2)));
+		}
+		int e = nxdn_lcac_get(frame, NULL, &work, out);
+		CHECK(e >= 0 && !memcmp(out, in, sizeof in), "long CAC %u errors: %d", nerr, e);
+	}
+
+	// The burst a call transmitter builds: preamble, then FSW, LICH and the long CAC under SR of the TX RAN
+	nxdn_call_tx_t t;
+	uint8_t msg[NXDN_LCAC_MSG_BYTES], syms[NXDN_PREAMBLE_SYMS + NXDN_FRAME_SYMS];
+	uint16_t n = 0;
+
+	fill(msg, sizeof msg);
+	nxdn_call_tx_burst(&t, msg, 9);
+	while (!nxdn_call_tx_done(&t)) {
+		uint16_t first, k = nxdn_call_tx_ready(&t, &first);
+		CHECK(k > 0, "burst symbols ready");
+		if (!k)
+			break;
+		for (uint16_t i = 0; i < k && n < sizeof syms; i++)
+			syms[n++] = air_sym_get(nxdn_call_tx_syms(&t), (uint16_t)(first + i));
+		nxdn_call_tx_sent(&t, k);
+	}
+	CHECK(n == NXDN_PREAMBLE_SYMS + NXDN_LCAC_SYMS, "burst length %u", n);
+	memset(frame, 0, sizeof frame);
+	for (uint16_t i = 0; i < NXDN_LCAC_SYMS; i++)
+		air_sym_put(frame, i, syms[NXDN_PREAMBLE_SYMS + i]);
+	CHECK(nxdn_lich_get(frame, NULL) == 0x08 && nxdn_lcac_get(frame, NULL, &work, out) == 0 &&
+	      out[0] == NXDN_SR(3, 9) && !memcmp(&out[1], msg, sizeof msg), "burst decodes");
+}
