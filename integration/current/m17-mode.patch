+#if CONFIG_M17
+#include "m17/m17_engine.h"
+#include "m17/m17_codeplug.h"
+#include "m17/m17_voice.h"
+// M17 through the radio core (docs/spec/m17.md 6): a stored M17 channel's CAN and destination, the source from the
+// radio's name; PTT sends a call with Codec 2 voice that a far M17 engine on the fake air hears with those fields;
+// the far radio's call is heard here and shows in the view; another CAN stays silent
+static struct {
+	unsigned starts, ends, voice;
+	m17_call_t call;
+	unsigned made, taken;
+} m17_far;
+static m17_engine_t m17_far_eng;
+static void m17_far_start(const m17_call_t *c, void *ctx) { (void)ctx; m17_far.starts++; m17_far.call = *c; }
+static void m17_far_voice(const uint8_t d[M17_STREAM_BYTES], void *ctx) { (void)d; (void)ctx; m17_far.voice++; }
+static void m17_far_end(void *ctx) { (void)ctx; m17_far.ends++; }
+static bool m17_far_tx(uint8_t d[M17_STREAM_BYTES], void *ctx)
+{
+	static const uint8_t quiet[M17_STREAM_BYTES] = M17_C2_SILENCE;
+
+	(void)ctx;
+	memcpy(d, quiet, sizeof(quiet));
+	return true;
+}
+static const m17_engine_hooks_t m17_far_hooks = { m17_far_start, m17_far_voice, m17_far_end, m17_far_tx };
+
+static void test_m17(void)
+{
+	m17_conv_t conv = { .can = 5 };
+	m17_voice_stats_t vs;
+
+	setup_codeplug();
+	cp_radio_name = "xe1abc";
+	add(3, "M17 refl", 446100000, RADIO_MODE_DMR, false, 2);	// the safe stand-in, zone Local position 2
+	strcpy(conv.dest, "M17-M17 C");
+	CHECK(m17_conv_save(3, &chans[3], &conv));
+	start();
+	req(RREQ_ZONE_POS, 2);
+	run(100);
+	CHECK(sm.view.channel_number == 3 && sm.view.ch.mode == RADIO_MODE_M17 && radio_m17_running());
+	CHECK(strcmp(sm.view.m17.talk, "M17-M17 C") == 0 && sm.view.m17.tx_can == 5);
+	CHECK((sm.view.m17.flags & RADIO_M17_ON) != 0);
+
+	// PTT: the far engine hears our call with the channel's fields and the radio's name as the source
+	m17_engine_cfg_t far = { .rx_can = M17_CAN_ANY, .tx_can = 5, .src = m17_addr_encode("N0CALL"),
+				 .dst = M17_ADDR_BROADCAST };
+	memset(&m17_far, 0, sizeof(m17_far));
+	CHECK(m17_engine_begin(&m17_far_eng, &fake_air1, &far, &m17_far_hooks, NULL));
+	sm.set.talk_permit = false;
+	aud.feed = true;
+	aud.feed_signal = true;
+	req(RREQ_PTT, 1);
+	run(800);
+	CHECK(sm.view.state == RS_TX && hw.keyed && aud.started);
+	req(RREQ_PTT, 0);
+	run(600);
+	CHECK(!hw.keyed && sm.view.state != RS_TX);
+	m17VoiceGetStats(&vs);
+	CHECK(vs.tx_encoded >= 20 && vs.tx_frames >= 8 && vs.alloc_fails == 0);
+	CHECK(m17_far.starts == 1 && m17_far.ends == 1 && m17_far.voice >= 10);
+	CHECK(strcmp(m17_far.call.src, "XE1ABC") == 0 && strcmp(m17_far.call.dst, "M17-M17 C") == 0 &&
+	      M17_TYPE_CAN(m17_far.call.type) == 5 && M17_TYPE_DT(m17_far.call.type) == M17_DT_VOICE);
+
+	// The far radio calls: heard here, its source in the view, its voice decoded
+	CHECK(m17_engine_tx_prepare(&m17_far_eng) && m17_engine_tx_go(&m17_far_eng));
+	run(600);
+	CHECK((sm.view.m17.flags & (RADIO_M17_RX | RADIO_M17_PLAYED)) == (RADIO_M17_RX | RADIO_M17_PLAYED));
+	CHECK(strcmp(sm.view.m17.src, "N0CALL") == 0 && sm.view.m17.can == 5 && sm.view.state == RS_RX);
+	m17_engine_tx_stop(&m17_far_eng);
+	run(400);
+	CHECK(m17_engine_tx_state(&m17_far_eng) == AIR_TX_DONE);
+	m17_engine_tx_clear(&m17_far_eng);
+	m17VoiceGetStats(&vs);
+	CHECK(vs.rx_calls >= 1 && vs.rx_frames >= 10);
+	CHECK((sm.view.m17.flags & RADIO_M17_RX) == 0);
+
+	// Another CAN: heard, never played
+	far.tx_can = 9;
+	m17_engine_set(&m17_far_eng, &far);
+	CHECK(m17_engine_tx_prepare(&m17_far_eng) && m17_engine_tx_go(&m17_far_eng));
+	run(600);
+	CHECK((sm.view.m17.flags & RADIO_M17_RX) != 0 && (sm.view.m17.flags & RADIO_M17_PLAYED) == 0);
+	m17_engine_tx_stop(&m17_far_eng);
+	run(400);
+	m17_engine_tx_clear(&m17_far_eng);
+	m17_engine_end(&m17_far_eng);
+	aud.feed = aud.feed_signal = false;
+	cp_radio_name = "";
+}
+#endif
