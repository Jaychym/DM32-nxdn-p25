diff --git a/core/radio/radio_m17.c b/core/radio/radio_m17.c
new file mode 100644
index 0000000..d11e4b9
--- /dev/null
+++ b/core/radio/radio_m17.c
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 on a channel, the radio core's side (radio_m17.h)
+#include "config.h"
+#if CONFIG_M17	// the whole file
+#include <string.h>
+#include "board.h"
+#include "radio/radio_m17.h"
+#include "radio/radio_bands.h"
+#include "m17/m17_engine.h"
+#include "m17/m17_codeplug.h"
+#include "m17/m17_voice.h"
+#include "codeplug/codeplug_modes.h"
+
+static m17_engine_t mem;
+static m17_engine_t *eng;		// while running
+static radio_m17_settings_t set;
+static bool monitor;
+
+void radio_m17_init(const hal_audio_t *audio)
+{
+	memset(&set, 0, sizeof(set));
+	strcpy(set.dest, M17_DEST_ALL);
+	eng = NULL;
+	m17VoiceInit(audio);
+}
+
+void radio_m17_settings(radio_m17_settings_t *out)
+{
+	*out = set;
+}
+
+void radio_m17_set_settings(const radio_m17_settings_t *s)
+{
+	set = *s;
+	set.can &= M17_CAN_MAX;
+	set.dest[M17_CALLSIGN_LEN] = '\0';
+	if (set.dest[0] == '\0')
+		strcpy(set.dest, M17_DEST_ALL);
+}
+
+uint32_t radio_m17_fit(void)
+{
+	return board.air != NULL ? m17_engine_fit(board.air) : 0;
+}
+
+bool radio_m17_fits(void)
+{
+	return (radio_m17_fit() & (AIR_FIT_RX | AIR_FIT_TX)) != 0;
+}
+
+bool radio_m17_take(channel_t *ch)
+{
+	if (ch->kind != CODEPLUG_KIND_M17 || !radio_m17_fits() || radio_listen_band(ch->rx_hz))
+		return false;
+	ch->mode = RADIO_MODE_M17;
+	ch->bw = RADIO_BW_12K5;
+	return true;
+}
+
+void radio_m17_monitor(bool on)
+{
+	monitor = on;
+}
+
+// The engine's configuration for channel ch at number (0: the VFO): a live stored M17 channel's tag, else the settings
+static void params(const channel_t *ch, uint16_t number, m17_engine_cfg_t *c)
+{
+	m17_conv_t cv = { .can = set.can };
+	char src[M17_CALLSIGN_LEN + 1];
+
+	strcpy(cv.dest, set.dest);
+	if (number != 0)
+		m17_conv_load(number, ch, &cv);
+	m17_source_load(src);
+	c->tx_can = cv.can;
+	c->rx_can = monitor ? M17_CAN_ANY : cv.can;
+	c->src = m17_addr_encode(src);
+	c->dst = m17_dest_encode(cv.dest);
+}
+
+bool radio_m17_begin(const channel_t *ch, uint16_t number)
+{
+	m17_engine_cfg_t cfg;
+
+	radio_m17_end();
+	params(ch, number, &cfg);
+	if (board.air == NULL || m17_engine_fit(board.air) == 0)
+		return false;
+	eng = &mem;
+	m17VoiceBegin();
+	if (!m17_engine_begin(eng, board.air, &cfg, m17VoiceHooks(), NULL)) {
+		m17VoiceEnd();
+		eng = NULL;
+		return false;
+	}
+	return true;
+}
+
+void radio_m17_end(void)
+{
+	if (eng == NULL)
+		return;
+	m17_engine_end(eng);	// the provider closed: no hook runs after this
+	m17VoiceEnd();
+	eng = NULL;
+}
+
+bool radio_m17_running(void)
+{
+	return eng != NULL;
+}
+
+void radio_m17_retuned(void)
+{
+	if (eng != NULL)
+		m17_engine_retuned(eng);
+}
+
+void radio_m17_apply(const channel_t *ch, uint16_t number)
+{
+	m17_engine_cfg_t cfg;
+
+	if (eng == NULL || m17_engine_tx_state(eng) != AIR_TX_IDLE)
+		return;
+	params(ch, number, &cfg);
+	m17_engine_set(eng, &cfg);
+}
+
+bool radio_m17_poll(radio_m17_view_t *v)
+{
+	m17_engine_view_t ev;
+	radio_m17_view_t n;
+
+	if (eng == NULL) {
+		n = *v;		// the last call heard stays
+		n.flags = 0;
+		n.tx = AIR_TX_IDLE;
+		strcpy(n.talk, set.dest);
+		n.tx_can = set.can;
+	} else {
+		m17VoicePoll();
+		m17_engine_view(eng, &ev);
+		memset(&n, 0, sizeof(n));
+		n.flags = RADIO_M17_ON;
+		if (ev.rx_active)
+			n.flags |= RADIO_M17_RX;
+		if (ev.rx_active && ev.rx_played)
+			n.flags |= RADIO_M17_PLAYED;
+		if (ev.rx.late)
+			n.flags |= RADIO_M17_LATE;
+		n.tx = ev.tx;
+		n.can = (uint8_t)M17_TYPE_CAN(ev.rx.type);
+		n.tx_can = eng->cfg.tx_can;
+		strcpy(n.src, ev.rx.src);
+		strcpy(n.dst, ev.rx.dst);
+		m17_addr_decode(eng->cfg.dst, n.talk);
+	}
+	n.fit = (uint16_t)radio_m17_fit();
+	bool changed = memcmp(&n, v, sizeof(n)) != 0;
+	*v = n;
+	return changed;
+}
+
+// ── Transmit: the radio_air_ops_t table ──
+static bool m17_no_tx(void)
+{
+	return eng != NULL && (eng->session.fit & AIR_FIT_TX) == 0;
+}
+
+static bool m17_tx_prepare(void)
+{
+	if (eng == NULL || !m17_engine_tx_prepare(eng))
+		return false;
+	m17VoicePause();	// the RX PCM stream ends while the modem still owns it, as YSF's VW path
+	return true;
+}
+
+static bool m17_tx_go(void)
+{
+	if (eng == NULL || !m17_engine_tx_go(eng))
+		return false;
+	// The provider is in the TX PHY: the microphone stream starts now, so its encoder belongs to this call
+	m17VoiceTx(true);
+	if (!m17VoiceStreaming()) {
+		m17VoiceTx(false);
+		m17_engine_tx_abort(eng);
+		return false;
+	}
+	return true;
+}
+
+static void m17_tx_stop(void)
+{
+	if (eng != NULL) {
+		m17VoiceTx(false);	// the engine sends the last frame (silence if none is ready) and the EoT
+		m17_engine_tx_stop(eng);
+	}
+}
+
+static void m17_tx_abort(void)
+{
+	if (eng != NULL) {
+		m17VoiceTx(false);
+		m17_engine_tx_abort(eng);
+	}
+}
+
+static uint8_t m17_tx_state(void)
+{
+	return eng != NULL ? (uint8_t)m17_engine_tx_state(eng) : (uint8_t)AIR_TX_IDLE;
+}
+
+static void m17_tx_clear(void)
+{
+	if (eng != NULL) {
+		m17VoiceTx(false);
+		m17_engine_tx_clear(eng);
+		m17VoicePause();	// back in RX: the stream starts again with the next call heard (m17VoicePoll)
+	}
+}
+
+const radio_air_ops_t radio_m17_air = {
+	radio_m17_running, m17_no_tx, m17_tx_prepare, m17_tx_go, m17_tx_stop, m17_tx_abort, m17_tx_state, m17_tx_clear,
+};
+
+#endif	// CONFIG_M17
diff --git a/core/radio/radio_m17.h b/core/radio/radio_m17.h
new file mode 100644
index 0000000..c1df93f
--- /dev/null
+++ b/core/radio/radio_m17.h
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 on a channel, the radio core's side (docs/spec/m17.md 6): the engine (core/m17/m17_engine.h) on the memory it
+// runs in, its stream contents to and from the Codec 2 voice path (core/m17/m17_voice.h), the channel's M17
+// parameters, and a compact view for the radio view. radio_sm.c decides when M17 runs and keys the transmitter
+// (radio_air.h); nothing here keys it.
+//
+// A stored M17 channel's parameters are its own (CAN and destination, docs/spec/m17.md 5); the VFO and a channel
+// whose mode was changed to M17 for now take the RAM settings (CAN 0, destination ALL). The source is the radio-wide
+// record's call sign, else the radio's name.
+#ifndef RADIO_M17_H
+#define RADIO_M17_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "config.h"
+#include "codeplug/codeplug.h"
