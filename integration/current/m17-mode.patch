+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 voice (core/m17/m17_voice.c) on the vendored Codec 2 (core/codec2): the codec fits its arena, a synthetic
+// voice through the encoder comes out as stream frames of the right size, those frames through the decoder come back
+// as audio of about the same level, and the engine's filler (M17_C2_SILENCE) decodes as near silence.
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+#include "m17/m17_voice.h"
+#include "codec2/codec2.h"
+
+static int fails;
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); fails++; } } while (0)
+
+// A vowel-like test voice: a 120 Hz pulse train's harmonics under two formants, with a slow level change
+static void voice(unsigned block, int16_t *pcm)
+{
+	for (int i = 0; i < AUDIO_BLOCK_SAMPLES; i++) {
+		double t = (block * AUDIO_BLOCK_SAMPLES + i) / 8000.0, v = 0;
+
+		for (int h = 1; h * 120 < 3600; h++) {
+			double f = h * 120, a = exp(-pow((f - 700) / 200, 2)) + 0.5 * exp(-pow((f - 1200) / 300, 2));
+
+			v += a * sin(2 * M_PI * f * t);
+		}
+		pcm[i] = (int16_t)(3000 * v * (0.6 + 0.4 * sin(2 * M_PI * 1.5 * t)));
+	}
+}
+
+static double rms(const int16_t *p, int n)
+{
+	double s = 0;
+
+	for (int i = 0; i < n; i++)
+		s += (double)p[i] * p[i];
+	return sqrt(s / n);
+}
+
+int main(void)
+{
+	const m17_engine_hooks_t *h = m17VoiceHooks();
+	m17_voice_stats_t st;
+	int16_t mic[AUDIO_BLOCK_SAMPLES] = { 0 }, spk[AUDIO_BLOCK_SAMPLES];
+	static uint8_t frames[60][M17_STREAM_BYTES];
+	unsigned nf = 0;
+	double in_rms = 0, out_rms = 0;
+
+	m17VoiceInit(NULL);	// no board audio: the callback is driven here
+	m17VoiceBegin();
+	m17VoiceAudioBlock(mic, spk, NULL);	// the first block makes the codec
+	m17VoiceGetStats(&st);
+	printf("m17 voice: Codec 2 3200 takes %u of %u arena bytes\n", st.arena_used, M17_VOICE_ARENA);
+	CHECK(st.alloc_fails == 0 && st.arena_used > 0 && st.arena_used <= M17_VOICE_ARENA);
+
+	// TX: 120 blocks (2.4 s) of voice in, a stream frame (two Codec 2 frames) out every second block
+	m17VoiceTx(true);
+	for (unsigned b = 0; b < 120; b++) {
+		uint8_t d[M17_STREAM_BYTES];
+
+		voice(b, mic);
+		in_rms += rms(mic, AUDIO_BLOCK_SAMPLES);
+		m17VoiceAudioBlock(mic, spk, NULL);
+		CHECK(rms(spk, AUDIO_BLOCK_SAMPLES) == 0);	// the speaker is silent while transmitting
+		if (h->tx_voice(d, NULL)) {
+			CHECK(b % 2 == 1);
+			memcpy(frames[nf++], d, M17_STREAM_BYTES);
+		}
+	}
+	m17VoiceTx(false);
+	m17VoiceGetStats(&st);
+	CHECK(nf == 60 && st.tx_encoded == 120 && st.tx_frames == 60);
+
+	// RX: the frames back through the hooks as the engine delivers them, one stream frame per two blocks
+	m17_call_t call = { .have_lsf = true };
+	h->rx_start(&call, NULL);
+	unsigned played = 0;
+	for (unsigned b = 0; b < 140; b++) {
+		if (b % 2 == 0 && b / 2 < nf)
+			h->rx_voice(frames[b / 2], NULL);
+		if (b / 2 == nf)
+			h->rx_end(NULL);
+		m17VoiceAudioBlock(mic, spk, NULL);
+		double r = rms(spk, AUDIO_BLOCK_SAMPLES);
+		out_rms += r;
+		played += r > 0;
+	}
+	m17VoiceGetStats(&st);
+	printf("m17 voice: in %.0f rms, decoded %.0f rms, %u blocks played, %u underruns\n", in_rms / 120, out_rms / played,
+	       played, st.rx_underruns);
+	CHECK(st.rx_in == 120 && st.rx_frames == 120 && st.rx_calls == 1 && st.rx_underruns == 0 && st.rx_overflows == 0);
+	CHECK(played >= 110);
+	// A vocoder is no waveform coder: the level, not the samples, survives
+	CHECK(out_rms / played > 0.3 * in_rms / 120 && out_rms / played < 3 * in_rms / 120);
+
+	// The engine's filler (M17_C2_SILENCE) through the decoder, a new call: near silence
+	{
+		static const uint8_t zero[M17_STREAM_BYTES] = M17_C2_SILENCE;
+		double z = 0;
+
+		h->rx_start(&call, NULL);
+		for (unsigned b = 0; b < 24; b++) {
+			if (b % 2 == 0)
+				h->rx_voice(zero, NULL);
+			m17VoiceAudioBlock(mic, spk, NULL);
+			z += rms(spk, AUDIO_BLOCK_SAMPLES);
+		}
+		h->rx_end(NULL);
+		printf("m17 voice: the silence frames decode at %.0f rms\n", z / 20);
+		CHECK(z / 20 < 0.05 * in_rms / 120);
+	}
+
+	// Host speed, for scale only: the radio's core has no FPU and runs this as software floating point
+	{
+		clock_t t0 = clock();
+
+		m17VoiceTx(true);
+		for (unsigned b = 0; b < 500; b++) {
+			uint8_t d[M17_STREAM_BYTES];
+
+			voice(b, mic);
+			m17VoiceAudioBlock(mic, spk, NULL);
+			(void)h->tx_voice(d, NULL);
+		}
+		m17VoiceTx(false);
+		double enc = (double)(clock() - t0) / CLOCKS_PER_SEC * 1e6 / 500;
+		t0 = clock();
+		h->rx_start(&call, NULL);
+		for (unsigned b = 0; b < 500; b++) {
+			if (b % 2 == 0)
+				h->rx_voice(frames[(b / 2) % nf], NULL);
+			m17VoiceAudioBlock(mic, spk, NULL);
+		}
+		printf("m17 voice: host time per 20 ms block: encode %.1f us, decode %.1f us\n", enc,
+		       (double)(clock() - t0) / CLOCKS_PER_SEC * 1e6 / 500);
+	}
+	m17VoiceEnd();
+	printf("m17VoiceTest: %s\n", fails ? "FAILED" : "all passed");
+	return fails != 0;
+}
