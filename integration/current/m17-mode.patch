diff --git a/core/m17/m17_codeplug.c b/core/m17/m17_codeplug.c
new file mode 100644
index 0000000..9538c81
--- /dev/null
+++ b/core/m17/m17_codeplug.c
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 channels in the codeplug (m17_codeplug.h, docs/spec/m17.md 5)
+#include <string.h>
+#include "config.h"
+#include "m17/m17_codeplug.h"
+#include "codeplug/codeplug_tag.h"
+#include "codeplug/codeplug_records.h"
+
+#if CONFIG_M17
+
+void m17_callsign_pack(const char *s, uint8_t out[M17_CALLSIGN_LEN])
+{
+	bool ended = s == NULL;
+
+	for (unsigned i = 0; i < M17_CALLSIGN_LEN; i++) {
+		char c = ' ';
+
+		if (!ended) {
+			if (s[i] == '\0')
+				ended = true;
+			else
+				c = s[i];
+		}
+		if (c >= 'a' && c <= 'z')
+			c = (char)(c - 'a' + 'A');
+		out[i] = (uint8_t)(c >= 0x20 && c <= 0x7E ? c : ' ');
+	}
+}
+
+void m17_callsign_unpack(const uint8_t b[M17_CALLSIGN_LEN], char out[M17_CALLSIGN_LEN + 1])
+{
+	unsigned n = 0;
+
+	for (unsigned i = 0; i < M17_CALLSIGN_LEN; i++)
+		out[n++] = b[i] >= 0x20 && b[i] <= 0x7E ? (char)b[i] : ' ';
+	while (n > 0 && out[n - 1] == ' ')
+		n--;
+	out[n] = '\0';
+}
+
+void m17_conv_decode(const uint8_t *b, int len, m17_conv_t *out)
+{
+	uint8_t dest[M17_CALLSIGN_LEN];
+	int n = len - 1 < (int)M17_CALLSIGN_LEN ? len - 1 : (int)M17_CALLSIGN_LEN;
+
+	out->can = len >= 1 ? (uint8_t)(b[0] & M17_CP_CAN_MASK) : 0u;
+	memset(dest, ' ', sizeof dest);
+	if (n > 0)
+		memcpy(dest, b + 1, (size_t)n);
+	m17_callsign_unpack(dest, out->dest);
+	if (out->dest[0] == '\0')
+		strcpy(out->dest, M17_DEST_ALL);
+}
+
+void m17_conv_encode(const m17_conv_t *c, uint8_t out[M17_CP_CONV_LEN])
+{
+	out[0] = (uint8_t)(c->can & M17_CP_CAN_MASK);
+	m17_callsign_pack(c->dest[0] ? c->dest : M17_DEST_ALL, out + 1);
+}
+
+void m17_source_load(char out[M17_CALLSIGN_LEN + 1])
+{
+	uint8_t b[M17_CP_IDENTITY_LEN];
+	int len = codeplug_mode_settings(CODEPLUG_KIND_M17, b, sizeof b);
+
+	if (len < (int)M17_CP_IDENTITY_LEN)
+		memset(b + (len > 0 ? len : 0), ' ', M17_CP_IDENTITY_LEN - (size_t)(len > 0 ? len : 0));
+	m17_callsign_unpack(b, out);
+	if (out[0] == '\0') {
+		char name[CODEPLUG_NAME_LEN + 1];
+
+		codeplug_radio_name(name);
+		m17_callsign_pack(name, b);
+		m17_callsign_unpack(b, out);
+	}
+}
+
+bool m17_conv_load(uint16_t number, const channel_t *ch, m17_conv_t *out)
+{
+	uint8_t b[M17_CP_CONV_LEN + CODEPLUG_TAG_HEAD_MAX];
+	const int cap = (int)M17_CP_CONV_LEN;
+	int len;
+
+	if (ch->kind != CODEPLUG_KIND_M17)
+		return false;
+	len = codeplug_tag_params(number, ch, b, (uint16_t)cap);
+	if (len < 0)
+		return false;
+	m17_conv_decode(b, len < cap ? len : cap, out);
+	return true;
+}
+
+bool m17_conv_save(uint16_t number, const channel_t *ch, const m17_conv_t *conv)
+{
+	channel_t c = *ch;
+	uint8_t blk[M17_CP_CONV_LEN];
+	uint8_t system = ch->kind == CODEPLUG_KIND_M17 ? ch->system : CODEPLUG_SYSTEM_NONE;
+	codeplug_tag_t t = { .kind = CODEPLUG_KIND_M17, .system = system, .flags = ch->rx_only ? 0u : CODEPLUG_TAG_TX };
+
+	// The safe stand-in, as every mode's (channel-modes.md 2.4): DMR, receive only; the tag carries transmit allowed
+	c.kind = CODEPLUG_KIND_M17;
+	c.system = system;
+	c.mode = RADIO_MODE_DMR;
+	c.rx_only = true;
+	m17_conv_encode(conv, blk);
+	return codeplug_set_channel(number, &c) && (codeplug_tag_rewrite(number, c.name, &t, blk, sizeof blk) ||
+						     codeplug_tag_write(number, c.name, &t, blk, sizeof blk));
+}
+
+#endif	// CONFIG_M17
diff --git a/core/m17/m17_codeplug.h b/core/m17/m17_codeplug.h
new file mode 100644
index 0000000..49f97f9
--- /dev/null
+++ b/core/m17/m17_codeplug.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 channels in the codeplug (docs/spec/m17.md 5): the parameter block of a channel of kind 7 and the radio-wide
+// record (the source call sign). Bytes in, values out. Built with CONFIG_M17
+#ifndef M17_CODEPLUG_H
+#define M17_CODEPLUG_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "codeplug/codeplug.h"
+#include "m17/m17_frame.h"
+
+#define M17_CP_CONV_LEN		10u	// byte 0 bits 0-3 CAN, bits 4-7 0; bytes 1-9 the destination
+#define M17_CP_IDENTITY_LEN	9u	// the source call sign
+#define M17_CP_CAN_MASK		0x0Fu
+
+typedef struct {
+	uint8_t can;				// channel access number, 0-15: what is sent and what is played
+	char dest[M17_CALLSIGN_LEN + 1];	// NUL-terminated, M17_DEST_ALL (broadcast) when unset
+} m17_conv_t;
+
+// 9 ASCII characters, space padded; a byte outside the printable range reads as a space, trailing spaces are trimmed
+void m17_callsign_pack(const char *s, uint8_t out[M17_CALLSIGN_LEN]);
+void m17_callsign_unpack(const uint8_t b[M17_CALLSIGN_LEN], char out[M17_CALLSIGN_LEN + 1]);
+// len bytes of a block (a short one, or none, takes the defaults: CAN 0, destination ALL); never fails
+void m17_conv_decode(const uint8_t *b, int len, m17_conv_t *out);
+void m17_conv_encode(const m17_conv_t *c, uint8_t out[M17_CP_CONV_LEN]);
+// The source call sign: the radio-wide record's, else the radio's name (the CPS call sign), upper case
+void m17_source_load(char out[M17_CALLSIGN_LEN + 1]);
+// Channel number's block from its tag (read by codeplug_channel): false when it isn't a live M17 channel
+bool m17_conv_load(uint16_t number, const channel_t *ch, m17_conv_t *out);
+// Write ch at number as an M17 channel with conv's block (channel-modes.md 2.4), as ysf_conv_save: the VFO or a mode
+// changed for now made a stored channel, or the channel editor's block
+bool m17_conv_save(uint16_t number, const channel_t *ch, const m17_conv_t *conv);
+
+#endif
diff --git a/core/m17/m17_engine.c b/core/m17/m17_engine.c
new file mode 100644
index 0000000..c918f72
--- /dev/null
+++ b/core/m17/m17_engine.c
@@ -0,0 +1,361 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 stream mode voice on a channel (m17_engine.h).
+#include "m17_engine.h"
+
+#include <string.h>
+
+#include "../../hal/hal_radio.h"
+
+// The sync bursts are 8 symbols, so they turn up in payload and noise too: the head hook takes a stream frame only
+// when its LICH decodes (four Golay words, a counter of 0-5), or, inside a call, when the Viterbi decoder corrected
+// no more than this many of the 272 coded bits (frames of noise: 27 or more in m17Test's 500)
+#define M17_ERRS_MAX	15
+
+enum { SYNC_STREAM, SYNC_LSF, SYNC_EOT };
+enum { TX_PRE, TX_LSF, TX_STREAM, TX_EOT, TX_END };
+
+static uint16_t rx_head(const air_frame_t *f, void *ctx);
+static void rx_frame(const air_frame_t *f, void *ctx);
+static void rx_lost(void *ctx);
+
+const air_mode_t m17_air_mode = {
+	.name = "M17",
+	.profile = {
+		.sym_rate = 4800,
+		.levels = 4,
+		.shape = AIR_SHAPE_RRC,		// 4FSK Generation: root raised cosine, alpha 0.5
+		.shape_param = 50,
+		.dev_outer_hz = 2400,		// Dibit, Symbol, and Frequency-shift: +-2.4 kHz, +-0.8 kHz
+		.timing = AIR_TIMING_CONTINUOUS,
+		.bw = RADIO_BW_12K5,
+		.sync_every_syms = 0,		// no 24-symbol pattern
+		.sync_any_syms = M17_FRAME_SYMS,	// a sync burst opens every frame
+		.idle = M17_PREAMBLE_BYTE,
+		.nsyncs = 3,
+		.sync = {
+			{ .id = SYNC_STREAM, .nsyms = 8, .max_errs = 1, .flags = AIR_SYNC_PERIODIC, .frame_at = 0,
+			  .syms = { 0xFF, 0x5D } },
+			// The preamble's last 8 symbols with the LSF sync burst: an LSF only ever follows the preamble
+			{ .id = SYNC_LSF, .nsyms = 16, .max_errs = 2, .flags = AIR_SYNC_START_ONLY, .frame_at = 8,
+			  .syms = { 0x77, 0x77, 0x55, 0xF7 } },
+			// The EoT marker: the head hook ends the call on it
+			{ .id = SYNC_EOT, .nsyms = 8, .max_errs = 1, .flags = AIR_SYNC_PERIODIC, .frame_at = 0,
+			  .syms = { 0x55, 0x5D } },
+		},
+	},
+	.frame_syms = M17_FRAME_SYMS,
+	.head_syms = M17_FRAME_SYMS,	// the interleaver spreads the LICH over the whole frame
+	.lost_frames = 3,
+	.head = rx_head,
+	.rx_frame = rx_frame,
+	.rx_lost = rx_lost,
+};
+
+uint32_t m17_engine_fit(const hal_air_t *air)
+{
+	return air_session_fit(air, &m17_air_mode);
+}
+
+// ── Receive (provider's task) ──
+static void view_begin(m17_engine_t *e) { e->seq++; }
+static void view_end(m17_engine_t *e) { e->seq++; }
+
+static void view_call(m17_engine_t *e)
+{
+	view_begin(e);
+	e->view.rx = e->call;
+	e->view.rx_active = e->in_call;
+	e->view.rx_played = e->played;
+	view_end(e);
+}
+
+// What is played: a stream of 3200 bit/s voice in the clear, of our CAN (or any, rx_can M17_CAN_ANY)
+static bool wanted(const m17_engine_t *e)
+{
+	uint16_t t = e->call.type;
+
+	return e->call.have_lsf && (t & M17_TYPE_STREAM) && M17_TYPE_DT(t) == M17_DT_VOICE && M17_TYPE_ENC(t) == 0 &&
+	       (e->cfg.rx_can == M17_CAN_ANY || M17_TYPE_CAN(t) == e->cfg.rx_can);
+}
+
+static void judge(m17_engine_t *e)
+{
+	bool play = wanted(e);
+
+	if (play && !e->played) {
+		e->played = true;
+		if (e->hooks.rx_start)
+			e->hooks.rx_start(&e->call, e->ctx);
+	} else if (!play && e->played) {
+		e->played = false;
+		if (e->hooks.rx_end)
+			e->hooks.rx_end(e->ctx);
+	}
+	view_call(e);
+}
+
+static void call_begin(m17_engine_t *e)
+{
+	memset(&e->call, 0, sizeof(e->call));
+	e->in_call = true;
+	e->played = false;
+	e->acc_mask = 0;
+	view_begin(e);
+	e->view.rx_calls++;
+	view_end(e);
+}
+
+static void call_end(m17_engine_t *e)
+{
+	if (!e->in_call)
+		return;
+	e->in_call = false;
+	if (e->played && e->hooks.rx_end)
+		e->hooks.rx_end(e->ctx);
+	e->played = false;
+	view_call(e);
+}
+
+static void call_lsf(m17_engine_t *e, const uint8_t lsf[M17_LSF_BYTES], bool late)
+{
+	m17_lsf_t l;
+
+	if (!m17_lsf_unpack(lsf, &l))
+		return;
+	memcpy(e->lsf, lsf, M17_LSF_BYTES);
+	e->call.have_lsf = true;
+	e->call.late = late;
+	e->call.type = l.type;
+	m17_addr_decode(l.src, e->call.src);
+	m17_addr_decode(l.dst, e->call.dst);
+	if (!wanted(e)) {
+		view_begin(e);
+		e->view.rx_rejects++;
+		view_end(e);
+	}
+	judge(e);
+}
+
+static uint16_t rx_head(const air_frame_t *f, void *ctx)
+{
+	m17_engine_t *e = ctx;
+	uint8_t id = (f->flags & AIR_FRAME_NO_SYNC) ? SYNC_STREAM : f->sync_id;
+
+	e->kind = 0;
+	if (id == SYNC_EOT || ((f->flags & AIR_FRAME_NO_SYNC) && !e->locked))
+		return 0;
+	if (id == SYNC_LSF) {
+		if (m17_lsf_decode(f->hard, f->soft, &e->work, e->acc) < 0)
+			return 0;
+		e->kind = SYNC_LSF + 1;
+	} else {
+		m17_stream_decode(f->hard, f->soft, &e->work, &e->st);
+		if (!e->st.lich_ok && !(e->locked && e->st.errs <= M17_ERRS_MAX))
+			return 0;
+		e->kind = SYNC_STREAM + 1;
+	}
+	e->locked = true;
+	return M17_FRAME_SYMS;
+}
+
+static void rx_frame(const air_frame_t *f, void *ctx)
+{
+	m17_engine_t *e = ctx;
+
+	(void)f;
+	if (e->kind == SYNC_LSF + 1) {
+		// A new transmission: whatever was in hand has ended
+		call_end(e);
+		call_begin(e);
+		call_lsf(e, e->acc, false);
+		e->acc_mask = 0x3F;	// nothing more to rebuild
+		return;
+	}
+	if (e->kind != SYNC_STREAM + 1)
+		return;
+	if (!e->in_call)
+		call_begin(e);
+	view_begin(e);
+	e->view.rx_frames++;
+	view_end(e);
+	if (e->st.lich_ok && e->acc_mask != 0x3F) {
+		// Late entry: the LSF rebuilt from the six LICH chunks
+		uint8_t cnt = (uint8_t)(e->st.lich[5] >> 5);
+
+		memcpy(e->acc + 5 * cnt, e->st.lich, 5);
+		e->acc_mask |= (uint8_t)(1u << cnt);
+		if (e->acc_mask == 0x3F) {
+			if (m17_crc(e->acc, M17_LSF_BYTES) == 0)
+				call_lsf(e, e->acc, true);
+			else
+				e->acc_mask = 0;	// a chunk was wrong: collect them again
+		}
+	}
+	if (e->recheck) {
+		e->recheck = false;
+		judge(e);
+	}
+	e->call.frames++;
+	if (e->played && e->hooks.rx_voice)
+		e->hooks.rx_voice(e->st.data, e->ctx);
+	if (e->st.fn & 0x8000u)
+		call_end(e);	// the last frame of the stream
+}
+
+static void rx_lost(void *ctx)
+{
+	m17_engine_t *e = ctx;
+
+	e->locked = false;
+	call_end(e);
+}
+
+// ── Transmit ──
+// Symbols to the session while its queue has room: the preamble, the LSF, stream frames, the EoT marker. Stream
+// contents the encoder has not made yet are waited for as long as the air can spare, then silence goes instead
+static void tx_fill(void *ctx)
+{
+	m17_engine_t *e = ctx;
+	const hal_air_t *air = e->session.air;
+	uint16_t lead = (uint16_t)(((uint32_t)air->tx_lead_ms * m17_air_mode.profile.sym_rate) / 1000 + air->tx_chunk_syms);
+
+	for (;;) {
+		if (e->tx_pos >= M17_FRAME_SYMS) {
+			uint8_t data[M17_STREAM_BYTES];
+			bool last;
+
+			switch (e->tx_phase) {
+			case TX_PRE:
+				memset(e->tx_syms, M17_PREAMBLE_BYTE, M17_FRAME_BYTES);
+				e->tx_phase = TX_LSF;
+				break;
+			case TX_LSF:
+				m17_lsf_frame(e->tx_lsf, e->tx_syms);
+				e->tx_phase = TX_STREAM;
+				break;
+			case TX_STREAM:
+				last = e->tx_stop;
+				if (e->hooks.tx_voice && e->hooks.tx_voice(data, e->ctx)) {
+					// (voice ready)
+				} else if (!e->hooks.tx_voice || last ||
+					   (air_session_tx_state(&e->session) != AIR_TX_PRIMING &&
+					    air_session_tx_queued(&e->session) < lead)) {
+					static const uint8_t quiet[M17_STREAM_BYTES] = M17_C2_SILENCE;
+
+					if (e->hooks.tx_voice)
+						e->view.tx_filler++;
+					memcpy(data, quiet, sizeof(data));
+				} else {
+					return;
+				}
+				m17_stream_frame(e->tx_lsf, (uint8_t)(e->tx_fn % 6u), (uint16_t)(e->tx_fn | (last ? 0x8000u : 0)),
+						 data, e->tx_syms);
+				e->tx_fn = (uint16_t)((e->tx_fn + 1u) & 0x7FFFu);
+				if (last)
+					e->tx_phase = TX_EOT;
+				break;
+			case TX_EOT:
+				m17_eot_frame(e->tx_syms);
+				e->tx_phase = TX_END;
+				break;
+			default:
+				air_session_tx_finish(&e->session);
+				return;
+			}
+			e->tx_pos = 0;
+		}
+		uint16_t n = air_session_tx_space(&e->session);
+
+		if (!n)
+			return;
+		if (n > M17_FRAME_SYMS - e->tx_pos)
+			n = (uint16_t)(M17_FRAME_SYMS - e->tx_pos);
+		if (!air_session_tx(&e->session, e->tx_syms, e->tx_pos, n))
+			return;
+		e->tx_pos = (uint16_t)(e->tx_pos + n);
+	}
+}
+
+static const air_session_ops_t ops = { tx_fill, NULL };
+
+bool m17_engine_begin(m17_engine_t *e, const hal_air_t *air, const m17_engine_cfg_t *cfg,
+		      const m17_engine_hooks_t *hooks, void *ctx)
+{
+	memset(e, 0, sizeof *e);
+	e->cfg = *cfg;
+	e->hooks = *hooks;
+	e->ctx = ctx;
+	return air_session_open(&e->session, air, &m17_air_mode, e, e->frame, e->soft, M17_FRAME_SYMS, &ops, e);
+}
+
+void m17_engine_end(m17_engine_t *e)
+{
+	air_session_close(&e->session);
+}
+
+void m17_engine_retuned(m17_engine_t *e)
+{
+	air_session_retuned(&e->session);
+}
+
+void m17_engine_set(m17_engine_t *e, const m17_engine_cfg_t *cfg)
+{
+	e->cfg = *cfg;
+	e->recheck = true;
+}
+
+bool m17_engine_tx_prepare(m17_engine_t *e)
+{
+	if (!air_session_is_open(&e->session) || !(e->session.fit & AIR_FIT_TX))
+		return false;
+	if (air_session_tx_state(&e->session) == AIR_TX_IDLE) {
+		m17_lsf_t l = { .dst = e->cfg.dst, .src = e->cfg.src, .type = M17_TYPE_VOICE(e->cfg.tx_can) };
+
+		m17_lsf_pack(&l, e->tx_lsf);
+		e->tx_stop = false;
+		e->tx_phase = TX_PRE;
+		e->tx_pos = M17_FRAME_SYMS;
+		e->tx_fn = 0;
+	}
+	return air_session_tx_prime(&e->session);
+}
+
+bool m17_engine_tx_go(m17_engine_t *e)
+{
+	if (!air_session_tx_go(&e->session))
+		return false;
+	e->view.tx_calls++;
+	return true;
+}
+
+void m17_engine_tx_stop(m17_engine_t *e)
+{
+	e->tx_stop = true;
+}
+
+void m17_engine_tx_abort(m17_engine_t *e)
+{
+	air_session_tx_abort(&e->session);
+}
+
+air_tx_state_t m17_engine_tx_state(const m17_engine_t *e)
+{
+	return air_session_tx_state(&e->session);
+}
+
+void m17_engine_tx_clear(m17_engine_t *e)
+{
+	air_session_tx_clear(&e->session);
+}
+
+void m17_engine_view(const m17_engine_t *e, m17_engine_view_t *out)
+{
+	uint8_t seq;
+
+	do {
+		seq = e->seq;
+		*out = e->view;
+	} while ((seq & 1) || seq != e->seq);
+	out->tx = (uint8_t)air_session_tx_state(&e->session);
+}
diff --git a/core/m17/m17_engine.h b/core/m17/m17_engine.h
new file mode 100644
index 0000000..b287f1e
--- /dev/null
+++ b/core/m17/m17_engine.h
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 stream mode voice on a channel (docs/spec/m17.md): the frames (m17_frame.h) on an air interface session
+// (core/air/air_session.h), as the NXDN and YSF engines. The radio core begins it on an M17 channel and ends it on
+// leaving; in between it receives calls, hands their stream contents to a sink, and transmits when the radio core says
+// so. No RTOS call: the radio core's task and the provider's task use it as air_session.h describes; the stream
+// contents (two 3200 bit/s Codec 2 frames each) cross to and from the audio side through the caller's hooks.
+#ifndef M17_ENGINE_H
+#define M17_ENGINE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "air/air_session.h"
+#include "m17_frame.h"
+
+#define M17_CAN_ANY		0xFFu	// rx_can: every channel access number
+
+// A call as the radio glue sees it
+typedef struct {
+	bool have_lsf;			// the LSF is known: from its frame, or rebuilt from six LICH chunks
+	bool late;			// ... rebuilt (no LSF frame heard)
+	uint16_t type;			// its TYPE
+	char src[M17_CALLSIGN_LEN + 1];
+	char dst[M17_CALLSIGN_LEN + 1];	// M17_DEST_ALL for the broadcast address
+	uint32_t frames;		// stream frames of this call
+} m17_call_t;
+
+typedef struct {
+	uint8_t rx_can;			// M17_CAN_ANY, or 0-15: calls with another CAN stay silent
+	uint8_t tx_can;
+	uint64_t src, dst;		// the addresses sent (m17_addr_encode, m17_dest_encode)
+} m17_engine_cfg_t;
+
+typedef struct {
+	// Receive, from the provider's task. start: a call we take began. voice: one stream frame's 16 bytes (two
+	// Codec 2 frames, 40 ms)
+	void (*rx_start)(const m17_call_t *c, void *ctx);
+	void (*rx_voice)(const uint8_t data[M17_STREAM_BYTES], void *ctx);
+	void (*rx_end)(void *ctx);
+	// Transmit, from the provider's task: the next 16 bytes, false when none are ready. NULL: every frame is silent
+	bool (*tx_voice)(uint8_t data[M17_STREAM_BYTES], void *ctx);
+} m17_engine_hooks_t;
+
+typedef struct {
+	bool rx_active;			// a call is being received (whether or not it is played)
+	bool rx_played;
+	m17_call_t rx;			// its fields; kept after it ends (the last call heard)
+	uint8_t tx;			// air_tx_state_t
+	uint32_t rx_calls, tx_calls;
+	uint32_t rx_frames;		// stream frames decoded
+	uint32_t rx_rejects;		// calls the CAN, data type or encryption kept silent
+	uint32_t tx_filler;		// silent frames sent because the encoder had none ready
+} m17_engine_view_t;
+
+typedef struct {
+	air_session_t session;
+	m17_engine_cfg_t cfg;
+	m17_engine_hooks_t hooks;
+	void *ctx;
+	// Receive: what the head hook decoded of the frame in hand, for rx_frame
+	m17_work_t work;
+	uint8_t kind;			// sync burst of the frame in hand (M17_SYNC_*), 0 none
+	bool locked;			// the head hook took a frame since the last loss
+	uint8_t lsf[M17_LSF_BYTES];	// the call's LSF
+	uint8_t acc[M17_LSF_BYTES];	// LICH chunks of a late entry ...
+	uint8_t acc_mask;		// ... which of the six are in
+	m17_stream_t st;
+	bool in_call, played;
+	volatile bool recheck;		// m17_engine_set changed what passes the squelch
+	m17_call_t call;
+	// Transmit
+	uint8_t tx_lsf[M17_LSF_BYTES];
+	uint8_t tx_syms[M17_FRAME_BYTES];	// the frame being queued
+	uint16_t tx_pos;		// its next symbol; M17_FRAME_SYMS: a new one is due
+	uint8_t tx_phase;		// preamble, LSF, stream, EoT, done
+	uint16_t tx_fn;
+	volatile bool tx_stop;		// the radio core let go: the next frame is the last
+	volatile uint8_t seq;		// odd while the provider's task writes view
+	m17_engine_view_t view;
+	uint8_t frame[M17_FRAME_BYTES];	// the framer's frame buffer ...
+	int8_t soft[M17_FRAME_SYMS];	// ... and its soft values
+} m17_engine_t;
+
+extern const air_mode_t m17_air_mode;
+
+// What the board's provider gives M17: AIR_FIT_xxx, 0 = this board can't
+uint32_t m17_engine_fit(const hal_air_t *air);
+bool m17_engine_begin(m17_engine_t *e, const hal_air_t *air, const m17_engine_cfg_t *cfg,
+		      const m17_engine_hooks_t *hooks, void *ctx);
+void m17_engine_end(m17_engine_t *e);
+void m17_engine_retuned(m17_engine_t *e);
+// Change what is received and sent while running. Not while transmitting
+void m17_engine_set(m17_engine_t *e, const m17_engine_cfg_t *cfg);
+
+// Transmit (the radio core's task), as nxdn_engine.h: prepare queues the preamble and the LSF, go after
+// hal_radio_t.tx(); stop: the next stream frame is the last, then the EoT marker
+bool m17_engine_tx_prepare(m17_engine_t *e);
+bool m17_engine_tx_go(m17_engine_t *e);
+void m17_engine_tx_stop(m17_engine_t *e);
+void m17_engine_tx_abort(m17_engine_t *e);
+air_tx_state_t m17_engine_tx_state(const m17_engine_t *e);
+void m17_engine_tx_clear(m17_engine_t *e);
+
+void m17_engine_view(const m17_engine_t *e, m17_engine_view_t *out);
+
+#endif
diff --git a/core/m17/m17_frame.c b/core/m17/m17_frame.c
new file mode 100644
index 0000000..0c8fe44
--- /dev/null
+++ b/core/m17/m17_frame.c
@@ -0,0 +1,279 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 frames (m17_frame.h). Section numbers in comments are the M17 Protocol Specification's chapter names.
+#include "m17_frame.h"
+
+#include <string.h>
+
+#include "air/air_syms.h"
+#include "fec/conv.h"
+#include "fec/golay.h"
+#include "../../hal/hal_air.h"
+
+// Convolutional Encoder: G1 = 1 + D^3 + D^4, G2 = 1 + D + D^2 + D^4 (bit k = D^k)
+static const fec_conv_code_t code = { 0x19, 0x17 };
+
+// Randomizer Sequence: payload bit k is XORed with bit 7 - (k % 8) of byte (k / 8) % 46
+static const uint8_t rnd[46] = {
+	0xD6, 0xB5, 0xE2, 0x30, 0x82, 0xFF, 0x84, 0x62, 0xBA, 0x4E, 0x96, 0x90, 0xD8, 0x98, 0xDD, 0x5D,
+	0x0C, 0xC8, 0x52, 0x43, 0x91, 0x1D, 0xF8, 0x6E, 0x68, 0x2F, 0x35, 0xDA, 0x14, 0xEA, 0xCD, 0x76,
+	0x19, 0x8D, 0xD5, 0x80, 0xD1, 0x33, 0x87, 0x13, 0x57, 0x18, 0x2D, 0x29, 0x78, 0xC3,
+};
+
+// Interleaving: Type 3 bit x goes to Type 4 bit pi(x) (the polynomial is its own inverse over 368)
+static uint16_t qpp(uint16_t x)
+{
+	return (uint16_t)((45u * x + 92u * (uint32_t)x * x) % M17_PAYLOAD_BITS);
+}
+
+// Code Puncturing. P1: a leading 1, then 1 0 1 1 fifteen times (61 entries, 46 kept), used 8 times over the LSF's 488
+// coded bits. P2: every 12th of the stream contents' 296 coded bits dropped
+static bool p1_keeps(uint16_t j)
+{
+	j %= 61;
+	return j == 0 || ((j - 1) & 3) != 1;
+}
+
+static bool p2_keeps(uint16_t j)
+{
+	return j % 12 != 11;
+}
+
+uint16_t m17_crc(const uint8_t *p, size_t n)
+{
+	uint16_t crc = 0xFFFF;
+
+	while (n--) {
+		crc ^= (uint16_t)(*p++ << 8);
+		for (int b = 0; b < 8; b++)
+			crc = (uint16_t)(crc & 0x8000u ? (unsigned)(crc << 1) ^ 0x5935u : (unsigned)(crc << 1));
+	}
+	return crc;
+}
+
+// The M17 alphabet: space, A-Z, 0-9, '-', '/', '.'
+static const char alphabet[] = " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-/.";
+
+static unsigned b40(char c)
+{
+	if (c >= 'a' && c <= 'z')
+		c = (char)(c - 'a' + 'A');
+	for (unsigned v = 1; v < 40; v++)
+		if (alphabet[v] == c)
+			return v;
+	return 0;
+}
+
+uint64_t m17_addr_encode(const char *cs)
+{
+	size_t n = strlen(cs);
+	uint64_t a = 0;
+
+	if (n > M17_CALLSIGN_LEN)
+		n = M17_CALLSIGN_LEN;
+	// Callsign Encoding: the first character in the least significant digit
+	while (n--)
+		a = a * 40u + b40(cs[n]);
+	return a;
+}
+
+void m17_addr_decode(uint64_t a, char out[M17_CALLSIGN_LEN + 1])
+{
+	size_t n = 0;
+
+	if (a == M17_ADDR_BROADCAST) {
+		strcpy(out, M17_DEST_ALL);
+		return;
+	}
+	if (a <= M17_ADDR_MAX) {
+		for (; a != 0 && n < M17_CALLSIGN_LEN; a /= 40u)
+			out[n++] = alphabet[a % 40u];
+	}
+	while (n && out[n - 1] == ' ')
+		n--;
+	out[n] = '\0';
+}
+
+uint64_t m17_dest_encode(const char *cs)
+{
+	uint64_t a = m17_addr_encode(cs);
+
+	return a == 0 || a == m17_addr_encode(M17_DEST_ALL) ? M17_ADDR_BROADCAST : a;
+}
+
+static void put48(uint8_t *p, uint64_t v)
+{
+	for (int i = 5; i >= 0; i--, v >>= 8)
+		p[i] = (uint8_t)v;
+}
+
+static uint64_t get48(const uint8_t *p)
+{
+	uint64_t v = 0;
+
+	for (int i = 0; i < 6; i++)
+		v = v << 8 | p[i];
+	return v;
+}
+
+void m17_lsf_pack(const m17_lsf_t *l, uint8_t out[M17_LSF_BYTES])
+{
+	put48(out, l->dst);
+	put48(out + 6, l->src);
+	out[12] = (uint8_t)(l->type >> 8);
+	out[13] = (uint8_t)l->type;
+	memcpy(out + 14, l->meta, sizeof(l->meta));
+	uint16_t crc = m17_crc(out, 28);
+	out[28] = (uint8_t)(crc >> 8);
+	out[29] = (uint8_t)crc;
+}
+
+bool m17_lsf_unpack(const uint8_t in[M17_LSF_BYTES], m17_lsf_t *l)
+{
+	if (m17_crc(in, M17_LSF_BYTES) != 0)	// the CRC over the whole LSF, its own field included, is zero
+		return false;
+	l->dst = get48(in);
+	l->src = get48(in + 6);
+	l->type = (uint16_t)(in[12] << 8 | in[13]);
+	memcpy(l->meta, in + 14, sizeof(l->meta));
+	return true;
+}
+
+// ── Transmit ──
+
+// Type 3 bits (368, packed) to the frame: interleaved, randomized, behind the sync burst
+static void frame_out(uint16_t sync, const uint8_t t3[M17_PAYLOAD_BITS / 8], uint8_t syms[M17_FRAME_BYTES])
+{
+	uint8_t *t4 = syms + 2;
+
+	syms[0] = (uint8_t)(sync >> 8);
+	syms[1] = (uint8_t)sync;
+	memset(t4, 0, M17_PAYLOAD_BITS / 8);
+	for (uint16_t i = 0; i < M17_PAYLOAD_BITS; i++)
+		air_bit_put(t4, qpp(i), air_bit_get(t3, i));
+	for (unsigned k = 0; k < M17_PAYLOAD_BITS / 8; k++)
+		t4[k] ^= rnd[k];
+}
+
+void m17_lsf_frame(const uint8_t lsf[M17_LSF_BYTES], uint8_t syms[M17_FRAME_BYTES])
+{
+	uint8_t in[31], coded[61], t3[M17_PAYLOAD_BITS / 8];
+	uint16_t n = 0;
+
+	memcpy(in, lsf, M17_LSF_BYTES);
+	in[30] = 0;			// the 4 flush bits
+	fec_conv_encode(&code, in, 244, coded);
+	for (uint16_t j = 0; j < 488; j++)
+		if (p1_keeps(j))
+			air_bit_put(t3, n++, air_bit_get(coded, j));
+	frame_out(M17_SYNC_LSF, t3, syms);
+}
+
+void m17_stream_frame(const uint8_t lsf[M17_LSF_BYTES], uint8_t cnt, uint16_t fn,
+		      const uint8_t data[M17_STREAM_BYTES], uint8_t syms[M17_FRAME_BYTES])
+{
+	uint8_t lich[M17_LICH_BYTES], in[19], coded[37], t3[M17_PAYLOAD_BITS / 8];
+	uint16_t n = 96;
+
+	// LICH: the cnt-th 40 bits of the LSF and the counter, in four Golay (24,12) words
+	memcpy(lich, lsf + 5 * cnt, 5);
+	lich[5] = (uint8_t)(cnt << 5);
+	for (unsigned w = 0; w < 4; w++) {
+		const uint8_t *p = lich + 3 * (w >> 1);
+		uint16_t d = w & 1 ? (uint16_t)((p[1] & 0x0F) << 8 | p[2]) : (uint16_t)(p[0] << 4 | p[1] >> 4);
+		uint32_t cw = fec_golay24_encode(d);
+
+		t3[3 * w] = (uint8_t)(cw >> 16);
+		t3[3 * w + 1] = (uint8_t)(cw >> 8);
+		t3[3 * w + 2] = (uint8_t)cw;
+	}
+	// Stream contents: FN and 128 bits, the flush bits, coded and P2 punctured
+	in[0] = (uint8_t)(fn >> 8);
+	in[1] = (uint8_t)fn;
+	memcpy(in + 2, data, M17_STREAM_BYTES);
+	in[18] = 0;
+	fec_conv_encode(&code, in, 148, coded);
+	for (uint16_t j = 0; j < 296; j++)
+		if (p2_keeps(j))
+			air_bit_put(t3, n++, air_bit_get(coded, j));
+	frame_out(M17_SYNC_STREAM, t3, syms);
+}
+
+void m17_eot_frame(uint8_t syms[M17_FRAME_BYTES])
+{
+	for (unsigned k = 0; k < M17_FRAME_BYTES; k += 2) {
+		syms[k] = (uint8_t)(M17_SYNC_EOT >> 8);
+		syms[k + 1] = (uint8_t)M17_SYNC_EOT;
+	}
+}
+
+// ── Receive ──
+
+static int8_t clamp8(int v)
+{
+	return (int8_t)(v > 127 ? 127 : v < -127 ? -127 : v);
+}
+
+// Type 3 bit x as a soft value (positive says 1): its Type 4 position's dibit, derandomized. Of a dibit (+3 01, +1 00,
+// -1 10, -3 11) the first bit says the sign is negative and the second that the symbol is an outer one
+static int8_t t3_soft(const uint8_t *hard, const int8_t *soft, uint16_t x)
+{
+	uint16_t k = qpp(x);
+	uint16_t sym = (uint16_t)(M17_SYNC_SYMS + k / 2);
+	int v;
+
+	if (soft) {
+		int s = soft[sym];
+
+		v = k & 1 ? (s < 0 ? -s : s) - 2 * AIR_SOFT_OUTER / 3 : -s;
+	} else {
+		uint8_t d = air_sym_get(hard, sym);
+
+		v = ((k & 1 ? d : d >> 1) & 1) ? 64 : -64;
+	}
+	if ((rnd[k >> 3] >> (7 - (k & 7))) & 1)
+		v = -v;
+	return clamp8(v);
+}
+
+int m17_lsf_decode(const uint8_t *hard, const int8_t *soft, m17_work_t *w, uint8_t lsf[M17_LSF_BYTES])
+{
+	uint16_t n = 0;
+
+	for (uint16_t j = 0; j < 488; j++)
+		w->soft[j] = p1_keeps(j) ? t3_soft(hard, soft, n++) : 0;
+	int errs = fec_conv_decode(&code, w->soft, 244, w->dec, w->bits);
+	memcpy(lsf, w->bits, M17_LSF_BYTES);
+	return m17_crc(lsf, M17_LSF_BYTES) == 0 ? errs : -1;
+}
+
+void m17_stream_decode(const uint8_t *hard, const int8_t *soft, m17_work_t *w, m17_stream_t *out)
+{
+	uint16_t n = 96;
+
+	out->lich_ok = true;
+	for (unsigned k = 0; k < 4; k++) {
+		uint32_t cw = 0;
+		uint16_t d = 0;
+
+		for (uint16_t b = 0; b < 24; b++)
+			cw = cw << 1 | (t3_soft(hard, soft, (uint16_t)(24 * k + b)) > 0);
+		if (fec_golay24_decode(cw, &d) < 0)
+			out->lich_ok = false;
+		uint8_t *p = out->lich + 3 * (k >> 1);
+		if (k & 1) {
+			p[1] = (uint8_t)((p[1] & 0xF0) | (d >> 8));
+			p[2] = (uint8_t)d;
+		} else {
+			p[0] = (uint8_t)(d >> 4);
+			p[1] = (uint8_t)((d & 0x0F) << 4);
+		}
+	}
+	if ((out->lich[5] >> 5) > 5)
+		out->lich_ok = false;
+	for (uint16_t j = 0; j < 296; j++)
+		w->soft[j] = p2_keeps(j) ? t3_soft(hard, soft, n++) : 0;
+	out->errs = fec_conv_decode(&code, w->soft, 148, w->dec, w->bits);
+	out->fn = (uint16_t)(w->bits[0] << 8 | w->bits[1]);
+	memcpy(out->data, w->bits + 2, M17_STREAM_BYTES);
+}
diff --git a/core/m17/m17_frame.h b/core/m17/m17_frame.h
new file mode 100644
index 0000000..328383f
--- /dev/null
+++ b/core/m17/m17_frame.h
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 frames (docs/spec/m17.md, from the M17 Protocol Specification): the link setup frame (LSF), stream frames with
+// their LICH, the address encoding and the CRC. Bytes in, channel symbols out, and back: no state, no RTOS call.
+//
+// A frame is 192 symbols: an 8-symbol sync burst, then 368 payload bits (184 dibits, the first bit of a dibit its
+// MSB). Payload: Type 1 bits, plus 4 flush bits, coded by the rate 1/2 K=5 code (G1 = 1 + D^3 + D^4, G2 = 1 + D + D^2
+// + D^4, core/fec/conv.h), punctured (P1 for the LSF, P2 for the stream contents), the stream frame's LICH coded by
+// Golay (24,12) instead (core/fec/golay.h), then interleaved by pi(x) = (45x + 92x^2) mod 368 and randomized with the
+// 46-byte sequence.
+#ifndef M17_FRAME_H
+#define M17_FRAME_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define M17_FRAME_SYMS		192
+#define M17_FRAME_BYTES		(M17_FRAME_SYMS / 4)
+#define M17_SYNC_SYMS		8
+#define M17_PAYLOAD_BITS	368
+#define M17_LSF_BYTES		30	// DST 6, SRC 6, TYPE 2, META 14, CRC 2
+#define M17_LICH_BYTES		6	// a 40-bit chunk of the LSF, then LICH_CNT in bits 7-5
+#define M17_STREAM_BYTES	16	// 128 bits per frame: two 3200 bit/s Codec 2 frames
+#define M17_CALLSIGN_LEN	9	// base-40 characters an address holds
+
+// Sync bursts (16 bits, 8 outer symbols); the EoT marker repeats its pattern for 40 ms
+#define M17_SYNC_LSF		0x55F7u
+#define M17_SYNC_BERT		0xDF55u
+#define M17_SYNC_STREAM		0xFF5Du
+#define M17_SYNC_PACKET		0x75FFu
+#define M17_SYNC_EOT		0x555Du
+#define M17_PREAMBLE_BYTE	0x77u	// +3 -3 +3 -3: ahead of an LSF, ending opposite its first symbol
+
+#define M17_ADDR_BROADCAST	0xFFFFFFFFFFFFull	// a destination only
+#define M17_ADDR_MAX		0xEE6B27FFFFFFull	// "........." : the last base-40 address
+#define M17_DEST_ALL		"ALL"			// the broadcast address as this firmware shows and stores it
+
+// TYPE (16 bits): bit 0 stream (1) or packet (0), bits 1-2 data type, 3-4 encryption type, 5-6 its subtype (the
+// META type without encryption), 7-10 the channel access number, 11 signed stream, 12-15 reserved
+#define M17_TYPE_STREAM		0x0001u
+#define M17_TYPE_DT(t)		(((t) >> 1) & 3u)
+#define M17_DT_DATA		1u
+#define M17_DT_VOICE		2u	// 3200 bit/s Codec 2
+#define M17_DT_VOICE_DATA	3u	// 1600 bit/s Codec 2 + data
+#define M17_TYPE_ENC(t)		(((t) >> 3) & 3u)
+#define M17_TYPE_CAN(t)		(((t) >> 7) & 15u)
+// Two 3200 bit/s Codec 2 frames of silence: what the encoder makes of silent blocks once settled (m17VoiceTest decodes
+// it). All-zero bits are no silence: they decode at speech level
+#define M17_C2_SILENCE		{ 0x01, 0x00, 0x09, 0x43, 0x9C, 0xE4, 0x21, 0x08, 0x01, 0x00, 0x09, 0x43, 0x9C, 0xE4, 0x21, 0x08 }
+#define M17_TYPE_VOICE(can)	((uint16_t)(M17_TYPE_STREAM | (M17_DT_VOICE << 1) | (((can) & 15u) << 7)))
+#define M17_CAN_MAX		15u
+
+typedef struct {
+	uint64_t dst, src;		// 48-bit addresses
+	uint16_t type;
+	uint8_t meta[14];
+} m17_lsf_t;
+
+// The receive side's scratch (soft values of the coded bits, the decoder's decisions): the caller's, so the
+// provider's task needs no stack for it
+typedef struct {
+	int8_t soft[488];
+	uint16_t dec[244];
+	uint8_t bits[31];
+} m17_work_t;
+
+// CRC-16, polynomial 0x5935, initial value 0xFFFF, MSB first, no final XOR
+uint16_t m17_crc(const uint8_t *p, size_t n);
+
+// Base-40 call sign (up to 9 characters of A-Z 0-9 - / . and space; lower case reads as upper, anything else as a
+// space) to its address, and back. An empty call sign is address 0. The decoder gives "" for 0 and for an address it
+// can't spell (above M17_ADDR_MAX), M17_DEST_ALL for the broadcast address
+uint64_t m17_addr_encode(const char *cs);
+void m17_addr_decode(uint64_t a, char out[M17_CALLSIGN_LEN + 1]);
+// A destination as this firmware takes it: M17_DEST_ALL or empty is the broadcast address
+uint64_t m17_dest_encode(const char *cs);
+
+// The 30 LSF bytes (CRC included) from fields, and back; unpack is false when the CRC does not hold
+void m17_lsf_pack(const m17_lsf_t *l, uint8_t out[M17_LSF_BYTES]);
+bool m17_lsf_unpack(const uint8_t in[M17_LSF_BYTES], m17_lsf_t *l);
+
+// A frame's 192 symbols (packed dibits, air_syms.h) from its contents. stream: lsf is the call's LSF (its LICH chunk
+// cnt goes out, 0-5), fn the frame number (bit 15 marks the last frame)
+void m17_lsf_frame(const uint8_t lsf[M17_LSF_BYTES], uint8_t syms[M17_FRAME_BYTES]);
+void m17_stream_frame(const uint8_t lsf[M17_LSF_BYTES], uint8_t cnt, uint16_t fn,
+		      const uint8_t data[M17_STREAM_BYTES], uint8_t syms[M17_FRAME_BYTES]);
+// The 192 symbols of the EoT marker
+void m17_eot_frame(uint8_t syms[M17_FRAME_BYTES]);
+
+// A received frame (sync burst first): hard dibits, and soft values (AIR_SOFT_OUTER for +3) or NULL. The LSF: its
+// 30 bytes and the bits the Viterbi decoder corrected, -1 when the CRC does not hold
+int m17_lsf_decode(const uint8_t *hard, const int8_t *soft, m17_work_t *w, uint8_t lsf[M17_LSF_BYTES]);
+
+typedef struct {
+	bool lich_ok;			// all four Golay words decoded and LICH_CNT is 0-5
+	uint8_t lich[M17_LICH_BYTES];
+	uint16_t fn;
+	uint8_t data[M17_STREAM_BYTES];
+	int errs;			// bits the Viterbi decoder corrected in the stream contents
+} m17_stream_t;
+void m17_stream_decode(const uint8_t *hard, const int8_t *soft, m17_work_t *w, m17_stream_t *out);
+
+#endif
diff --git a/core/m17/m17_voice.c b/core/m17/m17_voice.c
new file mode 100644
index 0000000..f6bfe6e
--- /dev/null
+++ b/core/m17/m17_voice.c
@@ -0,0 +1,347 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 voice: engine stream contents <-> Codec 2 3200 <-> PCM blocks (m17_voice.h)
+#include "config.h"
+#if CONFIG_M17	// the whole file
+#include "m17_voice.h"
+
+#include <stddef.h>
+#include <string.h>
+
+#include "codec2/codec2.h"
+
+#if (M17_VOICE_QUEUE & (M17_VOICE_QUEUE - 1)) != 0 || (M17_VOICE_TX_QUEUE & (M17_VOICE_TX_QUEUE - 1)) != 0
+#error "the M17 voice queues must be powers of two"
+#endif
+
+#define LOAD(x)		__atomic_load_n(&(x), __ATOMIC_ACQUIRE)
+#define STORE(x, v)	__atomic_store_n(&(x), (v), __ATOMIC_RELEASE)
+
+// ── Codec 2's arena: a bump allocator, emptied by m17VoiceBegin. Codec 2 allocates only in codec2_create ──
+static uint64_t arena[M17_VOICE_ARENA / 8];	// (uint64_t: every block 8-byte aligned)
+static size_t arena_at;
+static m17_voice_stats_t stats;
+
+void *codec2_malloc(size_t size)
+{
+	size = (size + 7u) & ~(size_t)7u;
+	if (size > sizeof(arena) - arena_at) {
+		stats.alloc_fails++;
+		return NULL;
+	}
+	void *p = (uint8_t *)arena + arena_at;
+	arena_at += size;
+	stats.arena_used = (uint32_t)arena_at;
+	return p;
+}
+
+void *codec2_calloc(size_t nmemb, size_t size)
+{
+	void *p = nmemb && size > ((size_t)-1) / nmemb ? NULL : codec2_malloc(nmemb * size);
+
+	if (p)
+		memset(p, 0, nmemb * size);
+	return p;
+}
+
+void codec2_free(void *ptr)
+{
+	(void)ptr;	// the arena is emptied as a whole
+}
+
+static const hal_audio_t *aud;
+static bool active;			// between begin and end (radio task writes, the audio callback reads)
+static struct CODEC2 *c2;		// the audio callback's, made by it in the arena (codec)
+static bool c2_failed;			// ... and it did not fit
+static bool streaming;			// radio task only
+
+// RX queue of Codec 2 frames: producer the provider's task (head), consumer the audio callback (tail)
+static uint8_t rxq[M17_VOICE_QUEUE][M17_C2_BYTES];
+static uint8_t rxq_seq[M17_VOICE_QUEUE];
+static uint8_t rx_head, rx_tail;
+static uint8_t rx_seq, rx_end_seq;	// a start bumps the sequence, an end copies it (provider's task)
+
+// TX: transmissions counted by the radio task (odd while one is on); stream frames from the audio callback (head) to
+// the provider's task (tail)
+static uint8_t tx_gen;
+static uint8_t txq[M17_VOICE_TX_QUEUE][M17_STREAM_BYTES];
+static uint8_t txq_gen[M17_VOICE_TX_QUEUE];
+static uint8_t tx_head, tx_tail;
+static uint16_t mic_gain_q8 = 256;
+
+// Audio callback state
+static uint8_t cb_tx_gen, cb_seq, cb_lead, cb_half;
+static bool cb_live, cb_playing, cb_speaker, cb_mixing;
+static uint8_t cb_pair[M17_STREAM_BYTES];
+static m17_voice_mixer_t mixer;
+
+// ── Hooks (provider's task) ──
+static void rx_start(const m17_call_t *c, void *ctx)
+{
+	(void)c;
+	(void)ctx;
+	STORE(rx_seq, (uint8_t)(rx_seq + 1));
+}
+
+static void rx_voice(const uint8_t data[M17_STREAM_BYTES], void *ctx)
+{
+	(void)ctx;
+	for (unsigned k = 0; k < 2; k++) {
+		uint8_t h = rx_head;
+
+		stats.rx_in++;
+		if ((uint8_t)(h - LOAD(rx_tail)) >= M17_VOICE_QUEUE) {
+			stats.rx_overflows++;
+			continue;
+		}
+		memcpy(rxq[h & (M17_VOICE_QUEUE - 1)], data + k * M17_C2_BYTES, M17_C2_BYTES);
+		rxq_seq[h & (M17_VOICE_QUEUE - 1)] = rx_seq;
+		STORE(rx_head, (uint8_t)(h + 1));
+	}
+}
+
+static void rx_end(void *ctx)
+{
+	(void)ctx;
+	STORE(rx_end_seq, rx_seq);
+}
+
+static bool tx_voice(uint8_t data[M17_STREAM_BYTES], void *ctx)
+{
+	uint8_t g = LOAD(tx_gen), t = tx_tail, h = LOAD(tx_head);
+
+	(void)ctx;
+	while (t != h && txq_gen[t & (M17_VOICE_TX_QUEUE - 1)] != g)
+		t++;	// left over from an earlier transmission
+	if (t == h) {
+		STORE(tx_tail, t);
+		return false;
+	}
+	memcpy(data, txq[t & (M17_VOICE_TX_QUEUE - 1)], M17_STREAM_BYTES);
+	STORE(tx_tail, (uint8_t)(t + 1));
+	stats.tx_frames++;
+	return true;
+}
+
+static const m17_engine_hooks_t hooks = { rx_start, rx_voice, rx_end, tx_voice };
+
+// ── Audio callback ──
+static void speaker(bool on)
+{
+	if (cb_speaker != on) {
+		cb_speaker = on;
+		if (aud != NULL && aud->speaker_pcm != NULL)
+			aud->speaker_pcm(on);
+	}
+}
+
+static void silence(int16_t *spk)
+{
+	memset(spk, 0, AUDIO_BLOCK_SAMPLES * sizeof(int16_t));
+}
+
+static void rx_block(struct CODEC2 *c, int16_t *spk)
+{
+	uint8_t seq = LOAD(rx_seq);
+
+	if (seq != cb_seq) {
+		cb_seq = seq;
+		cb_live = true;
+		cb_playing = cb_speaker = false;
+		cb_lead = 0;
+	}
+	uint8_t t = rx_tail, h = LOAD(rx_head);
+	while (t != h && rxq_seq[t & (M17_VOICE_QUEUE - 1)] != cb_seq)
+		t++;
+	STORE(rx_tail, t);
+	bool ended = LOAD(rx_end_seq) == cb_seq;
+	uint8_t queued = (uint8_t)(h - t);
+
+	if (!cb_live) {
+		silence(spk);
+		return;
+	}
+	if (!cb_playing) {
+		if (queued < M17_VOICE_PRIME && !(ended && queued > 0)) {
+			if (ended)
+				cb_live = false;
+			silence(spk);
+			return;
+		}
+		cb_playing = true;
+		cb_lead = M17_VOICE_LEAD;
+		stats.rx_calls++;
+		speaker(true);
+	}
+	if (cb_lead) {
+		cb_lead--;
+		silence(spk);
+		return;
+	}
+	if (queued == 0) {
+		if (ended) {
+			cb_live = cb_playing = false;
+			speaker(false);
+		} else {
+			stats.rx_underruns++;
+		}
+		silence(spk);
+		return;
+	}
+	codec2_decode(c, spk, rxq[t & (M17_VOICE_QUEUE - 1)]);
+	STORE(rx_tail, (uint8_t)(t + 1));
+	stats.rx_frames++;
+}
+
+static void tx_block(struct CODEC2 *c, uint8_t g, const int16_t *mic)
+{
+	int16_t scaled[AUDIO_BLOCK_SAMPLES];
+	int32_t gain = LOAD(mic_gain_q8);
+
+	for (int i = 0; i < AUDIO_BLOCK_SAMPLES; i++) {
+		int32_t v = (mic[i] * gain) / 256;
+
+		scaled[i] = (int16_t)(v > 32767 ? 32767 : v < -32768 ? -32768 : v);
+	}
+	codec2_encode(c, cb_pair + cb_half * M17_C2_BYTES, scaled);
+	stats.tx_encoded++;
+	cb_half ^= 1;
+	if (cb_half)
+		return;		// the first half of a stream frame
+	uint8_t h = tx_head;
+	if ((uint8_t)(h - LOAD(tx_tail)) >= M17_VOICE_TX_QUEUE) {
+		stats.tx_dropped++;
+		return;
+	}
+	memcpy(txq[h & (M17_VOICE_TX_QUEUE - 1)], cb_pair, M17_STREAM_BYTES);
+	txq_gen[h & (M17_VOICE_TX_QUEUE - 1)] = g;
+	STORE(tx_head, (uint8_t)(h + 1));
+}
+
+// Codec 2 is made here, in the audio task, the first time a block comes: its set-up needs the stack the codec needs,
+// which the radio task does not have
+static struct CODEC2 *codec(void)
+{
+	if (c2 == NULL && !c2_failed) {
+		arena_at = 0;
+		c2 = codec2_create(CODEC2_MODE_3200);
+		if (c2 == NULL || codec2_bits_per_frame(c2) != 8 * M17_C2_BYTES ||
+		    codec2_samples_per_frame(c2) != AUDIO_BLOCK_SAMPLES) {
+			c2 = NULL;
+			c2_failed = true;
+		}
+	}
+	return c2;
+}
+
+void m17VoiceAudioBlock(const int16_t *mic, int16_t *spk, void *ctx)
+{
+	struct CODEC2 *c = LOAD(active) ? codec() : NULL;
+	uint8_t g = LOAD(tx_gen);
+
+	(void)ctx;
+	if (c == NULL) {
+		silence(spk);
+	} else if (g & 1u) {
+		if (g != cb_tx_gen) {
+			cb_tx_gen = g;
+			cb_half = 0;
+			speaker(false);
+		}
+		tx_block(c, g, mic);
+		silence(spk);
+	} else {
+		cb_tx_gen = g;
+		rx_block(c, spk);
+	}
+	m17_voice_mixer_t mix = LOAD(mixer);
+	if (mix != NULL && mix(spk)) {
+		cb_mixing = true;
+		speaker(true);
+	} else if (cb_mixing) {
+		cb_mixing = false;
+		if (!cb_playing)
+			speaker(false);
+	}
+}
+
+// ── Radio task ──
+void m17VoiceInit(const hal_audio_t *audio)
+{
+	aud = audio;
+}
+
+void m17VoiceBegin(void)
+{
+	// The stream is stopped and the engine not started: nothing else touches this state now
+	c2 = NULL;
+	c2_failed = false;
+	rx_head = rx_tail = rx_seq = rx_end_seq = 0;
+	tx_head = tx_tail = tx_gen = cb_tx_gen = 0;
+	cb_seq = 0;
+	cb_half = 0;
+	cb_live = cb_playing = cb_speaker = cb_mixing = false;
+	STORE(active, true);
+}
+
+void m17VoicePoll(void)
+{
+	if (!streaming && aud != NULL && LOAD(active) && LOAD(rx_seq) != 0)
+		streaming = aud->start(m17VoiceAudioBlock, NULL);
+}
+
+void m17VoicePause(void)
+{
+	if (streaming && aud != NULL) {
+		aud->stop();
+		if (aud->speaker_pcm != NULL)
+			aud->speaker_pcm(false);
+	}
+	streaming = false;
+	cb_speaker = false;
+}
+
+void m17VoiceTx(bool on)
+{
+	if (!LOAD(active) || on == ((tx_gen & 1u) != 0))
+		return;
+	STORE(tx_gen, (uint8_t)(tx_gen + 1));
+	if (on && !streaming && aud != NULL)
+		streaming = aud->start(m17VoiceAudioBlock, NULL);
+}
+
+void m17VoiceSetMicGain(uint8_t step)
+{
+	// 2 dB a step around unity at 5, as the other voice paths
+	static const uint16_t q8[11] = { 81, 102, 128, 161, 203, 256, 322, 406, 511, 643, 810 };
+
+	STORE(mic_gain_q8, q8[step > 10 ? 10 : step]);
+}
+
+void m17VoiceEnd(void)
+{
+	m17VoicePause();
+	STORE(active, false);	// the stream is stopped: the codec is made again by the next call
+}
+
+bool m17VoiceStreaming(void)
+{
+	return streaming;
+}
+
+void m17VoiceSetMixer(m17_voice_mixer_t m)
+{
+	STORE(mixer, m);
+}
+
+const m17_engine_hooks_t *m17VoiceHooks(void)
+{
+	return &hooks;
+}
+
+void m17VoiceGetStats(m17_voice_stats_t *out)
+{
+	*out = stats;
+}
+
+#endif	// CONFIG_M17
diff --git a/core/m17/m17_voice.h b/core/m17/m17_voice.h
new file mode 100644
index 0000000..f0e92bb
--- /dev/null
+++ b/core/m17/m17_voice.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 voice between the engine (m17_engine.h, 16 bytes per 40 ms stream frame) and the board's PCM audio
+// (hal_audio_t), through Codec 2 at 3200 bit/s (core/codec2): one 8-byte Codec 2 frame per 20 ms audio block, two per
+// stream frame. The shape of core/p25/p25Voice.c:
+//
+//  RX: the engine's rx_voice hook queues the two frames; the audio block callback decodes one per block. Playback
+//      starts once M17_VOICE_PRIME frames are queued and M17_VOICE_LEAD silent blocks have passed. A block with
+//      nothing queued during a call plays silence.
+//  TX: while a transmission is on (m17VoiceTx) the audio block callback encodes each mic block; two frames make a
+//      stream frame the engine's tx_voice hook takes. With none ready the engine sends silence.
+//
+// Threading as p25Voice.h: begin, poll, tx and end in the radio core's task, the hooks in the provider's task, the
+// codec only in the audio callback; single producer / single consumer queues. No RTOS call.
+//
+// Memory: Codec 2 allocates its state once, at the first audio block, from a static arena here (M17_VOICE_ARENA); nothing
+// is allocated afterwards. Its stack use in the audio callback is far beyond the IMBE codec's (docs/spec/m17.md).
+#ifndef M17_VOICE_H
+#define M17_VOICE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "hal_audio.h"
+#include "m17_engine.h"
+
+#define M17_C2_BYTES		8	// one 3200 bit/s Codec 2 frame (64 bits, 20 ms)
+#define M17_VOICE_QUEUE		16	// frames (320 ms), power of two
+#define M17_VOICE_PRIME		4	// frames queued before playback starts: two stream frames
+#define M17_VOICE_LEAD		1	// blocks of silence after that, the margin for the next stream frame
+#define M17_VOICE_TX_QUEUE	4	// stream frames (two Codec 2 frames each) waiting for the engine, power of two
+#ifndef M17_VOICE_ARENA
+#define M17_VOICE_ARENA		31744	// bytes for Codec 2's state and FFT tables (m17VoiceTest: 30752 on a 64-bit host)
+#endif
+
+typedef struct {
+	uint32_t rx_in;		// Codec 2 frames the engine handed in
+	uint32_t rx_frames;	// decoded and played
+	uint32_t rx_calls;
+	uint32_t rx_underruns;	// blocks with nothing queued during a call
+	uint32_t rx_overflows;	// frames dropped, queue full
+	uint32_t tx_frames;	// stream frames handed to the engine
+	uint32_t tx_encoded;	// mic blocks encoded
+	uint32_t tx_dropped;	// stream frames dropped, queue full
+	uint32_t arena_used;	// bytes of the arena Codec 2 took
+	uint32_t alloc_fails;	// allocations the arena could not give (Codec 2 then is not started)
+} m17_voice_stats_t;
+
+void m17VoiceInit(const hal_audio_t *audio);
+// Start (radio task, before m17_engine_begin). Codec 2 is made in the arena by the audio callback's first block (its
+// set-up needs the codec's stack); one that does not fit leaves the voice silent (m17_voice_stats_t.alloc_fails)
+void m17VoiceBegin(void);
+void m17VoicePoll(void);	// every tick while M17 runs: starts the audio stream once a call is heard
+void m17VoicePause(void);	// stop PCM before the RF provider switches clocks
+void m17VoiceTx(bool on);
+void m17VoiceSetMicGain(uint8_t step);
+void m17VoiceEnd(void);
+bool m17VoiceStreaming(void);
+typedef bool (*m17_voice_mixer_t)(int16_t *spk);
+void m17VoiceSetMixer(m17_voice_mixer_t mixer);
+const m17_engine_hooks_t *m17VoiceHooks(void);
+void m17VoiceGetStats(m17_voice_stats_t *out);
+
+// The audio block callback (exposed for tests): one 20 ms block in, one out
+void m17VoiceAudioBlock(const int16_t *mic, int16_t *spk, void *ctx);
+
+// Codec 2's allocator (core/codec2 is built with malloc, calloc and free mapped to these): the arena
+void *codec2_malloc(size_t size);
+void *codec2_calloc(size_t nmemb, size_t size);
+void codec2_free(void *ptr);
+
+#endif
