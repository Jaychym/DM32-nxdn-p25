diff --git a/tests/host/m17Test.c b/tests/host/m17Test.c
new file mode 100644
index 0000000..4f4db5a
--- /dev/null
+++ b/tests/host/m17Test.c
@@ -0,0 +1,635 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// M17 frames (core/m17/m17_frame.c): the spec's CRC and address vectors, the LSF and stream frames through their FEC
+// with symbol errors, hard and soft.
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+#include "m17/m17_engine.h"
+#include "air/air_softmodem.h"
+#include "air/air_syms.h"
+#include "../../hal/hal_air.h"
+
+static int fails;
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); fails++; } } while (0)
+
+static void crc_vectors(void)
+{
+	uint8_t all[256];
+
+	// CRC Test Vectors
+	CHECK(m17_crc((const uint8_t *)"", 0) == 0xFFFF);
+	CHECK(m17_crc((const uint8_t *)"A", 1) == 0x206E);
+	CHECK(m17_crc((const uint8_t *)"123456789", 9) == 0x772B);
+	for (int i = 0; i < 256; i++)
+		all[i] = (uint8_t)i;
+	CHECK(m17_crc(all, 256) == 0x1C31);
+}
+
+static void addresses(void)
+{
+	char s[M17_CALLSIGN_LEN + 1];
+
+	// Callsign Encoding's example, and the ends of the address space
+	CHECK(m17_addr_encode("AB1CD") == 0x9FDD51u);
+	CHECK(m17_addr_encode("ab1cd") == 0x9FDD51u);
+	CHECK(m17_addr_encode("AB1CD   ") == 0x9FDD51u);
+	CHECK(m17_addr_encode("A") == 1);
+	CHECK(m17_addr_encode(".........") == M17_ADDR_MAX);
+	CHECK(m17_addr_encode("") == 0);
+	m17_addr_decode(0x9FDD51u, s);
+	CHECK(strcmp(s, "AB1CD") == 0);
+	m17_addr_decode(m17_addr_encode("XE1POC/M"), s);
+	CHECK(strcmp(s, "XE1POC/M") == 0);
+	m17_addr_decode(M17_ADDR_MAX, s);
+	CHECK(strcmp(s, ".........") == 0);
+	m17_addr_decode(M17_ADDR_MAX + 1, s);
+	CHECK(s[0] == '\0');
+	m17_addr_decode(M17_ADDR_BROADCAST, s);
+	CHECK(strcmp(s, M17_DEST_ALL) == 0);
+	CHECK(m17_dest_encode("ALL") == M17_ADDR_BROADCAST);
+	CHECK(m17_dest_encode("") == M17_ADDR_BROADCAST);
+	CHECK(m17_dest_encode("M17-M17 C") == m17_addr_encode("M17-M17 C"));
+}
+
+static void make_lsf(uint8_t lsf[M17_LSF_BYTES], uint8_t can)
+{
+	m17_lsf_t l = { .dst = M17_ADDR_BROADCAST, .src = m17_addr_encode("XE1POC"), .type = M17_TYPE_VOICE(can) };
+
+	memcpy(l.meta, "hello meta!!!!", 14);
+	m17_lsf_pack(&l, lsf);
+}
+
+// Soft values of a frame as a clean receiver would give them
+static void to_soft(const uint8_t *syms, int8_t *soft)
+{
+	for (uint16_t i = 0; i < M17_FRAME_SYMS; i++)
+		soft[i] = (int8_t)(air_sym_level(air_sym_get(syms, i)) * AIR_SOFT_OUTER / 3);
+}
+
+// n symbol errors spread over the payload: each symbol moved to a neighbor level (the usual error of 4FSK)
+static void hit(uint8_t *syms, int8_t *soft, unsigned n, unsigned seed)
+{
+	static const uint8_t up[4] = { 1, 1, 0, 2 };	// +1 -> +3, +3 -> +1, -1 -> +1, -3 -> -1
+
+	srand(seed);
+	for (unsigned k = 0; k < n; k++) {
+		uint16_t i = (uint16_t)(M17_SYNC_SYMS + rand() % (M17_FRAME_SYMS - M17_SYNC_SYMS));
+		uint8_t d = up[air_sym_get(syms, i)];
+
+		air_sym_put(syms, i, d);
+		if (soft)
+			soft[i] = (int8_t)(air_sym_level(d) * AIR_SOFT_OUTER / 3);
+	}
+}
+
+static void lsf_frames(void)
+{
+	uint8_t lsf[M17_LSF_BYTES], out[M17_LSF_BYTES], syms[M17_FRAME_BYTES];
+	int8_t soft[M17_FRAME_SYMS];
+	m17_lsf_t l;
+	m17_work_t w;
+
+	make_lsf(lsf, 9);
+	CHECK(m17_lsf_unpack(lsf, &l) && l.type == M17_TYPE_VOICE(9) && M17_TYPE_CAN(l.type) == 9);
+	CHECK(l.dst == M17_ADDR_BROADCAST && l.src == m17_addr_encode("XE1POC"));
+	m17_lsf_frame(lsf, syms);
+	CHECK(syms[0] == 0x55 && syms[1] == 0xF7);
+	CHECK(m17_lsf_decode(syms, NULL, &w, out) == 0 && memcmp(out, lsf, M17_LSF_BYTES) == 0);
+	to_soft(syms, soft);
+	CHECK(m17_lsf_decode(syms, soft, &w, out) == 0 && memcmp(out, lsf, M17_LSF_BYTES) == 0);
+	// Symbol errors: the convolutional code with P1 corrects a few spread ones
+	for (unsigned seed = 1; seed <= 20; seed++) {
+		m17_lsf_frame(lsf, syms);
+		to_soft(syms, soft);
+		hit(syms, soft, 6, seed);
+		int e = m17_lsf_decode(syms, soft, &w, out);
+		CHECK(e > 0 && memcmp(out, lsf, M17_LSF_BYTES) == 0);
+		e = m17_lsf_decode(syms, NULL, &w, out);
+		CHECK(e > 0 && memcmp(out, lsf, M17_LSF_BYTES) == 0);
+	}
+	// A frame of noise fails the CRC
+	for (unsigned k = 2; k < M17_FRAME_BYTES; k++)
+		syms[k] = (uint8_t)(k * 37 + 11);
+	CHECK(m17_lsf_decode(syms, NULL, &w, out) < 0);
+	// One bit of the LSF changed: the CRC says so
+	make_lsf(lsf, 9);
+	lsf[3] ^= 0x10;
+	CHECK(!m17_lsf_unpack(lsf, &l));
+}
+
+static void stream_frames(void)
+{
+	uint8_t lsf[M17_LSF_BYTES], syms[M17_FRAME_BYTES], data[M17_STREAM_BYTES], acc[M17_LSF_BYTES];
+	int8_t soft[M17_FRAME_SYMS];
+	m17_stream_t st;
+	m17_work_t w;
+	unsigned seen = 0;
+
+	make_lsf(lsf, 3);
+	for (uint16_t fn = 0; fn < 12; fn++) {
+		uint8_t cnt = (uint8_t)(fn % 6);
+		uint16_t f = fn == 11 ? (uint16_t)(fn | 0x8000u) : fn;
+
+		for (int i = 0; i < M17_STREAM_BYTES; i++)
+			data[i] = (uint8_t)(fn * 16 + i);
+		m17_stream_frame(lsf, cnt, f, data, syms);
+		CHECK(syms[0] == 0xFF && syms[1] == 0x5D);
+		to_soft(syms, soft);
+		if (fn >= 6)
+			hit(syms, soft, 5, fn);
+		m17_stream_decode(syms, fn & 1 ? NULL : soft, &w, &st);
+		CHECK(st.lich_ok && (st.lich[5] >> 5) == cnt);
+		CHECK(memcmp(st.lich, lsf + 5 * cnt, 5) == 0);
+		CHECK(st.fn == f && memcmp(st.data, data, M17_STREAM_BYTES) == 0);
+		CHECK(fn < 6 ? st.errs == 0 : st.errs > 0);
+		memcpy(acc + 5 * cnt, st.lich, 5);
+		seen |= 1u << cnt;
+	}
+	// The LSF rebuilt from six LICH chunks (late entry)
+	CHECK(seen == 0x3F && memcmp(acc, lsf, M17_LSF_BYTES) == 0);
+	// Noise: the LICH does not decode (all four words and a counter of 0-5 by chance is rare)
+	unsigned ok = 0;
+	for (unsigned seed = 0; seed < 200; seed++) {
+		srand(seed + 1000);
+		for (unsigned k = 2; k < M17_FRAME_BYTES; k++)
+			syms[k] = (uint8_t)rand();
+		m17_stream_decode(syms, NULL, &w, &st);
+		ok += st.lich_ok;
+	}
+	CHECK(ok < 40);
+}
+
+static void eot(void)
+{
+	uint8_t syms[M17_FRAME_BYTES];
+
+	m17_eot_frame(syms);
+	// +3 +3 +3 +3 +3 +3 -3 +3, repeated
+	for (uint16_t i = 0; i < M17_FRAME_SYMS; i++)
+		CHECK(air_sym_level(air_sym_get(syms, i)) == ((i % 8) == 6 ? -3 : 3));
+}
+
+// ── The engine on two made-up providers whose transmit queues feed each other's receivers a 30 ms chunk at a time ──
+#define CHUNK_MAX	144
+#define DEPTH		4
+typedef struct {
+	air_event_cb_t cb;
+	void *ctx;
+	bool open, on, begun_ev, deaf;
+	air_tx_chunk_t q[DEPTH];
+	uint8_t qn;
+	uint32_t underruns, now_us;
+} prov_t;
+static prov_t prov[2];
+static uint32_t rng_state = 0x4D313721u;
+static uint32_t rng(void)
+{
+	rng_state ^= rng_state << 13;
+	rng_state ^= rng_state >> 17;
+	rng_state ^= rng_state << 5;
+	return rng_state;
+}
+
+static void ev(prov_t *p, uint8_t kind, const air_chunk_t *c)
+{
+	air_event_t e = { .kind = kind, .t_us = p->now_us, .chunk = c };
+
+	if (p->cb)
+		p->cb(&e, p->ctx);
+}
+
+static void deliver(prov_t *to, const uint8_t *syms, uint16_t n)
+{
+	int8_t soft[CHUNK_MAX];
+	air_chunk_t c = { .t_us = to->now_us, .nsyms = n, .sync_at = -1, .hard = syms, .soft = soft };
+
+	for (uint16_t i = 0; i < n; i++)
+		soft[i] = (int8_t)(air_sym_level(air_sym_get(syms, i)) * AIR_SOFT_OUTER / 3);
+	if (to->open && !to->on && !to->deaf)
+		ev(to, AIR_EV_RX, &c);
+}
+
+static void step(uint8_t i)
+{
+	prov_t *p = &prov[i], *far = &prov[i ^ 1];
+
+	p->now_us += 30000;
+	if (!p->on) {
+		if (!far->on) {
+			uint8_t noise[CHUNK_MAX / 4];
+
+			for (unsigned k = 0; k < sizeof(noise); k++)
+				noise[k] = (uint8_t)rng();
+			deliver(p, noise, CHUNK_MAX);
+		}
+		return;
+	}
+	if (!p->begun_ev) {
+		p->begun_ev = true;
+		ev(p, AIR_EV_TX_STARTED, NULL);
+	}
+	if (!p->qn) {
+		uint8_t idle[CHUNK_MAX / 4];
+
+		memset(idle, M17_PREAMBLE_BYTE, sizeof(idle));
+		p->underruns++;
+		deliver(far, idle, CHUNK_MAX);
+		ev(p, AIR_EV_TX_UNDERRUN, NULL);
+		return;
+	}
+	air_tx_chunk_t c = p->q[0];
+
+	memmove(p->q, p->q + 1, (size_t)(--p->qn) * sizeof(c));
+	deliver(far, c.syms, c.nsyms);
+	if (c.flags & AIR_TX_LAST) {
+		p->on = false;
+		ev(p, AIR_EV_TX_DONE, NULL);
+	} else {
+		ev(p, AIR_EV_TX_SPACE, NULL);
+	}
+}
+
+static uint32_t p_fit(const air_profile_t *pr)
+{
+	return pr->sym_rate == 4800 ? AIR_FIT_RX | AIR_FIT_TX | AIR_FIT_SOFT : 0;
+}
+static bool p_open(uint8_t i, air_event_cb_t cb, void *ctx)
+{
+	memset(&prov[i], 0, sizeof(prov[i]));
+	prov[i].cb = cb;
+	prov[i].ctx = ctx;
+	prov[i].open = true;
+	return true;
+}
+static void p_close(uint8_t i) { prov[i].open = prov[i].on = false; prov[i].cb = NULL; }
+static bool p_begin(uint8_t i) { if (!prov[i].qn) return false; prov[i].on = true; prov[i].begun_ev = false; return true; }
+static bool p_queue(uint8_t i, const air_tx_chunk_t *c)
+{
+	if (prov[i].qn == DEPTH)
+		return false;
+	prov[i].q[prov[i].qn++] = *c;
+	return true;
+}
+static void p_end(uint8_t i) { if (prov[i].qn) prov[i].q[prov[i].qn - 1].flags |= AIR_TX_LAST; }
+static void p_abort(uint8_t i) { prov[i].qn = 0; prov[i].on = false; ev(&prov[i], AIR_EV_TX_DONE, NULL); }
+
+#define PROVIDER(i) \
+	static bool open##i(const air_profile_t *pr, air_event_cb_t cb, void *ctx) { (void)pr; return p_open(i, cb, ctx); } \
+	static void close##i(void) { p_close(i); } \
+	static void restart##i(void) { } \
+	static bool begin##i(void) { return p_begin(i); } \
+	static bool queue##i(const air_tx_chunk_t *c) { return p_queue(i, c); } \
+	static uint8_t space##i(void) { return (uint8_t)(DEPTH - prov[i].qn); } \
+	static void end##i(void) { p_end(i); } \
+	static void abort##i(void) { p_abort(i); } \
+	static uint32_t now##i(void) { return prov[i].now_us; } \
+	static hal_air_t air##i = { p_fit, open##i, close##i, restart##i, begin##i, queue##i, space##i, end##i, abort##i, \
+				    now##i, NULL, NULL, NULL, NULL, CHUNK_MAX, DEPTH, 60, 100 };
+PROVIDER(0)
+PROVIDER(1)
+
+#define VMAX	200
+typedef struct {
+	m17_engine_t e;
+	unsigned starts, ends;
+	m17_call_t call;
+	uint8_t voice[VMAX][M17_STREAM_BYTES];
+	unsigned nvoice;
+	unsigned made, taken;		// the encoder's frames: made by the test, taken by the engine
+} radio_t;
+static radio_t r[2];
+
+static void h_start(const m17_call_t *c, void *ctx) { radio_t *x = ctx; x->starts++; x->call = *c; }
+static void h_end(void *ctx) { radio_t *x = ctx; x->ends++; }
+static void h_voice(const uint8_t d[M17_STREAM_BYTES], void *ctx)
+{
+	radio_t *x = ctx;
+
+	if (x->nvoice < VMAX)
+		memcpy(x->voice[x->nvoice++], d, M17_STREAM_BYTES);
+}
+static void pattern(unsigned k, uint8_t d[M17_STREAM_BYTES])
+{
+	for (int i = 0; i < M17_STREAM_BYTES; i++)
+		d[i] = (uint8_t)(k * 7 + i + 1);
+}
+static bool h_tx(uint8_t d[M17_STREAM_BYTES], void *ctx)
+{
+	radio_t *x = ctx;
+
+	if (x->taken == x->made)
+		return false;
+	pattern(x->taken++, d);
+	return true;
+}
+static const m17_engine_hooks_t hooks = { h_start, h_voice, h_end, h_tx };
+
+static void begin(uint8_t i, uint8_t rx_can, uint8_t tx_can)
+{
+	m17_engine_cfg_t cfg = { .rx_can = rx_can, .tx_can = tx_can, .src = m17_addr_encode(i ? "N0CALL" : "XE1POC"),
+				 .dst = m17_dest_encode("ALL") };
+
+	memset(&r[i], 0, sizeof(r[i]));
+	CHECK(m17_engine_begin(&r[i].e, i ? &air1 : &air0, &cfg, &hooks, &r[i]));
+}
+
+static void steps(unsigned n)
+{
+	while (n--) {
+		step(0);
+		step(1);
+	}
+}
+
+// Radio 0 sends n stream frames, the encoder making three every four 30 ms steps (one per 40 ms, as the voice path
+// does), deaf_steps the steps radio 1 hears nothing at the start; then the transmission runs to its end
+static void call(unsigned n, unsigned deaf_steps)
+{
+	unsigned t = 0;
+
+	r[0].made = r[0].taken = 0;
+	r[0].made = 2;
+	CHECK(m17_engine_tx_prepare(&r[0].e));
+	CHECK(m17_engine_tx_go(&r[0].e));
+	prov[1].deaf = deaf_steps != 0;
+	while (m17_engine_tx_state(&r[0].e) != AIR_TX_DONE && t < 2000) {
+		if (t == deaf_steps)
+			prov[1].deaf = false;
+		if (r[0].made < n && (t % 4) != 3)
+			r[0].made++;
+		if (r[0].made >= n && r[0].taken >= n)
+			m17_engine_tx_stop(&r[0].e);
+		steps(1);
+		t++;
+	}
+	CHECK(m17_engine_tx_state(&r[0].e) == AIR_TX_DONE);
+	m17_engine_tx_clear(&r[0].e);
+	steps(8);
+}
+
+static void engine(void)
+{
+	m17_engine_view_t v;
+
+	// A call heard whole: the LSF's fields, every frame in order, the end
+	begin(0, M17_CAN_ANY, 3);
+	begin(1, 3, 3);
+	steps(40);		// noise: no call
+	m17_engine_view(&r[1].e, &v);
+	CHECK(v.rx_calls == 0 && r[1].starts == 0);
+	call(40, 0);
+	CHECK(r[1].starts == 1 && r[1].ends == 1);
+	CHECK(r[1].call.have_lsf && !r[1].call.late && strcmp(r[1].call.src, "XE1POC") == 0 &&
+	      strcmp(r[1].call.dst, M17_DEST_ALL) == 0 && M17_TYPE_CAN(r[1].call.type) == 3);
+	CHECK(r[0].taken == 40 && prov[0].underruns == 0);
+	CHECK(r[1].nvoice >= 40);
+	unsigned good = 0;
+	for (unsigned k = 0; k < r[1].nvoice && k < r[0].taken; k++) {
+		uint8_t d[M17_STREAM_BYTES];
+
+		pattern(k, d);
+		good += memcmp(d, r[1].voice[k], M17_STREAM_BYTES) == 0;
+	}
+	CHECK(good == r[0].taken);
+	m17_engine_view(&r[1].e, &v);
+	CHECK(!v.rx_active && v.rx_calls == 1 && v.rx_frames == r[1].nvoice);
+	printf("m17 engine: %u frames sent, %u heard, %u filler\n", r[0].taken, r[1].nvoice, r[0].e.view.tx_filler);
+
+	// Late entry: the receiver comes in after the LSF; the LSF is rebuilt from the LICH and the call plays from there
+	r[1].starts = r[1].ends = r[1].nvoice = 0;
+	call(40, 12);
+	CHECK(r[1].starts == 1 && r[1].ends == 1 && r[1].call.late && strcmp(r[1].call.src, "XE1POC") == 0);
+	CHECK(r[1].nvoice > 10 && r[1].nvoice < 40);
+	unsigned off = r[0].e.tx_fn - r[1].nvoice;	// frames sent, the closing silent one included
+	for (unsigned k = 0; k + off < r[0].taken; k++) {
+		uint8_t d[M17_STREAM_BYTES];
+
+		pattern(k + off, d);
+		CHECK(memcmp(d, r[1].voice[k], M17_STREAM_BYTES) == 0);
+	}
+
+	// Another CAN: heard, not played
+	m17_engine_end(&r[1].e);
+	begin(1, 5, 5);
+	call(20, 0);
+	m17_engine_view(&r[1].e, &v);
+	CHECK(r[1].starts == 0 && r[1].nvoice == 0 && v.rx_calls == 1 && v.rx_rejects == 1);
+	// ... and played once the squelch opens mid-call (digital monitor)
+	m17_engine_cfg_t cfg = r[1].e.cfg;
+	cfg.rx_can = M17_CAN_ANY;
+	r[0].taken = 0;
+	r[0].made = 2;
+	CHECK(m17_engine_tx_prepare(&r[0].e) && m17_engine_tx_go(&r[0].e));
+	steps(10);
+	m17_engine_set(&r[1].e, &cfg);
+	for (unsigned t = 0; t < 200 && m17_engine_tx_state(&r[0].e) != AIR_TX_DONE; t++) {
+		if (r[0].made < 20 && (t % 4) != 3)
+			r[0].made++;
+		if (r[0].made >= 20 && r[0].taken >= 20)
+			m17_engine_tx_stop(&r[0].e);
+		steps(1);
+	}
+	CHECK(r[1].starts == 1 && r[1].nvoice > 0);
+	m17_engine_tx_clear(&r[0].e);
+	steps(8);
+
+	// An encoder that falls behind: silence keeps the air fed, no underrun
+	r[0].taken = r[0].made = 0;
+	prov[0].underruns = 0;
+	CHECK(m17_engine_tx_prepare(&r[0].e) && m17_engine_tx_go(&r[0].e));
+	steps(30);
+	m17_engine_tx_stop(&r[0].e);
+	steps(20);
+	CHECK(m17_engine_tx_state(&r[0].e) == AIR_TX_DONE && prov[0].underruns == 0 && r[0].e.view.tx_filler > 10);
+	m17_engine_tx_clear(&r[0].e);
+
+	// An abort
+	CHECK(m17_engine_tx_prepare(&r[0].e) && m17_engine_tx_go(&r[0].e));
+	steps(3);
+	m17_engine_tx_abort(&r[0].e);
+	CHECK(m17_engine_tx_state(&r[0].e) == AIR_TX_DONE);
+	m17_engine_tx_clear(&r[0].e);
+	m17_engine_end(&r[0].e);
+	m17_engine_end(&r[1].e);
+}
+
+// Viterbi corrections in stream frames of noise: the head hook's limit must sit well below them
+static void noise_errs(void)
+{
+	uint8_t syms[M17_FRAME_BYTES];
+	m17_stream_t st;
+	m17_work_t w;
+	int min = 1000;
+
+	for (unsigned seed = 0; seed < 500; seed++) {
+		for (unsigned k = 0; k < M17_FRAME_BYTES; k++)
+			syms[k] = (uint8_t)rng();
+		m17_stream_decode(syms, NULL, &w, &st);
+		if (st.errs < min)
+			min = st.errs;
+	}
+	printf("m17 noise: fewest Viterbi corrections in 500 frames %d\n", min);
+	CHECK(min > 20);
+}
+
+// ── A call through a modeled discriminator tap and the soft modem (as nxdnEngineTest's channel model): how the
+// HR_C7000 provider receives. The transmit pulse is M17's RRC 0.5, and also RRC 0.2, the pulse the HR_C7000's own
+// transmit filter gives (modem-hrc7000.md 10.3), so a radio of ours heard by another of ours is covered too ──
+#define FS		240000
+#define SPAN		8
+#define LEAD		2000
+#define LPF_HALF	120
+#define SYMS_MAX	(M17_FRAME_SYMS * 30)
+#define WAVE_MAX	(SYMS_MAX * 50 + 2 * LEAD)
+static double wave[WAVE_MAX];
+static uint32_t wave_n;
+static int16_t tap[WAVE_MAX / 30 + 16000];
+static uint32_t tap_n;
+static uint8_t air[SYMS_MAX];
+static uint32_t air_n;
+
+static double gauss(void)
+{
+	double u = (rng() % 1000000 + 1) / 1000001.0, w = (rng() % 1000000) / 1000000.0;
+
+	return sqrt(-2 * log(u)) * cos(2 * M_PI * w);
+}
+
+static void modulate(double alpha, double dev_outer)
+{
+	static double h[2 * SPAN * 50 + 1];
+	int osr = FS / 4800, n = 2 * SPAN * osr + 1;
+	double sum = 0;
+
+	for (int i = 0; i < n; i++) {
+		double x = (double)(i - SPAN * osr) / osr, v;
+
+		if (fabs(x) < 1e-9)
+			v = 1 - alpha + 4 * alpha / M_PI;
+		else if (fabs(fabs(4 * alpha * x) - 1) < 1e-6)
+			v = alpha / sqrt(2) * ((1 + 2 / M_PI) * sin(M_PI / (4 * alpha)) + (1 - 2 / M_PI) * cos(M_PI / (4 * alpha)));
+		else
+			v = (sin(M_PI * x * (1 - alpha)) + 4 * alpha * x * cos(M_PI * x * (1 + alpha))) /
+			    (M_PI * x * (1 - (4 * alpha * x) * (4 * alpha * x)));
+		h[i] = v;
+		sum += v;
+	}
+	for (int i = 0; i < n; i++)
+		h[i] *= osr / sum;
+	wave_n = LEAD + air_n * (uint32_t)osr + LEAD;
+	memset(wave, 0, wave_n * sizeof(double));
+	for (uint32_t k = 0; k < air_n; k++) {
+		long at = LEAD + (long)k * osr - SPAN * osr;
+		double lv = air_sym_level(air[k]) * (dev_outer / 3.0);
+
+		for (int i = 0; i < n; i++)
+			if (at + i >= 0 && at + i < (long)wave_n)
+				wave[at + i] += lv * h[i];
+	}
+}
+
+// wave[] through the tap: a low-pass at hi_hz, 8 kHz, counts_per_khz, an offset, noise of sigma counts
+static void sample_tap(double hi_hz, double counts_per_khz, double off, double sigma)
+{
+	static double lpf[2 * LPF_HALF + 1];
+	uint32_t dec = FS / 8000;
+	double sum = 0;
+
+	for (int i = -LPF_HALF; i <= LPF_HALF; i++) {
+		double x = 2 * M_PI * hi_hz / FS * i, w = 0.54 + 0.46 * cos(M_PI * i / LPF_HALF);
+
+		lpf[i + LPF_HALF] = (i ? sin(x) / x : 1) * w;
+		sum += lpf[i + LPF_HALF];
+	}
+	tap_n = 0;
+	for (unsigned j = 0; j < 8000; j++)	// 1 s without carrier: discriminator noise
+		tap[tap_n++] = (int16_t)lround(off + 5000 * gauss());
+	for (uint32_t j = 7 + LPF_HALF; j + LPF_HALF < wave_n; j += dec) {
+		double v = 0;
+
+		for (int i = -LPF_HALF; i <= LPF_HALF; i++)
+			v += wave[j + (uint32_t)i] * lpf[i + LPF_HALF];
+		v = v / sum / 1000 * counts_per_khz + off + sigma * gauss();
+		tap[tap_n++] = (int16_t)lround(v > 32767 ? 32767 : v < -32768 ? -32768 : v);
+	}
+	for (unsigned j = 0; j < 4000; j++)
+		tap[tap_n++] = (int16_t)lround(off + 5000 * gauss());
+}
+
+static void out_chunk(const air_chunk_t *c, void *ctx)
+{
+	air_framer_rx(ctx, c);
+}
+
+#define SM_FRAMES	25
+static void soft_modem(void)
+{
+	static const double sigmas[] = { 0, 300, 600, 900, 1200, 1500, 1800 };
+	static const double alphas[] = { 0.5, 0.2 };
+	static radio_t rx;
+	uint8_t lsf[M17_LSF_BYTES], syms[M17_FRAME_BYTES], d[M17_STREAM_BYTES];
+	m17_lsf_t l = { .dst = M17_ADDR_BROADCAST, .src = m17_addr_encode("XE1POC"), .type = M17_TYPE_VOICE(0) };
+
+	// The transmission: preamble, LSF, SM_FRAMES stream frames, EoT, as m17_engine.c sends it
+	m17_lsf_pack(&l, lsf);
+	air_n = 0;
+	for (unsigned i = 0; i < M17_FRAME_SYMS; i++)
+		air[air_n++] = (i & 1) ? 3 : 1;
+	m17_lsf_frame(lsf, syms);
+	for (uint16_t i = 0; i < M17_FRAME_SYMS; i++)
+		air[air_n++] = air_sym_get(syms, i);
+	for (unsigned f = 0; f < SM_FRAMES; f++) {
+		pattern(f, d);
+		m17_stream_frame(lsf, (uint8_t)(f % 6), (uint16_t)(f | (f == SM_FRAMES - 1 ? 0x8000u : 0)), d, syms);
+		for (uint16_t i = 0; i < M17_FRAME_SYMS; i++)
+			air[air_n++] = air_sym_get(syms, i);
+	}
+	m17_eot_frame(syms);
+	for (uint16_t i = 0; i < M17_FRAME_SYMS; i++)
+		air[air_n++] = air_sym_get(syms, i);
+	for (unsigned a = 0; a < 2; a++) {
+		// 2400 Hz outer deviation at 2000 counts/kHz: the symbol levels 1600 Hz = 3200 counts apart
+		modulate(alphas[a], 2400);
+		for (unsigned si = 0; si < sizeof(sigmas) / sizeof(sigmas[0]); si++) {
+			air_softmodem_t m;
+			air_framer_t fr;
+			unsigned good = 0;
+
+			sample_tap(3000, 2000, 300, sigmas[si]);
+			memset(&rx, 0, sizeof(rx));
+			rx.e.cfg.rx_can = M17_CAN_ANY;
+			rx.e.hooks = hooks;
+			rx.e.ctx = &rx;
+			air_framer_init(&fr, &m17_air_mode, &rx.e, rx.e.frame, rx.e.soft, M17_FRAME_SYMS);
+			CHECK(air_softmodem_rx_open(&m, &m17_air_mode.profile, 8000, 2000, out_chunk, &fr));
+			for (uint32_t from = 0; from < tap_n; from += 256)
+				air_softmodem_rx(&m, tap + from, (uint16_t)(tap_n - from < 256 ? tap_n - from : 256),
+						 0x10000000u + from * 125u);
+			for (unsigned k = 0; k < rx.nvoice && k < SM_FRAMES; k++) {
+				pattern(k, d);
+				good += memcmp(d, rx.voice[k], M17_STREAM_BYTES) == 0;
+			}
+			printf("m17 soft modem: RRC %.1f, noise %3.0f counts: calls %u (late %d), frames %u/%u in order, ends %u\n",
+			       alphas[a], sigmas[si], rx.starts, rx.call.late, good, SM_FRAMES, rx.ends);
+			if (si < 2)
+				CHECK(rx.starts == 1 && !rx.call.late && good == SM_FRAMES && rx.ends == 1);
+		}
+	}
+}
+
+int main(void)
+{
+	crc_vectors();
+	addresses();
+	lsf_frames();
+	stream_frames();
+	eot();
+	noise_errs();
+	engine();
+	soft_modem();
+	printf("m17Test: %s\n", fails ? "FAILED" : "all passed");
+	return fails != 0;
+}
