+static void crc_recovery(void)
+{
+	const uint16_t masks[] = { T3_CRC_MASK_CSBK, T3_CRC_MASK_MBC_HDR };
+	for (unsigned m = 0; m < 2; m++) {
+		t3_csbk_t aloha = { .lb = true, .op = T3_OP_C_ALOHA };
+		uint8_t original[T3_CSBK_BYTES], copy[T3_CSBK_BYTES];
+		CHECK(t3_csbk_build(&aloha, masks[m], original), "build control burst");
+		for (unsigned bit = 0; bit < sizeof(copy) * 8; bit++) {
+			memcpy(copy, original, sizeof copy);
+			copy[bit / 8] ^= (uint8_t)(1u << (bit % 8));
+			t3_crc_recover(copy, masks[m]);
+			CHECK(!memcmp(copy, original, sizeof copy), "recover bit %u, mask %04x", bit, masks[m]);
+		}
+		copy[3] ^= 0x41;
+		t3_crc_recover(copy, masks[m]);
+		CHECK(!t3_crc_ok(copy, masks[m]), "two flipped bits rejected");
+	}
+}
