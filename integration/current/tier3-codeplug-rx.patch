+// A grant on the TSCC for talkgroup tg, on the carrier's TS2
+static void t3_grant_tg(uint32_t tg)
+{
+	t3_csbk_t g = { .lb = true, .op = T3_OP_TV_GRANT };
+	g.u.grant.lpcn = 1;
+	g.u.grant.slot = 2;
+	g.u.grant.dst = tg;
+	g.u.grant.src = 1000001u;
+	t3_csbk_rx(&g, 1);
+	run(300);
+}
