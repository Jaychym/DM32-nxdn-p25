 	return pdu[10] == (uint8_t)(crc >> 8) && pdu[11] == (uint8_t)crc;
 }
 
+void t3_crc_recover(uint8_t pdu[T3_CSBK_BYTES], uint16_t mask)
+{
+	uint16_t received = (uint16_t)((pdu[10] << 8) | pdu[11]);
+	uint16_t syndrome = dmr_crc_ccitt(pdu, 10) ^ mask ^ received;
+	if (syndrome == 0)
+		return;
+
+	// The last CRC bit contributes 1. Moving toward the first payload bit multiplies its
+	// contribution by x modulo the CCITT polynomial. The 96 single-bit syndromes are distinct.
+	uint16_t contribution = 1;
+	for (unsigned bit = 0; bit < T3_CSBK_BYTES * 8u; bit++) {
+		if (syndrome == contribution) {
+			pdu[T3_CSBK_BYTES - 1u - bit / 8u] ^= (uint8_t)(1u << (bit % 8u));
+			return;
+		}
+		contribution = (uint16_t)((contribution << 1) ^ ((contribution & 0x8000u) ? 0x1021u : 0u));
+	}
+}
