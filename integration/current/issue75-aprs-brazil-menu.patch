diff --git a/tests/host/aprsRadioTest.c b/tests/host/aprsRadioTest.c
index 686b51e..8c3a25b 100644
--- a/tests/host/aprsRadioTest.c
+++ b/tests/host/aprsRadioTest.c
@@ -523,6 +523,22 @@ static void test_beacon_on_air(void)
 	CHECK(wait_start(2, 8000));
 }
 
+static void test_brazil_beacon(void)
+{
+	reset();
+	aprs_set_test_call("Q1TST");
+	configure(0, false);
+	aprs_cfg_t c;
+	aprs_get_cfg(&c);
+	c.region = APRS_REGION_BR;
+	c.freq_hz = 145825000u;  // the saved custom frequency must not override the preset
+	aprs_set_cfg(&c, now);
+	CHECK(aprs_send_now());
+	CHECK(wait_start(1, 8000) && hw.tx_hz == 145570000u);
+	wait_idle();
+	CHECK(!hw.keyed && hw.rx_hz == CH_HZ);
+}
+
 // The test TX limit refuses a beacon whose frequency isn't on its list at key-up (APRS_RF_NO_KEY): nothing keyed, the
 // radio back on the channel. With the APRS frequency on it, the beacon goes
 static void test_tx_limit(void)
@@ -2216,6 +2232,7 @@ int main(void)
 #endif
 	test_defaults();
 	test_beacon_on_air();
+	test_brazil_beacon();
 	test_tx_limit();
 	test_min_interval();
 	test_busy_channel();
