@@ -1094,6 +1094,12 @@ __attribute__((noinline)) bool ui_dual_tick(const radio_view_t *v, uint32_t now)
 	if (!own) {
 		memset(r, 0, sizeof r);
 		uint8_t t = v->state == RS_RX ? tuned_pane(v) : UI_DUAL_NONE;
+#if CONFIG_DMR
+		// Sync and idle repeater traffic have no voice call identity and must not fill call history.
+		if (v->ch.mode == RADIO_MODE_DMR &&
+		    (v->dmr.state != RDMR_RX || (v->dmr.call.src == 0 && v->dmr.call.dst == 0)))
+			t = UI_DUAL_NONE;
+#endif
 		if (t != UI_DUAL_NONE) {
 			ui_dual_rx_t *x = &r[t];
 			x->active = x->heard = true;
