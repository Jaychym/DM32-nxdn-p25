+#if CONFIG_SPLASH_IMAGE
+#define SPLASH_EDGE 64u
+#define SPLASH_RECORD 0x2000u
+
+// This buffer is used only by the UI task (normal startup and preview).
+static uint8_t splash_pixels[SPLASH_EDGE * SPLASH_EDGE / 4u];
+
+static color_t shade(unsigned level)
+{
+	unsigned bg = ui_col.bg, fg = ui_col.fg;
+	unsigned r = ((bg >> 11) * (3 - level) + (fg >> 11) * level + 1) / 3;
+	unsigned g = (((bg >> 5) & 63) * (3 - level) + ((fg >> 5) & 63) * level + 1) / 3;
+	unsigned b = ((bg & 31) * (3 - level) + (fg & 31) * level + 1) / 3;
+	return (color_t)((r << 11) | (g << 5) | b);
+}
+
+static bool draw_user_image(void)
+{
+	if (codeplug_kv_get(SPLASH_RECORD, splash_pixels, sizeof(splash_pixels)) != (int)sizeof(splash_pixels))
+		return false;
+	int w = gfx_width(), h = gfx_height();
+	int edge = w < h ? w : h;
+	int left = (w - edge) / 2, top = (h - edge) / 2;
+	color_t pal[4];
+	for (unsigned i = 0; i < 4; i++)
+		pal[i] = gfx_bpp() == 1 ? (i >= 2 ? ui_col.fg : ui_col.bg) : shade(i);
+	gfx_clear(ui_col.bg);
+	for (int y = 0; y < edge; y++) {
+		unsigned row = (unsigned)y * SPLASH_EDGE / (unsigned)edge;
+		for (int x = 0; x < edge; x++) {
+			unsigned col = (unsigned)x * SPLASH_EDGE / (unsigned)edge;
+			uint8_t packed = splash_pixels[(row * SPLASH_EDGE + col) / 4u];
+			unsigned value = (packed >> (6u - 2u * (col % 4u))) & 3u;
+			if (value != 0)
+				gfx_pixel(left + x, top + y, pal[value]);
+		}
+	}
+	return true;
+}
+#endif
+
+void ui_draw_user_splash(const char *board_name, const char *version, const char *line1, const char *line2)
+{
+#if CONFIG_SPLASH_IMAGE
+	if (draw_user_image())
+		return;
+#endif
+	ui_draw_splash(board_name, version, line1, line2);
+}
