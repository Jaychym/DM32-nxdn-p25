+		assert.deepEqual(decode(f.image).channels.map((c) => c.rxOnly), [true, true, true, false]);
+		assert.deepEqual(f.notes.find((n) => n.code === "stock_aes_rx_only"), { code: "stock_aes_rx_only", n: 3 });
