+
+static void replay_publish(radio_sm_t *sm)
+{
+	uint8_t flags = ambeVoiceReplayFlags();
+	bool enabled = (flags & AMBE_REPLAY_ENABLED) != 0, ready = (flags & AMBE_REPLAY_READY) != 0;
+	bool playing = (flags & AMBE_REPLAY_PLAYING) != 0;
+	if (sm->view.dmr.replay_enabled != enabled || sm->view.dmr.replay_ready != ready ||
+	    sm->view.dmr.replay_playing != playing) {
+		sm->view.dmr.replay_enabled = enabled;
+		sm->view.dmr.replay_ready = ready;
+		sm->view.dmr.replay_playing = playing;
+		changed(sm);
+	}
