+		ambeVoiceReplayEnable(cmd == RADIO_DMR_REPLAY_ON && sm->codec);
+	} else if (cmd == RADIO_DMR_REPLAY_PLAY) {
+		if (ambeVoiceReplayFlags() & AMBE_REPLAY_PLAYING) {
