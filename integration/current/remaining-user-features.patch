+	case UI_SET_DIGITAL_RX_TRIM: {
+		if (value < -DIGITAL_RX_TRIM_DB * DIGITAL_RX_TRIM_MAX || value > 0 || value % DIGITAL_RX_TRIM_DB != 0)
+			return false;
+		uint8_t step = (uint8_t)(value / -DIGITAL_RX_TRIM_DB);
+		st = settings_begin();
+		st->digital_rx_trim = step;
+		settings_end(hal_millis());
+		digital_rx_trim_set(step);
+		return true;
+	}
+#endif
 	case UI_SET_VOLUME:
 		st = settings_begin();
 		st->volume = radio_volume_stored((uint8_t)clamp16(value, 0, RADIO_VOLUME_MAX));
