diff --git a/core/ui/ui_pin.c b/core/ui/ui_pin.c
new file mode 100644
index 0000000..e01b8e0
--- /dev/null
+++ b/core/ui/ui_pin.c
@@ -0,0 +1,284 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// Copyright (c) 2026 lyra XE1POC (changes)
+#include "config.h"
+#if CONFIG_STARTUP_PIN
+#include "board.h"
+#include "hal_time.h"
+#include "input/input_engine.h"
+#include "settings/settings_pin.h"
+#include "ui_pin.h"
+#include "ui_svc.h"
+
+#define PIN_MAX_TRIES 3u
+#define PIN_RETRY_MS 20000u
+
+typedef enum { PIN_OLD, PIN_NEW, PIN_CONFIRM } pin_step_t;
+typedef struct {
+	uint32_t value;
+	uint8_t digits;
+} pin_input_t;
+static struct {
+	pin_input_t input;
+	pin_step_t step;
+	uint32_t next_pin;
+	uint32_t deadline;
+	uint8_t attempts;
+	ui_pin_mode_t mode;
+	bool opening_programming;
+} menu;
+
+static void pin_draw(const char *title, const pin_input_t *in, const char *status)
+{
+	const font_t *f = ui_layout.medium;
+	int w = gfx_width(), h = gfx_height();
+	char mask[SETTINGS_PIN_DIGITS + 1];
+	for (unsigned i = 0; i < SETTINGS_PIN_DIGITS; i++)
+		mask[i] = i < in->digits ? '*' : '_';
+	mask[SETTINGS_PIN_DIGITS] = 0;
+	gfx_clear(ui_col.bg);
+	ui_draw_title(f, 0, h / 5, w, NULL, title, ui_col.fg);
+	gfx_text(f, (w - gfx_text_width(f, mask)) / 2, h / 2, mask, ui_col.fg);
+	ui_draw_title(ui_layout.small, 0, h - ui_layout.small->h - 3, w, NULL, status, ui_col.dim);
+}
+
+static bool pin_digit(pin_input_t *in, uint8_t action)
+{
+	if (action >= ACT_DIGIT_0 && action <= ACT_DIGIT_9) {
+		if (in->digits < SETTINGS_PIN_DIGITS) {
+			in->value = in->value * 10u + (action - ACT_DIGIT_0);
+			in->digits++;
+		}
+		return true;
+	}
+	if (action == ACT_BACK && in->digits != 0) {
+		in->value /= 10u;
+		in->digits--;
+		return true;
+	}
+	return false;
+}
+
+static bool wait_active(uint32_t now, uint32_t deadline)
+{
+	return deadline != 0 && (int32_t)(now - deadline) < 0;
+}
+
+static uint32_t delay_tries(uint8_t *attempts, uint32_t now)
+{
+	if (++*attempts < PIN_MAX_TRIES)
+		return 0;
+	*attempts = 0;
+	return (now + PIN_RETRY_MS) | 1u;
+}
+
+static bool keypad_available(void)
+{
+	uint16_t digits = 0;
+	bool have_ok = false, have_back = false;
+	for (unsigned i = 0; i < board.keymap_len; i++) {
+		uint8_t action = board.keymap[i].short_action;
+		if (action >= ACT_DIGIT_0 && action <= ACT_DIGIT_9)
+			digits |= (uint16_t)(1u << (action - ACT_DIGIT_0));
+		have_ok |= action == ACT_SELECT;
+		have_back |= action == ACT_BACK;
+	}
+	return digits == 0x3ffu && have_ok && have_back && board.display->width >= 96;
+}
+
+static uint8_t boot_action(uint32_t keys)
+{
+	if (keys == 0 || (keys & (keys - 1u)) != 0)
+		return ACT_NONE;
+	for (unsigned i = 0; i < board.keymap_len; i++) {
+		if (keys == (1u << board.keymap[i].bit))
+			return board.keymap[i].short_action;
+	}
+	return ACT_NONE;
+}
+
+void ui_pin_startup(void)
+{
+	settings_pin_boot();
+	if (!settings_pin_enabled())
+		return;
+	bool display = gfx_init(board.display);
+#if CONFIG_UI_COLOR
+	ui_theme_set((uint8_t)ui_svc_setting_get(UI_SET_THEME));
+	ui_accent_set((uint8_t)ui_svc_setting_get(UI_SET_ACCENT));
+#endif
+	if (!lang_set(lang_find(ui_svc_setting_get(UI_SET_LANGUAGE))))
+		lang_set(LANG_ENGLISH);
+	ui_layout_init();
+
+	pin_input_t in = { 0 };
+	uint8_t attempts = 0;
+	uint32_t retry = 0, stable = board.input->scan(), previous = stable;
+	bool redraw = true, invalid = false, was_waiting = false;
+	for (;;) {
+		if (!board.power->switch_on()) {
+			board.display->set_backlight(0);
+			board.power->latch(false);
+			while (!board.power->switch_on())
+				hal_delay_ms(100);
+			board.power->latch(true);
+			board.display->set_backlight(100);
+			in = (pin_input_t){ 0 };
+			redraw = true;
+		}
+		uint32_t now = hal_millis();
+		bool waiting = wait_active(now, retry);
+		uint32_t raw = board.input->scan();
+		if (raw == previous && raw != stable) {
+			uint8_t action = stable == 0 ? boot_action(raw) : ACT_NONE;
+			stable = raw;
+			if (!waiting && pin_digit(&in, action)) {
+				invalid = false;
+				redraw = true;
+			} else if (!waiting && action == ACT_SELECT && in.digits == SETTINGS_PIN_DIGITS) {
+				bool unlock = settings_pin_matches(in.value);
+				in = (pin_input_t){ 0 };
+				if (unlock)
+					return;
+				retry = delay_tries(&attempts, now);
+				invalid = true;
+				redraw = true;
+			}
+		}
+		previous = raw;
+		if (display && (redraw || waiting != was_waiting)) {
+			gfx_frame_begin();
+			pin_draw(TR(PIN_ENTER_STARTUP, "Enter startup PIN"), &in, wait_active(now, retry) ?
+				TR(PIN_RETRY_LATER, "Wait before retrying") : invalid ? TR(PIN_WRONG, "Incorrect PIN") :
+				TR(PIN_DIGIT_HINT, "6 digits then OK"));
+			gfx_flush();
+		}
+		redraw = false;
+		was_waiting = waiting;
+		hal_delay_ms(INPUT_SCAN_MS);
+	}
+}
+
+void ui_pin_menu(ui_pin_mode_t mode)
+{
+	if (ui_key_is_injected())
+		return;
+	bool configured = settings_pin_enabled();
+	if (!settings_pin_can_store() || !keypad_available()) {
+		ui_toast(TR(PIN_UNAVAILABLE, "PIN setup unavailable"));
+		return;
+	}
+	if (mode != UI_PIN_CHANGE && !configured) {
+		ui_toast(TR(PIN_NOT_SET, "Startup PIN is off"));
+		return;
+	}
+	if (mode == UI_PIN_PROGRAMMING_ACCESS) {
+		if (!settings_programming_protected()) {
+			ui_toast(TR(PIN_CPS_PROTECTION_OFF, "Programming lock is off"));
+			return;
+		}
+	}
+	menu.mode = mode;
+	menu.opening_programming = !settings_programming_allowed();
+	menu.step = configured ? PIN_OLD : PIN_NEW;
+	menu.input = (pin_input_t){ 0 };
+	menu.next_pin = 0;
+	ui_push(SCR_PIN, 0);
+	settings_pin_prompt(true);
+}
+
+static void menu_draw(void)
+{
+	const char *title = menu.step == PIN_NEW ? TR(PIN_ENTER_NEW, "Enter new startup PIN") :
+		menu.step == PIN_CONFIRM ? TR(PIN_ENTER_AGAIN, "Repeat new PIN") :
+		menu.mode == UI_PIN_PROGRAMMING_ACCESS ? (!menu.opening_programming ?
+			TR(PIN_CPS_RELOCK, "PIN to relock programming") : TR(PIN_CPS_ENTER, "PIN for programming")) :
+		menu.mode == UI_PIN_PROGRAMMING_SETUP ? (settings_programming_protected() ?
+			TR(PIN_CPS_DISABLE, "PIN to remove lock") : TR(PIN_CPS_ENABLE, "PIN to lock programming")) :
+		TR(PIN_ENTER_CURRENT, "Enter current PIN");
+	const char *status = wait_active(hal_millis(), menu.deadline) ?
+		TR(PIN_RETRY_LATER, "Wait before retrying") : TR(PIN_DIGIT_HINT, "6 digits then OK");
+	pin_draw(title, &menu.input, status);
+	ui_draw_banner(&ui_st);
+}
+
+static void menu_leave(void)
+{
+	menu.input = (pin_input_t){ 0 };
+	menu.next_pin = 0;
+	settings_pin_prompt(false);
+}
+
+static bool menu_key(const input_event_t *ev)
+{
+	if (ev->gesture != GESTURE_PRESS)
+		return false;
+	if (wait_active(hal_millis(), menu.deadline))
+		return ev->action != ACT_BACK;
+	if (pin_digit(&menu.input, ev->action))
+		return true;
+	if (ev->action != ACT_SELECT)
+		return false;
+	if (menu.input.digits != SETTINGS_PIN_DIGITS) {
+		ui_toast(TR(PIN_DIGIT_HINT, "6 digits then OK"));
+		return true;
+	}
+	uint32_t pin = menu.input.value;
+	menu.input = (pin_input_t){ 0 };
+	switch (menu.step) {
+	case PIN_OLD:
+		if (!settings_pin_matches(pin)) {
+			menu.deadline = delay_tries(&menu.attempts, hal_millis());
+			ui_toast(TR(PIN_WRONG, "Incorrect PIN"));
+			break;
+		}
+		menu.attempts = 0;
+		switch (menu.mode) {
+		case UI_PIN_REMOVE:
+			settings_pin_clear();
+			ui_pop();
+			ui_toast(TR(PIN_NOT_SET, "Startup PIN is off"));
+			break;
+		case UI_PIN_PROGRAMMING_SETUP: {
+			bool on = !settings_programming_protected();
+			settings_programming_protect(on);
+			ui_pop();
+			ui_toast(on ? TR(PIN_CPS_LOCKED, "Programming locked") :
+				 TR(PIN_CPS_PROTECTION_OFF, "Programming lock is off"));
+			break;
+		}
+		case UI_PIN_PROGRAMMING_ACCESS: {
+			bool open = menu.opening_programming;
+			settings_programming_grant(open);
+			ui_pop();
+			ui_toast(open ? TR(PIN_CPS_UNLOCKED, "Programming unlocked") : TR(PIN_CPS_LOCKED, "Programming locked"));
+			break;
+		}
+		case UI_PIN_CHANGE:
+			menu.step = PIN_NEW;
+			break;
+		}
+		break;
+	case PIN_NEW:
+		menu.next_pin = pin;
+		menu.step = PIN_CONFIRM;
+		break;
+	case PIN_CONFIRM:
+		if (pin != menu.next_pin) {
+			menu.next_pin = 0;
+			menu.step = PIN_NEW;
+			ui_toast(TR(PIN_MISMATCH, "PINs do not match"));
+			break;
+		}
+		settings_pin_set(pin, hal_micros());
+		ui_pop();
+		ui_toast(TR(PIN_SET, "Startup PIN is on"));
+		break;
+	}
+	return true;
+}
+
+const ui_scr_def_t ui_pin_screen = {
+	.name = "local-pin", .flags = SF_NO_STRIP, .draw = menu_draw, .key = menu_key, .leave = menu_leave,
+};
+#endif
