+	for (const e of add) {
+		while (used.has(slot)) slot++;
+		if (slot >= KEY_BASE + KEY_MAX) return { code: "radio_area" };
+		merged.push({ ...e, key: slot++ });
+	}
+	putArea(staged, merged);
+	file.set(staged.subarray(KV_ADDR), KV_ADDR);
