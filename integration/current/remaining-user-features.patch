diff --git a/core/radio/digital_rx_trim.c b/core/radio/digital_rx_trim.c
new file mode 100644
index 0000000..0484dfe
--- /dev/null
+++ b/core/radio/digital_rx_trim.c
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// Copyright (c) 2026 lyra XE1POC (changes)
+#include "radio/digital_rx_trim.h"
+
+#if CONFIG_DIGITAL_RX_TRIM
+#include "hal_audio.h"
+
+static uint8_t attenuation;
+
+void digital_rx_trim_set(uint8_t step)
+{
+	__atomic_store_n(&attenuation, digital_rx_trim_step(step), __ATOMIC_RELAXED);
+}
+
+void digital_rx_trim_apply(int16_t *speaker)
+{
+	uint8_t step = __atomic_load_n(&attenuation, __ATOMIC_RELAXED);
+	if (step == 0)
+		return;
+
+	// Each step halves the amplitude. Divide the magnitude so both signs round toward zero.
+	for (unsigned i = 0; i < AUDIO_BLOCK_SAMPLES; i++) {
+		int32_t sample = speaker[i];
+		int32_t magnitude = sample < 0 ? -sample : sample;
+		int32_t scaled = magnitude >> step;
+		speaker[i] = (int16_t)(sample < 0 ? -scaled : scaled);
+	}
+}
+#endif
