diff --git a/core/settings/settings_pin.c b/core/settings/settings_pin.c
new file mode 100644
index 0000000..eb1fccc
--- /dev/null
+++ b/core/settings/settings_pin.c
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// Copyright (c) 2026 lyra XE1POC (changes)
+#include "config.h"
+#if CONFIG_STARTUP_PIN
+#include <string.h>
+#include "crypto/aes256.h"
+#include "hal_time.h"
+#include "settings.h"
+#include "settings_pin.h"
+
+// Single radio CPU. Only startup and the local UI change these flags; host protocols only read them.
+static volatile bool cps_protected, cps_granted, credential_prompt;
+
+static void pin_verifier(uint32_t pin, uint32_t salt, uint8_t out[8])
+{
+	uint8_t key[AES128_KEY_BYTES] = {
+		(uint8_t)pin, (uint8_t)(pin >> 8), (uint8_t)(pin >> 16),
+	};
+	uint8_t domain[AES_BLOCK_BYTES] = {
+		'R', 'F', ' ', 'l', 'o', 'c', 'a', 'l', ' ', 'P', 'I', 'N',
+		(uint8_t)salt, (uint8_t)(salt >> 8), (uint8_t)(salt >> 16), (uint8_t)(salt >> 24),
+	};
+	aes128_encrypt_block(key, domain, domain);
+	memcpy(out, domain, 8);
+}
+
+bool settings_pin_enabled(void)
+{
+	const settings_t *s = settings_begin();
+	bool configured = s->pin_salt != 0;
+	settings_end(hal_millis());
+	return configured;
+}
+
+bool settings_pin_matches(uint32_t pin)
+{
+	if (pin >= SETTINGS_PIN_LIMIT)
+		return false;
+	uint8_t saved[8], check[8];
+	const settings_t *s = settings_begin();
+	uint32_t salt = s->pin_salt;
+	memcpy(saved, s->pin_verifier, sizeof saved);
+	settings_end(hal_millis());
+	if (salt == 0)
+		return false;
+	pin_verifier(pin, salt, check);
+	uint8_t different = 0;
+	for (unsigned i = 0; i < sizeof check; i++)
+		different |= check[i] ^ saved[i];
+	return different == 0;
+}
+
+void settings_pin_set(uint32_t pin, uint32_t salt)
+{
+	if (pin >= SETTINGS_PIN_LIMIT)
+		return;
+	if (salt == 0)
+		salt = 1;
+	uint8_t check[8];
+	pin_verifier(pin, salt, check);
+	settings_t *s = settings_begin();
+	s->pin_salt = salt;
+	memcpy(s->pin_verifier, check, sizeof check);
+	settings_end(hal_millis());
+	cps_granted = false;
+}
+
+void settings_pin_clear(void)
+{
+	settings_t *s = settings_begin();
+	s->pin_salt = 0;
+	s->pin_protect_programming = 0;
+	memset(s->pin_verifier, 0, sizeof s->pin_verifier);
+	settings_end(hal_millis());
+	cps_protected = cps_granted = false;
+}
+
+bool settings_pin_can_store(void)
+{
+	settings_stats_t st;
+	settings_get_stats(&st);
+	return st.load != SETTINGS_RAM && st.load != SETTINGS_FOREIGN;
+}
+
+void settings_pin_boot(void)
+{
+	const settings_t *s = settings_begin();
+	cps_protected = s->pin_salt != 0 && s->pin_protect_programming == 1;
+	cps_granted = credential_prompt = false;
+	settings_end(hal_millis());
+}
+
+bool settings_programming_protected(void) { return cps_protected; }
+bool settings_programming_allowed(void) { return !credential_prompt && (!cps_protected || cps_granted); }
+void settings_pin_prompt(bool on) { credential_prompt = on; }
+
+void settings_programming_protect(bool on)
+{
+	settings_t *s = settings_begin();
+	bool protect = on && s->pin_salt != 0;
+	s->pin_protect_programming = protect;
+	settings_end(hal_millis());
+	cps_granted = false;
+	cps_protected = protect;
+}
+
+void settings_programming_grant(bool on) { cps_granted = on; }
+#endif
