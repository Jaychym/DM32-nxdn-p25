+#if CONFIG_DMR_REPLAY
+// The call task is the only reader and writer of the recording. The audio task receives replay via the usual queue.
+static struct {
+	uint8_t *storage;
+	const dmr_caller_t *caller;
+	uint16_t frames, next;
+	bool enabled, ready, playing, good;
+} replay;
+
+static void replay_clear(void)
+{
+	if (replay.storage != NULL)
+		memset(replay.storage, 0, AMBE_REPLAY_BYTES);
+	replay.caller = NULL;
+	replay.frames = 0;
+	replay.ready = replay.good = false;
+}
+
+void ambeVoiceReplayInit(uint8_t storage[AMBE_REPLAY_BYTES])
+{
+	memset(&replay, 0, sizeof replay);
+	replay.storage = storage;
+	replay_clear();	// the AHB SRAM can survive a warm reset
+}
+
+void ambeVoiceReplayCancel(void)
+{
+	if (replay.playing) {
+		replay.playing = false;
+		uint8_t next = (uint8_t)(rx_seq + 1u);
+		STORE(rx_end_seq, next);
+		STORE(rx_seq, next);	// the audio task discards queued replay frames from the old sequence
+		if (streaming && aud != NULL) {
+			aud->stop();
+			if (aud->speaker_pcm != NULL)
+				aud->speaker_pcm(false);
+			streaming = false;
+		}
+		STORE(rx_head, LOAD(rx_tail));
+	}
+}
+
+void ambeVoiceReplayRetune(void)
+{
+	ambeVoiceReplayCancel();
+	if (replay.caller != NULL)
+		replay_clear();
+}
+
+void ambeVoiceReplayEnable(bool on)
+{
+	if (!on) {
+		ambeVoiceReplayCancel();
+		replay_clear();
+	}
+	replay.enabled = on && replay.storage != NULL;
+}
+
+uint8_t ambeVoiceReplayFlags(void)
+{
+	return (replay.enabled ? AMBE_REPLAY_ENABLED : 0u) | (replay.ready ? AMBE_REPLAY_READY : 0u) |
+	       (replay.playing ? AMBE_REPLAY_PLAYING : 0u);
+}
+
+static bool voc_ok(void);
+
+static bool replay_clear_group(const dmr_caller_t *c)
+{
+	return c != NULL && c->src != 0 && c->group && !c->encrypted && !c->pi_header && !c->late_entry;
+}
+
+static void replay_record(const uint8_t *bits)
+{
+	if (replay.caller == NULL)
+		return;
+	if (!replay_clear_group(replay.caller)) {
+		replay_clear();	// a PI or privacy announcement can arrive after the header
+		return;
+	}
+	if (replay.frames == AMBE_REPLAY_FRAMES)
+		return;
+	uint8_t *frame = replay.storage + (size_t)replay.frames++ * 7u;
+	memset(frame, 0, 7u);
+	if (bits == NULL) {
+		frame[6] = 0x80u;
+		return;
+	}
+	for (unsigned bit = 0; bit < VOCODER_BITS; bit++)
+		frame[bit / 8u] |= (uint8_t)((bits[bit] & 1u) << (bit % 8u));
+	replay.good = true;
+}
+
+static void replay_done(void)
+{
+	if (!replay_clear_group(replay.caller) || !replay.good) {
+		replay_clear();
+		return;
+	}
+	replay.caller = NULL;
+	replay.ready = true;
+}
+#endif
