diff --git a/site/tests/channel-aes.test.mjs b/site/tests/channel-aes.test.mjs
index 8f1dc74..3ecd5f1 100644
--- a/site/tests/channel-aes.test.mjs
+++ b/site/tests/channel-aes.test.mjs
@@ -69,3 +69,40 @@ test("DMR Basic, Enhanced and Off persist independently, and exports redact keys
 	assert.deepEqual(after.keyring, []);
 	assert.equal(decode(image).channels[0].dmrPrivacyKey, 179);
 });
+
+test("DMR AES-128 and AES-256 can use the same ID independently", () => {
+	const m = empty();
+	m.channels.push(newChannel({ name: "AES128", mode: "dmr", rxHz: 433000000, txHz: 433000000 }));
+	const [ch] = m.channels;
+	m.keyring = [
+		{ alg: 0x24, id: 98, key: "64EE897F9A16607DA56344041D0B716C" },
+		{ alg: 0x25, id: 98, key: "AB".repeat(32) },
+		{ alg: 0x25, id: 7, key: "CD".repeat(32) },
+	];
+	const fields = channelForm(m, (s) => s);
+	const privacy = fields.find((f) => f.key === "dmrPrivacy");
+	privacy.set(ch, DMR_PRIV.aes128);
+	const key = fields.find((f) => f.key === "dmrPrivacyKey");
+	assert.deepEqual(key.options(ch).map(([id]) => id), [null, 98]);
+	key.set(ch, 98);
+	assert.equal(validKeyHex(0x24, m.keyring[0].key), true);
+	assert.equal(validKeyHex(0x24, m.keyring[1].key), false);
+	assert.equal(validKeyHex(0x25, m.keyring[0].key), false);
+	const image = encode(m);
+	const restored = decode(image);
+	assert.equal(restored.channels[0].dmrPrivacy, DMR_PRIV.aes128);
+	assert.equal(restored.channels[0].dmrPrivacyKey, 98);
+	assert.equal(restored.channels[0].rxOnly, false);
+	const offset = channelAddr(ch.number);
+	assert.equal(image.bytes[offset + 0x33] & 0x04, 0x04); // an older build sees an RX-only base record
+	assert.deepEqual(Array.from(image.bytes.subarray(offset + 0x34, offset + 0x37)), [0xAA, 0x5A, 98]);
+	ch.rxOnly = true;
+	const receiveOnly = encode(m);
+	assert.equal(decode(receiveOnly).channels[0].rxOnly, true);
+	assert.deepEqual(Array.from(receiveOnly.bytes.subarray(offset + 0x34, offset + 0x37)), [0xA9, 0x5A, 98]);
+	assert.deepEqual(restored.keyring.map((k) => [k.alg, k.id, k.key.length]), [[0x24, 98, 32], [0x25, 98, 64], [0x25, 7, 64]]);
+	const exported = image.clone();
+	withoutSecrets(exported.bytes);
+	assert.deepEqual(decode(exported).keyring, []);
+	assert.equal(decode(exported).channels[0].dmrPrivacy, DMR_PRIV.aes128);
+});
