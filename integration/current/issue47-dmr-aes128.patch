+void aes128_encrypt_block(const uint8_t key[AES128_KEY_BYTES], const uint8_t in[AES_BLOCK_BYTES],
+			  uint8_t out[AES_BLOCK_BYTES])
+{
+	uint8_t k[AES128_KEY_BYTES], s[AES_BLOCK_BYTES], rcon = 1;
+
+	memcpy(k, key, sizeof k);
+	memcpy(s, in, sizeof s);
