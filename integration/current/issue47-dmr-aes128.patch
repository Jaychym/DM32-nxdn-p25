+static void test_aes128(void)
+{
+	uint8_t key[AES128_KEY_BYTES], pi[DMR_AES_PI_BYTES], expected[DMR_AES_SF_BYTES], kid;
+	uint32_t mi;
+	dmr_aes_t voice;
+
+	// Stock header and throwaway key from issue #47. Generate the expected 126 octets independently
+	// with OpenSSL AES-128-OFB and the published IV F51D27016CDAEE2EDF35C7180D8CE988, dropping 16 octets.
+	unhex("64EE897F9A16607DA56344041D0B716C", key, sizeof key);
+	dmrVoiceCipherPiBuild(DMR_AES128_ALG, 98, 0xF51D2701u, 1337, pi);
+	const uint8_t stock_pi[] = { 0x24, 0x10, 0x62, 0xF5, 0x1D, 0x27, 0x01, 0, 0x05, 0x39 };
+	assert(!memcmp(pi, stock_pi, sizeof pi));
+	assert(dmrVoiceCipherPiParse(pi, DMR_AES128_ALG, &kid, &mi) && kid == 98 && mi == 0xF51D2701u);
+	pi[0] = 0x04;
+	assert(dmrVoiceCipherPiParse(pi, DMR_AES128_ALG, &kid, &mi));
+	assert(!dmrVoiceCipherPiParse(pi, DMR_AES_ALG, &kid, &mi));
+	assert(dmrVoiceCipherKeyBytes(DMR_AES128_ALG) == sizeof key);
+	assert(dmrVoiceCipherNextMi(DMR_AES128_ALG, mi) == 0x6CDAEE2Eu);
+	unhex("35cf8f02c8c6fdb9d96b65771d1e54aeb77227a6320a8e6d504c553595a6571c"
+	      "ce9bfd7107d2c2fb6177be75f52878fa45cc6e324c97d6d841ec2b01fd997b1a"
+	      "350a4f8b14e062a7e392aaaccf769a5886d7ca35f0295dba22c1bdbd9bc2983c7"
+	      "d413d4083fb6d307c9dd1e8f3edf438fe5229661bf0c58b34edf1921843", expected, sizeof expected);
+	dmrVoiceCipherStart(&voice, DMR_AES128_ALG, key, mi);
+	assert(voice.ready && !memcmp(voice.ks, expected, sizeof expected));
+	puts("dmrAesTest: stock AES-128 PI parameters and independent OFB keystream passed");
+}
+
 int main(void)
 {
+	test_aes128();
 	test_arc4_capture();
