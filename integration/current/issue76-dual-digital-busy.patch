+#if CONFIG_DMR || CONFIG_AIR
+// A DMR, P25, NXDN or YSF carrier by its signal strength at the squelch level (the default level when the squelch is open):
+// the board's digital mode, whose noise reading may not follow the signal (gotchas 17.3)
+static bool dmr_strength_heard(const radio_sm_t *sm, int16_t rssi_dbm)
+{
+	uint8_t sq = sm->view.squelch != 0 ? sm->view.squelch : RADIO_SQUELCH_DEFAULT;
+	if (sq > RADIO_SQUELCH_MAX) {
+		sq = RADIO_SQUELCH_MAX;
+	}
+	int16_t above = (int16_t)((sq - 1) * RADIO_SQL_DB_PER_STEP), floor_dbm;
+	if (scan_floor(&sm->scan, &floor_dbm) && rssi_dbm <= floor_dbm + RADIO_DMR_SQL_L1_FLOOR_DB + above) {
+		return false;
+	}
+	return rssi_dbm > RADIO_DMR_SQL_L1_DBM + above;
+}
+#endif
+
+// The signal strength also counts on digital modes, whose noise reading can stay high on a burst. Only use it
+// after the settle: a reading right after a retune can belong to the previous frequency (gotchas 17.3–17.4).
+static bool scan_carrier_heard(const radio_sm_t *sm, const radio_status_t *st, uint32_t now_ms)
+{
+#if CONFIG_DMR || CONFIG_AIR
+	if (((CONFIG_DMR && sm->view.ch.mode == RADIO_MODE_DMR) || air_mode(sm->view.ch.mode)) &&
+	    now_ms - sm->scan.tuned_ms >= sm->scan.cfg.settle_ms && dmr_strength_heard(sm, st->rssi_dbm)) {
+		return true;
+	}
+#else
+	(void)now_ms;
+#endif
+	return carrier_heard(sm, st->noise);
+}
