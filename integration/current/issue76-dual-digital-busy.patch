 // What the debug link sends during the watch (radio-features.md 2.1): a position, a zone or a frequency acts on the
 // selected channel; a scan stop ends the watch and says so (view.dual_stops), so the UI doesn't start it again
+static void test_dual_digital_busy(void)
+{
+	start();
+	const radio_dual_ref_t home = { false, 0, 0 }, dmr = { false, 0, 5 };
+	dual(home, dmr, 0);
+	signal_on(0, 146520000, 30, no_tone);
+	run(300);
+	CHECK(on_ref(home) && sm.view.scan_phase == SCAN_PH_HOLD);
+	hw.sig[0].hz = 0;
+	CHECK(wait_on(dmr, 500) && sm.dual_peek);
+	// This receiver's noise reading does not drop on a DMR signal. Only the strength rises on each burst.
+	signal_on(1, 438500000, 120, no_tone);
+	hw.sig[1].tdma = true;
+	CHECK(wait_on(home, 300) && sm.view.scan_phase == SCAN_PH_RESUME);
+	CHECK(sm.view.dual_busy == 2);
+	hw.sig[1].hz = 0;
+	CHECK(wait_on(dmr, 300) && sm.dual_peek);
+	CHECK(wait_on(home, 300) && sm.view.dual_busy == 0);
+	dual_stop();
+}
+
