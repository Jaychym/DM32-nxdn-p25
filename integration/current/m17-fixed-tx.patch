+
+	for (int i = 1; i <= 5; i++) {
+		p[i] = a[i] + a[LPC + 1 - i] - p[i - 1];
+		q[i] = a[i] - a[LPC + 1 - i] + q[i - 1];
+	}
+	for (int i = 0; i < 5; i++) {
+		p[i] *= 2;
+		q[i] *= 2;
+	}
+	int32_t xl = ONE;
+	const int32_t delta = ONE / 100;
+	for (int j = 0; j < LPC; j++) {
+		const int32_t *poly = (j & 1) ? q : p;
+		int32_t left = cheb(poly, xl);
+		int found = 0;
+		int32_t xm = 0;
+		while (xl >= -ONE) {
+			int32_t xr = xl - delta;
+			int32_t right = cheb(poly, xr);
+			if ((right <= 0 && left >= 0) || (right >= 0 && left <= 0)) {
+				for (int k = 0; k < 6; k++) {
+					xm = (xl + xr) / 2;
+					int32_t mid = cheb(poly, xm);
+					if ((mid <= 0 && left >= 0) || (mid >= 0 && left <= 0))
+						xr = xm;
+					else {
+						xl = xm;
+						left = mid;
+					}
+				}
+				xm = (xl + xr) / 2;
+				xl = xm;
+				found = 1;
+				roots++;
+				break;
+			}
+			xl = xr;
+			left = right;
+		}
+		if (!found)
+			break;
+		// acos(x), in Hz, through a 256-interval interpolating table.
+		uint32_t pos = (uint32_t)(((int64_t)(ONE - xm) * 256) >> 1);
+		unsigned i = pos >> Q;
+		if (i >= 256)
+			hz[j] = 4000;
+		else {
+			uint32_t f = pos & (ONE - 1);
+			hz[j] = (int)(acos_hz[i] + (((uint64_t)(acos_hz[i + 1] - acos_hz[i]) * f) >> Q));
+		}
+	}
+	return roots;
+}
+
+static void analyse_lpc(const int16_t *history, int *hz, uint64_t *raw_out, int32_t *residual_out)
+{
+	int16_t w[N], x[N];
+	uint64_t raw = 0;
+	int peak = 0;
+
+	memset(w, 0, sizeof w);
+	for (int i = 0; i < NW; i++) {
+		int32_t v = ((int32_t)history[WSTART + i] * hann_q15[i]) >> 15;
+		w[WSTART + i] = (int16_t)v;
+		raw += (uint32_t)(v * v);
+		int a = v < 0 ? -v : v;
+		if (a > peak)
+			peak = a;
+	}
+	*raw_out = raw;
+	if (raw == 0) {
+		for (int i = 0; i < LPC; i++)
+			hz[i] = i * 4000 / LPC;
+		*residual_out = 0;
+		return;
+	}
+	int shift = 0, p = peak;
+	while (p > 2048) { p >>= 1; shift--; }
+	while (p < 1024 && shift < 6) { p <<= 1; shift++; }
+	for (int i = 0; i < N; i++)
+		x[i] = shift >= 0 ? (int16_t)(w[i] << shift) : (int16_t)(w[i] >> -shift);
+
+	int32_t r[LPC + 1] = { 0 }, rn[LPC + 1];
+	for (int j = 0; j <= LPC; j++)
+		for (int i = WSTART; i < WSTART + NW - j; i++)
+			r[j] += (int32_t)x[i] * x[i + j];
+	if (r[0] <= 0) {
+		for (int i = 0; i < LPC; i++)
+			hz[i] = i * 4000 / LPC;
+		*residual_out = 0;
+		return;
+	}
+	for (int i = 0; i <= LPC; i++)
+		rn[i] = (int32_t)(((int64_t)r[i] * ONE) / r[0]);
+
+	int32_t a[LPC + 1] = { ONE }, prev[LPC + 1] = { 0 };
+	int32_t e = ONE;
+	for (int i = 1; i <= LPC; i++) {
+		int32_t sum = rn[i];
+		for (int j = 1; j < i; j++)
+			sum += mul(prev[j], rn[i - j]);
+		int32_t k = e > 0 ? -div_q(sum, e) : 0;
+		if (k > ONE || k < -ONE)
+			k = 0;
+		a[i] = k;
+		for (int j = 1; j < i; j++)
+			a[j] = prev[j] + mul(k, prev[i - j]);
+		e = mul(e, ONE - mul(k, k));
+		for (int j = 1; j <= i; j++)
+			prev[j] = a[j];
+	}
+	for (int i = 1; i <= LPC; i++)
+		a[i] = mul(a[i], bw_q[i]);
+	*residual_out = e;
+	if (lpc_to_lsp_hz(a, hz) != LPC)
+		for (int i = 0; i < LPC; i++)
+			hz[i] = i * 4000 / LPC;
+}
+
+void codec2_fixed_3200_init(struct CODEC2 *c2)
+{
+	for (int i = 0; i < N; i++)
+		c2->fixed_sn[i] = 1;
+	c2->fixed_pitch = 80;
+}
+
+void codec2_fixed_3200_encode(struct CODEC2 *c2, unsigned char *bits, short speech[])
+{
+	unsigned nbit = 0;
+	int voiced[2], hz[LPC];
+	uint64_t raw;
+	int32_t residual;
+
+	memmove(c2->fixed_sn, c2->fixed_sn + 160, 160 * sizeof(int16_t));
+	memcpy(c2->fixed_sn + 160, speech, 160 * sizeof(int16_t));
+	voiced[0] = analyse_voicing(c2->fixed_sn + 160);
+	voiced[1] = analyse_voicing(c2->fixed_sn + 240);
+	if (voiced[0] || voiced[1])
+		c2->fixed_pitch = (int16_t)analyse_pitch(c2->fixed_sn, c2->fixed_pitch);
+	analyse_lpc(c2->fixed_sn, hz, &raw, &residual);
+
+	memset(bits, 0, 8);
+	pack(bits, &nbit, voiced[0], 1);
+	pack(bits, &nbit, voiced[1], 1);
+	pack(bits, &nbit, pitch_index(c2->fixed_pitch), 7);
+	pack(bits, &nbit, energy_index(raw, residual), 5);
+	int previous = 0;
+	for (int i = 0; i < LPC; i++) {
+		int target = i == 0 ? hz[i] : hz[i] - previous;
+		int lo = 0, hi = 31;
+		if (target <= (int)fixed_lsp_cb[i][0]) {
+			lo = 0;
+		} else if (target >= (int)fixed_lsp_cb[i][31]) {
+			lo = 31;
+		} else {
+			while (lo + 1 < hi) {
+				int mid = (lo + hi) / 2;
+				if ((int)fixed_lsp_cb[i][mid] <= target)
+					lo = mid;
+				else
+					hi = mid;
+			}
+			if (target - (int)fixed_lsp_cb[i][lo] > (int)fixed_lsp_cb[i][hi] - target)
+				lo = hi;
+		}
+		pack(bits, &nbit, lo, 5);
+		previous += fixed_lsp_cb[i][lo];
+	}
+}
