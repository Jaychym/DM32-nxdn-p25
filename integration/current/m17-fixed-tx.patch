+static int32_t cheb(const int32_t *coef, int32_t x)
+{
+	int32_t t0 = ONE, t1 = x;
+	int32_t sum = coef[5] + mul(coef[4], x);
+	int32_t twox = 2 * x;
+
+	for (int i = 2; i <= 5; i++) {
+		int32_t t = mul(twox, t1) - t0;
+		sum += mul(coef[5 - i], t);
+		t0 = t1;
+		t1 = t;
+	}
+	return sum;
+}
