+// Read a Gray-coded field from the standard 3200 bit/s frame.
+static unsigned c2_field(const uint8_t *bits, unsigned start, unsigned width)
+{
+	unsigned gray = 0, value;
+
+	for (unsigned i = 0; i < width; i++)
+		gray = (gray << 1) | ((bits[(start + i) / 8] >> (7 - (start + i) % 8)) & 1);
+	value = gray;
+	while (gray >>= 1)
+		value ^= gray;
+	return value;
+}
