+static int32_t mul(int32_t a, int32_t b)
+{
+	return (int32_t)(((int64_t)a * b) >> Q);
+}
+
+static int32_t div_q(int32_t a, int32_t b)
+{
+	return b != 0 ? (int32_t)(((int64_t)a * ONE) / b) : 0;
+}
+
+// log2 of a nonzero integer, Q16. The top eight mantissa bits select the table entry.
+static int32_t log2_u64(uint64_t x)
+{
+	int msb = 0;
+	uint64_t t = x;
+
+	while (t >>= 1)
+		msb++;
+	uint8_t i = msb >= 8 ? (uint8_t)(x >> (msb - 8)) : (uint8_t)(x << (8 - msb));
+	return msb * 65536 + log2_frac[i];
+}
+
+// 10*log10(x), Q16, from a log2(x) in the same format.
+static int32_t db10(int32_t log2x)
+{
+	return (int32_t)(((int64_t)log2x * 197283 + 32768) >> 16);
+}
+
+static int energy_index(uint64_t raw, int32_t residual)
+{
+	if (raw == 0 || residual <= 0)
+		return 0;
+	// raw is sum((speech*hann_q15)^2)/2^30. hann_power is sum(hann_q15^2).
+	// E = raw * residual * 2 / hann_power; residual is Q20 and is included as an integer here.
+	int32_t loge = log2_u64(raw) + log2_u64((uint32_t)residual) - log2_u64(hann_power) + 65536;
+	int32_t db = db10(loge);
+	int32_t index = (int32_t)(((int64_t)(db + 10 * 65536) * 32 + 25 * 65536) / (50 * 65536));
+	return index < 0 ? 0 : index > 31 ? 31 : index;
+}
+
+static int pitch_index(int period)
+{
+	if (period < 20)
+		period = 20;
+	if (period > 160)
+		period = 160;
+	// Wo=2*pi/p, linearly quantized between 2*pi/160 and 2*pi/20.
+	int index = (128 * (160 - period) + (7 * period) / 2) / (7 * period);
+	return index < 0 ? 0 : index > 127 ? 127 : index;
+}
+
+// Voicing of a 10 ms half: its normalized autocorrelation peak over the pitch lags. Dynamic scaling preserves quiet
+// speech and keeps 80 products in 32 bits.
+static int analyse_voicing(const int16_t *x)
+{
+	int32_t energy = 1;
+	int best_score = 0;
+	int peak = 0, shift = 0;
+
+	for (int n = -160; n < 80; n++) {
+		int a = x[n] < 0 ? -x[n] : x[n];
+		if (a > peak) peak = a;
+	}
+	while ((peak >> shift) > 2047 && shift < 4) shift++;
+	for (int n = 0; n < 80; n++) {
+		int32_t v = x[n] >> shift;
+		energy += v * v;
+	}
+	for (int p = 20; p <= 160; p++) {
+		int32_t corr = 0, delayed = 0;
+		for (int n = 0; n < 80; n++) {
+			int32_t d = x[n - p] >> shift;
+			corr += (x[n] >> shift) * d;
+			delayed += d * d;
+		}
+		// 2*corr/(E+Edelayed) is bounded by one and does not favour level changes.
+		int score = corr > 0 ? (int)(((int64_t)corr * 65536) / (energy + delayed)) : 0;
+		if (score > best_score)
+			best_score = score;
+	}
+	return energy > (128 << (2 * shift)) && best_score >= 18022; // about -5.2 dB normalized correlation
+}
+
+// Pitch period of the 20 ms block (sn[160..319], lags up to 160 into the history) by YIN's cumulative mean normalized
+// difference r: the first minimum under 0.15, or with none the deepest; a minimum within 20 % of the previous period
+// wins if it is no more than 0.15 above that. The autocorrelation peak this replaces favoured short lags (formants) and
+// sent the pitch up an octave on vowels: a high-pitched voice. Samples are scaled to 10 bits so a difference fits 32 bits
+static int analyse_pitch(const int16_t *sn, int previous)
+{
+	const int16_t *x = sn + 160;
+	int32_t r[161];			// normalized difference, Q16
+	int64_t cum = 0;
+	int peak = 0, shift = 0;
+
+	for (int n = 0; n < 320; n++) {
+		int a = sn[n] < 0 ? -sn[n] : sn[n];
+		if (a > peak) peak = a;
+	}
+	while ((peak >> shift) > 1023 && shift < 5) shift++;
+	for (int p = 1; p <= 160; p++) {
+		int32_t d = 0;
+		for (int n = 0; n < 160; n++) {
+			int32_t e = (x[n] >> shift) - (x[n - p] >> shift);
+			d += e * e;
+		}
+		cum += d;
+		r[p] = cum > 0 ? (int32_t)(((int64_t)d * p * 65536) / cum) : 65536;
+	}
+	int first = 0, deepest = 0, near = 0;
+	for (int p = 21; p < 160; p++) {
+		if (r[p] > r[p - 1] || r[p] > r[p + 1])
+			continue;
+		if (first == 0 && r[p] < 9830)	// 0.15
+			first = p;
+		if (deepest == 0 || r[p] < r[deepest])
+			deepest = p;
+		int dist = p > previous ? p - previous : previous - p;
+		if (dist * 5 <= previous && (near == 0 || r[p] < r[near]))
+			near = p;
+	}
+	int best = first ? first : deepest;
+	if (best == 0)
+		return previous;
+	if (near && r[near] <= r[best] + 9830)
+		best = near;
+	return best;
+}
