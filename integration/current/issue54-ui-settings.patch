+	radio_sm_set_settings(&sm, &s, now);
+	req(RREQ_PTT, 1);
+	CHECK(hw.tx_calls == 0);
+	run(80);
+	CHECK(hw.tx_calls == 0);
+	req(RREQ_PTT, 0);
+	run(700);
+	CHECK(hw.tx_calls == 0);
+	req(RREQ_PTT, 1);
+	run(700);
+	CHECK(hw.tx_calls == 1 && sm.view.state == RS_TX);
+	req(RREQ_PTT, 0);
+	run(300);
+	CHECK(sm.view.state == RS_IDLE);
+}
