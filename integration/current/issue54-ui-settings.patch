+static void test_scan_boundaries_and_leds(void)
+{
+	start();
+	req(RREQ_VFO_SET, 146000000);
+	radio_settings_t s = sm.set;
+	s.scan_lo_hz = 146000000u;
+	s.scan_hi_hz = 146100000u;
+	s.led_mode = RADIO_LED_SCAN_AMBER;
+	radio_sm_set_settings(&sm, &s, now);
+	req(RREQ_SCAN, RSCAN_VFO);
+	CHECK(sm.scan.lo_hz == 146000000u && sm.scan.hi_hz == 146100000u);
+	bool amber = false, dark = false;
+	for (unsigned i = 0; i < 55; i++) {
+		run(20);
+		CHECK(hw.led[LED_RED] == hw.led[LED_GREEN]);
+		amber |= hw.led[LED_RED];
+		dark |= !hw.led[LED_RED];
+		CHECK(sm.view.ch.rx_hz >= 146000000u && sm.view.ch.rx_hz <= 146100000u);
+	}
+	CHECK(amber && dark);
+	s.led_mode = RADIO_LED_OFF;
+	radio_sm_set_settings(&sm, &s, now);
+	req(RREQ_SCAN, RSCAN_STOP);
+	req(RREQ_PTT, 1);
+	CHECK(sm.view.state == RS_TX && !hw.led[LED_RED] && !hw.led[LED_GREEN]);
+	req(RREQ_PTT, 0);
+	req(RREQ_VFO_SET, 446000000);
+	req(RREQ_SCAN, RSCAN_VFO);
+	CHECK(sm.scan.lo_hz != s.scan_lo_hz && sm.scan.hi_hz != s.scan_hi_hz);
+	req(RREQ_SCAN, RSCAN_STOP);
+}
+
