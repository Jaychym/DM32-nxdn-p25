+static void fm_key(radio_sm_t *sm, uint32_t now_ms)
+{
+#if CONFIG_NET_USRP
+	// The host's audio replaces the microphone: never key without a way to send it
+	const hal_audio_tap_t *tap = board.audio_tap;
+	if (sm->host_audio && (tap == NULL || tap->fm_tx_inject == NULL)) {
+		deny(sm, TXDENY_MODE);
+		return;
+	}
+#endif
+#if RADIO_MDC_RX
+	mdc_rx_stop(sm);		// the receive audio path goes back before the transmitter takes the modem
+#endif
+	sm->view.state = RS_TX;		// speaker off, red LED on, before keying
+	sm->view.tx_auto = false;
+	sm->view.last_tx_ms = now_ms != 0 ? now_ms : 1;
+	sm->view.tx_deny = TXDENY_NONE;
+	sm->view.tx_elapsed_ms = 0;
+	sm->tx_start_ms = now_ms;
+	outputs(sm);
+	const channel_t *ch = &sm->view.ch;
+	if (!key_tx(ch->tx_hz, (radio_bw_t)ch->bw, sm->view.power, &ch->tx_tone)) {
+		deny(sm, board_refusal());
+		return;
+	}
+#if CONFIG_NET_USRP
+	// The board ends the injection itself at tx_off() / rx()
+	if (sm->host_audio && !tap->fm_tx_inject(audio_mux_fm_pull, AUDIO_TAP_VOICE)) {
+		board.radio->tx_off();
+		deny(sm, TXDENY_MODE);
+		return;
+	}
+#endif
+#if CONFIG_MDC1200
+	sm->mdc_phase = mdc_wanted(sm, CODEPLUG_ANI_PRE) ? MDC_PRE_WAIT : MDC_OFF;	// mdc_poll sends it
+#endif
+	changed(sm);
+}
+
+#if CONFIG_FM && CONFIG_BEEP
+static void fm_permit_poll(radio_sm_t *sm, uint32_t now_ms)
+{
+	uint32_t elapsed = now_ms - sm->fm_permit_ms;
+	if (sm->fm_permit_ms == 0 || elapsed < PERMIT_HOLD_MIN_MS ||
+	    (elapsed < PERMIT_HOLD_MAX_MS && (permit_busy() || beep_streaming())))
+		return;
+	sm->fm_permit_ms = 0;
+	if (!sm->ptt || sm->hotspot || sm->power_off_req || sm->view.ch.mode != RADIO_MODE_FM)
+		return;
+	uint8_t reason = tx_check(sm);
+	if (reason == TXDENY_NONE)
+		fm_key(sm, now_ms);
+	else
+		deny(sm, reason);
+}
+#endif
