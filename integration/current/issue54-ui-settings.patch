 // Tools > Position with CONFIG_GPS_SKY (docs/spec/ui.md 2.3): the board GPS on four pages, Up / Down (the knob, the
-// digits 1-4) to turn them. Status: the fix, satellites, position, altitude, speed, dilution, time. Sky: where each
+// digits) to turn them. Status: the fix, satellites, position, altitude, speed, dilution, time. Sky: where each
 // satellite is (a polar plot, north up), filled when the fix uses it. Signal: each satellite with a signal as a bar. Grid:
 // the Maidenhead locator large, the position in degrees, minutes and seconds. Nothing is kept: every draw reads the
 // service again, the satellites one at a time.
@@ -15,9 +15,9 @@
 #include "fmt.h"
 #include "i18n.h"
 
-enum { PG_STATUS, PG_SKY, PG_SIGNAL, PG_GRID, PG_COUNT };
+enum { PG_STATUS, PG_SKY, PG_SIGNAL, PG_GRID, PG_CLOCK, PG_COUNT };
 static const tr_id_t page_names[PG_COUNT] = { TRN(GPS_TITLE_STATUS, "Status"), TRN(GPS_TITLE_SKY, "Sky"),
-	TRN(GPS_TITLE_SIGNAL, "Signal"), TRN(WORD_GRID, "Grid") };
+	TRN(GPS_TITLE_SIGNAL, "Signal"), TRN(WORD_GRID, "Grid"), TRN(GPS_TITLE_CLOCK, "Clock") };
 static const char sys_letter[UI_GNSS_COUNT] = { 'G', 'R', 'E', 'C', 'J' };
 static const char *const sys_names[UI_GNSS_COUNT] = { "GPS", "GLONASS", "Galileo", "BeiDou", "QZSS" };
 static const char *const sys_short[UI_GNSS_COUNT] = { "GPS", "GLO", "GAL", "BDS", "QZS" };
@@ -25,10 +25,10 @@ static const char *const sys_short[UI_GNSS_COUNT] = { "GPS", "GLO", "GAL", "BDS"
 
 static uint8_t page;
 
-// A tall panel has room for the grid on Status: three pages, no Grid page
+// A tall panel has room for the grid on Status, without a separate Grid page
 static uint8_t page_count(void)
 {
-	return gfx_height() >= UI_TALL_PX ? PG_GRID : PG_COUNT;
+	return gfx_height() >= UI_TALL_PX ? PG_COUNT - 1 : PG_COUNT;
 }
 
 // A system's color; every one is also named in the legend (P5). Ink on a monochrome panel
@@ -277,7 +277,7 @@ static void draw_status(const ui_position_t *p, int y)
 	char buf[32];
 	sbuf_t b;
 	const font_t *big = gfx_width() >= 200 ? ui_layout.large : ui_layout.medium;
-	bool grid = page_count() == PG_GRID && p->fix;	// tall panels have no separate Grid page
+	bool grid = gfx_height() >= UI_TALL_PX && p->fix;	// tall panels have no separate Grid page
 	gfx_text(big, 0, y, fix_word(p), p->fix ? ui_col.rx : ui_col.warn);
 	if (grid) {
 		char loc[7];
@@ -549,20 +549,47 @@ static void draw_grid(const ui_position_t *p, int y)
 	row(&y, "", buf, ui_col.dim);
 }
 
+static void draw_clock(const ui_position_t *p, int y)
+{
+	if (!p->fix || p->utc_hms == 0xFFFFFFFFu) {
+		gfx_text(ui_layout.small, 0, y, TR(GPS_EMPTY_NO_FIX, "No fix yet"), ui_col.warn);
+		return;
+	}
+	char text[16];
+	sbuf_t b;
+	sb_init(&b, text, sizeof text);
+	sb_u32(&b, p->utc_hms / 10000u, 2);
+	sb_chr(&b, ':');
+	sb_u32(&b, p->utc_hms / 100u % 100u, 2);
+	sb_chr(&b, ':');
+	sb_u32(&b, p->utc_hms % 100u, 2);
+	if (!row(&y, "UTC", text, ui_col.fg) || p->utc_date == 0)
+		return;
+	sb_init(&b, text, sizeof text);
+	sb_u32(&b, p->utc_date % 100u + 2000u, 4);
+	sb_chr(&b, '-');
+	sb_u32(&b, p->utc_date / 100u % 100u, 2);
+	sb_chr(&b, '-');
+	sb_u32(&b, p->utc_date / 10000u, 2);
+	row(&y, TR(GPS_LABEL_DATE, "Date"), text, ui_col.fg);
+}
+
 static void gps_draw(void)
 {
 	ui_position_t p;
 	gfx_clear(ui_col.bg);
-	int y = ui_draw_top(ui_view(), &ui_st, "GPS", tr(page_names[page])) + 2;
+	uint8_t current = gfx_height() >= UI_TALL_PX && page == PG_GRID ? PG_CLOCK : page;
+	int y = ui_draw_top(ui_view(), &ui_st, "GPS", tr(page_names[current])) + 2;
 	if (!ui_svc_position(&p)) {
 		gfx_text(ui_layout.small, 0, y, TR(GPS_WHY_NO_GPS_OR_OFF, "No GPS, or it is off"), ui_col.warn);
 		gfx_text(ui_layout.small, 0, y + ui_layout.small->h + 2,
 			TR(GPS_FIX_SETTINGS_LOCATION, "Settings > Location"), ui_col.dim);
 	} else {
-		switch (page) {
+		switch (current) {
 		case PG_SKY: draw_sky(&p, y); break;
 		case PG_SIGNAL: draw_signal(&p, y); break;
 		case PG_GRID: draw_grid(&p, y); break;
+		case PG_CLOCK: draw_clock(&p, y); break;
 		default: draw_status(&p, y); break;
 		}
 	}
