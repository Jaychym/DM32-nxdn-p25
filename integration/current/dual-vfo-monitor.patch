diff --git a/tests/host/radioCoreTest.c b/tests/host/radioCoreTest.c
index 5f55d65..eb89c06 100644
--- a/tests/host/radioCoreTest.c
+++ b/tests/host/radioCoreTest.c
@@ -9036,6 +9036,32 @@ static void test_nxdn_dual(void)
 	CHECK(sm.dual_at == 1 && sm.view.channel_number == 3 && sm.view.dmr.hear_all_latch);
 	CHECK(!sm.dual_keep[0].hear_all_latch);
 	CHECK(ui_svc_dual(NULL, 0) && sm.view.scan == SCAN_OFF);
+
+	// A stored DMR channel and a VFO NXDN channel must each restore their own monitor latch before tune.
+	add(1, "DMR A", 446100000, RADIO_MODE_DMR, false, 0);
+	start();
+	nxdn_defaults();
+	sm.vfo_ch.rx_hz = sm.vfo_ch.tx_hz = 446200000;
+	sm.vfo_ch.mode = RADIO_MODE_NXDN;
+	sm.vfo_seeded = true;
+	const ui_dual_ref_t mixed[2] = { a, { true, 0, sm.vfo_idx } };
+	CHECK(ui_svc_dual(mixed, 1) && sm.view.scan == SCAN_DUAL);
+	req(RREQ_MONITOR, 1);
+	req(RREQ_MONITOR, 0);
+	CHECK(sm.view.vfo && sm.view.ch.mode == RADIO_MODE_NXDN && sm.view.dmr.hear_all_latch);
+	uint8_t returned = 0;
+	for (int i = 0; i < 150; i++) {
+		run(RADIO_POLL_MS);
+		if (sm.view.vfo) {
+			CHECK(sm.view.ch.mode == RADIO_MODE_NXDN && sm.view.dmr.hear_all_latch);
+			returned |= 1;
+		} else {
+			CHECK(sm.view.ch.mode == RADIO_MODE_DMR && !sm.view.dmr.hear_all_latch);
+			returned |= 2;
+		}
+	}
+	CHECK(returned == 3 && sm.view.scan == SCAN_DUAL);
+	CHECK(ui_svc_dual(NULL, 0) && sm.view.scan == SCAN_OFF);
 	setup_codeplug_nxdn();
 	far_hz = 0;
 	nfar_stop();
