+void settings_pin_set(uint32_t pin, uint32_t salt, uint8_t digits)
+{
+	if ((digits != 4 && digits != 6) || pin >= (digits == 4 ? 10000u : SETTINGS_PIN_LIMIT))
 		return;
 	if (salt == 0)
