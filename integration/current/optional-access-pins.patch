 }
 
 bool settings_programming_protected(void) { return cps_protected; }
-bool settings_programming_allowed(void) { return !credential_prompt && (!cps_protected || cps_granted); }
+bool settings_programming_allowed(void) { return !credential_prompt && ((!cps_protected && !read_protected) || cps_granted); }
 void settings_pin_prompt(bool on) { credential_prompt = on; }
 
 void settings_programming_protect(bool on)
@@ -106,4 +120,72 @@ void settings_programming_protect(bool on)
 }
 
 void settings_programming_grant(bool on) { cps_granted = on; }
+
+bool settings_read_pin_enabled(void) { return read_protected; }
+bool settings_read_pin_available(void) { return read_protected && !credential_prompt && (!cps_protected || cps_granted); }
+
+void settings_read_pin_set(uint32_t pin, uint32_t salt)
+{
+	if (pin >= SETTINGS_PIN_LIMIT)
+		return;
+	if (salt == 0)
+		salt = 1;
+	uint8_t check[8];
+	pin_verifier(pin | 0x800000u, salt, check);
+	settings_t *s = settings_begin();
+	s->cps_read_salt = salt;
+	memcpy(s->cps_read_verifier, check, sizeof check);
+	settings_end(hal_millis());
+	cps_granted = false;
+	read_protected = true;
+}
+
+void settings_read_pin_clear(void)
+{
+	settings_t *s = settings_begin();
+	s->cps_read_salt = 0;
+	memset(s->cps_read_verifier, 0, sizeof s->cps_read_verifier);
+	settings_end(hal_millis());
+	read_protected = cps_granted = false;
+}
+
+bool settings_read_pin_matches(uint32_t pin)
+{
+	if (pin >= SETTINGS_PIN_LIMIT)
+		return false;
+	uint8_t saved[8], check[8];
+	const settings_t *s = settings_begin();
+	uint32_t salt = s->cps_read_salt;
+	memcpy(saved, s->cps_read_verifier, sizeof saved);
+	settings_end(hal_millis());
+	if (!salt)
+		return false;
+	pin_verifier(pin | 0x800000u, salt, check);
+	uint8_t diff = 0;
+	for (unsigned i = 0; i < sizeof check; i++)
+		diff |= check[i] ^ saved[i];
+	return diff == 0;
+}
+
+bool settings_read_pin_authorize(const uint8_t ascii[6], uint32_t now)
+{
+	if (!settings_read_pin_available() || (read_blocked_until && (int32_t)(now - read_blocked_until) < 0))
+		return false;
+	read_blocked_until = 0;
+	uint32_t pin = 0;
+	for (unsigned i = 0; i < 6; i++) {
+		if (ascii[i] < '0' || ascii[i] > '9')
+			return false;
+		pin = pin * 10u + (ascii[i] - '0');
+	}
+	if (settings_read_pin_matches(pin)) {
+		read_failures = 0;
+		return true;
+	}
+	if (++read_failures >= 3) {
+		read_failures = 0;
+		read_blocked_until = (now + 20000u) | 1u;
+	}
+	return false;
+}
 #endif
