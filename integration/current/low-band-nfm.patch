+static void test_narrow_fm_band(void)
+{
+	start();
+	req(RREQ_VFO_SET, 146520000);
+	req(RREQ_BANDWIDTH, RADIO_BW_25K);
+	CHECK(hw.fm_bw == RADIO_BW_25K);
+	req(RREQ_MODE, RADIO_MODE_DMR);
+	CHECK(sm.view.ch.mode == RADIO_MODE_DMR);
+
+	const uint32_t frequencies[] = { 66000000, 70125000, 88000000 };
+	for (unsigned i = 0; i < sizeof frequencies / sizeof frequencies[0]; i++) {
+		uint32_t hz = frequencies[i];
+		req(RREQ_VFO_SET, (int32_t)hz);
+		run(50);
+		CHECK(sm.view.vfo && sm.view.ch.mode == RADIO_MODE_FM && sm.view.ch.rx_only);
+		CHECK(hw.rx_hz == hz && hw.fm_bw == RADIO_BW_12K5 && !hw.am && !bc.on && !sm.view.bcast);
+		req(RREQ_BANDWIDTH, RADIO_BW_25K);
+		req(RREQ_MODE, RADIO_MODE_DMR);
+		req(RREQ_VFO_TX, 146520000);
+		CHECK(sm.view.ch.bw == RADIO_BW_12K5 && sm.view.ch.mode == RADIO_MODE_FM && sm.view.ch.tx_hz == hz);
+		ptt(true);
+		CHECK(sm.view.tx_deny == TXDENY_RX_ONLY && hw.tx_calls == 0);
+		ptt(false);
+	}
+	CHECK(!board_nfm_rx_only(65999990) && !board_nfm_rx_only(88000010));
+	req(RREQ_VFO_SET, 146520000);
+	CHECK(!sm.view.ch.rx_only && hw.fm_bw == RADIO_BW_25K);
+	req(RREQ_VFO_SET, 118100000);
+	CHECK(hw.am && sm.view.am);
+
+	add(3, "Low band", 70125000, 146520000, RADIO_MODE_DMR);
+	chans[3].kind = CODEPLUG_KIND_AM;	// a stored tag cannot override the fixed FM profile
+	req(RREQ_ZONE_POS, 2);
+	hw.sig_hz = 70125000;
+	run(100);
+	CHECK(!sm.view.vfo && sm.view.ch.kind == CODEPLUG_KIND_NONE && sm.view.ch.rx_only);
+	CHECK(sm.view.state == RS_RX && hw.audio && !hw.am && !bc.on && hw.fm_bw == RADIO_BW_12K5);
+	ptt(true);
+	CHECK(sm.view.tx_deny == TXDENY_RX_ONLY && hw.tx_calls == 0);
+	ptt(false);
+	CHECK(chans[3].kind == CODEPLUG_KIND_AM && chans[3].tx_hz == 146520000);
+
+	add(5, "Split to low band", 146520000, 70125000, RADIO_MODE_FM);
+	req(RREQ_ZONE_POS, 4);
+	ptt(true);
+	CHECK(sm.view.tx_deny == TXDENY_RX_ONLY && hw.tx_calls == 0);
+	ptt(false);
+	CHECK(!radio_sm_hotspot_freq_ok(70125000, 146520000));
+	CHECK(!radio_sm_hotspot_freq_ok(146520000, 70125000));
