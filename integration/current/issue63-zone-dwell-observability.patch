+@pytest.mark.feature("scan")
+def test_zone_scan_dwell_setting(radio):
+    need_scan(radio)
+    key = "settings.zone_scan_dwell_25ms"
+    before = radio.link.view(["storage"])
+    if key not in before:
+        skip("not_built", "firmware without the zone dwell setting in the storage view")
+    old = as_int(before[key], 0)
+    try:
+        for dwell in (50, 500):
+            radio.link.setting("zone_scan_dwell_ms", dwell)
+            radio.wait_for(lambda v: as_int(v.get(key), 0) == dwell // 25, 1.0, sections=("storage",),
+                           what=f"zone scan dwell set to {dwell} ms")
+            time.sleep(0.06)    # radio request rate limit
+    finally:
+        radio.link.setting("zone_scan_dwell_ms", min(max(old, 1), 20) * 25)
+
+
 @pytest.mark.feature("scan")
 def test_zone_scan_cancel(radio):
     need_scan(radio)
