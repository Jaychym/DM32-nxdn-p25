+static void test_zone_scan_timing_options(void)
+{
+	static const uint16_t options[] = { 25, 50, 75, 100, 150, 250, 500 };
+	for (unsigned i = 0; i < sizeof options / sizeof options[0]; i++) {
+		uint16_t ms = options[i];
+		start();
+		radio_settings_t s = sm.set;
+		s.zone_scan_dwell_ms = ms;
+		radio_sm_set_settings(&sm, &s, now);
+		req(RREQ_SCAN, RSCAN_ZONE);
+		CHECK(sm.view.zone_pos == 1 && sm.view.ch.mode == RADIO_MODE_FM);
+		run(ms - RADIO_POLL_MS);
+		CHECK(sm.view.zone_pos == 1);
+		run(RADIO_POLL_MS);
+		CHECK(sm.view.zone_pos == 4);
+		run(ms);
+		CHECK(sm.view.zone_pos == 5 && sm.view.ch.mode == RADIO_MODE_DMR);
+		uint16_t dmr_ms = ms < RADIO_SCAN_DMR_DWELL_MS ? RADIO_SCAN_DMR_DWELL_MS : ms;
+		run(dmr_ms - RADIO_POLL_MS);
+		CHECK(sm.view.zone_pos == 5);
+		run(RADIO_POLL_MS);
+		CHECK(sm.view.zone_pos == 6);
+	}
+}
