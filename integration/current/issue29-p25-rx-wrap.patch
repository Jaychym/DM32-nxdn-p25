+static void testCallSequenceWrap(void)
+{
+	bool heard = false;
+
+	begin();
+	for (unsigned i = 0; i < UINT8_MAX; i++) {
+		hk->rx_start(NULL, NULL);
+		p25VoicePoll();
+		hk->rx_end(NULL);
+		block();
+	}
+	// A pause for TX stops the PCM stream but keeps the running engine's call count.
+	p25VoicePause();
+	CHECK(!running, "the PCM stream paused");
+	hk->rx_start(NULL, NULL);
+	ldu(0);
+	hk->rx_end(NULL);
+	p25VoicePoll();
+	CHECK(running, "the call at sequence wrap starts PCM again");
+	for (int i = 0; running && i < P25_VOICE_LEAD + P25_VOICE_FRAMES; i++)
+		heard |= block();
+	CHECK(heard, "the call at sequence wrap reaches the PCM output");
+}
+
