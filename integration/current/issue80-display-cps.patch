 }
+bool p25_conv_load(uint16_t number, const channel_t *ch, p25_conv_cfg_t *out)
+{
+	memset(out, 0, sizeof *out);
+	if (!p25_conv_params(number, ch, &out->conv))
+		return false;
+	out->target = P25_CP_TG_DEFAULT;
+	contact_t contact;
+	uint16_t idx = codeplug_channel_talk_contact(ch);
+	if (idx && codeplug_contact(idx, &contact)) {
+		out->target_unit = contact.type == CONTACT_PRIVATE;
+		if (contact.type == CONTACT_ALL_CALL)
+			out->target = P25_CP_TG_ALL;
+		else if (out->target_unit || (contact.id >= 1u && contact.id <= 0xffffu))
+			out->target = contact.id;
+	}
+	return true;
+}
