+	CHECK(saved.kind == CODEPLUG_KIND_DSTAR && !saved.rx_only && saved.rx_hz == ch.rx_hz);
+	codeplug_tag_t tag;
+	CHECK(codeplug_tag_read(21, &tag) && (tag.flags & CODEPLUG_TAG_TX));
+	saved.rx_only = true;
+	CHECK(dstar_channel_save(22, 21, &saved));
+	CHECK(codeplug_channel(22, &saved) && saved.kind == CODEPLUG_KIND_DSTAR && saved.rx_only);
+	CHECK(codeplug_tag_remove(21));
+	CHECK(codeplug_channel(21, &saved) && saved.kind == CODEPLUG_KIND_NONE &&
+	      saved.mode == RADIO_MODE_DMR && saved.rx_only);
+	saved.mode = RADIO_MODE_FM;
+	saved.rx_only = false;
+	CHECK(codeplug_set_channel(22, &saved));
+	CHECK(codeplug_channel(22, &saved) && saved.kind == CODEPLUG_KIND_NONE &&
+	      saved.mode == RADIO_MODE_FM && !saved.rx_only);
+	CHECK(sim_flash_violations() == 0);
+}
+#endif
+
 int main(void)
 {
+#if CONFIG_DSTAR
+	test_dstar_memory();
+#endif
 	test_encode();
 	test_materialize();
 	test_channel_dmr_aes();
