 const MODES = { fm: "FM", dmr: "DMR" };
 const TYPES = Object.fromEntries(CALL_TYPES.map((k) => [k, k[0].toUpperCase() + k.slice(1)]));
 
+// A channel mode in CSV: FM and DMR are plain records; conventional NXDN is the channel-mode layer's kind 4.
+// "NXDN" alone means the 9600 bit/s mode, as the editor's new NXDN channel does.
+const NXDN_KIND = 4;
+const asChannelMode = (s) => {
+	const v = s.trim().toLowerCase().replace(/[_-]/g, " ").replace(/\s+/g, " ");
+	if (!v) return { kind: 0, mode: "fm" };
+	for (const [mode, text] of Object.entries(MODES)) if (text.toLowerCase() === v) return { kind: 0, mode };
+	if (["nxdn", "nxdn96", "nxdn 96", "nxdn9600", "nxdn 9600"].includes(v)) return { kind: NXDN_KIND, rate9600: true };
+	if (["nxdn48", "nxdn 48", "nxdn4800", "nxdn 4800"].includes(v)) return { kind: NXDN_KIND, rate9600: false };
+	throw new Bad("bad_value", { value: s.trim(), allowed: "FM, DMR, NXDN 4800, NXDN 9600" });
+};
+const channelModeText = (r) => r.kind === NXDN_KIND ? (r.params?.rate9600 === false ? "NXDN 4800" : "NXDN 9600") : MODES[r.mode];
+const setChannelMode = (r, s, m) => {
+	const v = asChannelMode(s);
+	if (v.kind) {
+		setKind(m, r, v.kind);
+		r.params = { ...r.params, rate9600: v.rate9600 };
+	} else setKind(m, r, 0, v.mode);
+};
+const rxOnlyText = (r) => yesNo(r.kind === NXDN_KIND ? !r.tagTx : r.rxOnly);
+const setRxOnly = (r, s) => {
+	const v = asBool(s);
+	if (r.kind === NXDN_KIND) r.tagTx = !v;
+	else r.rxOnly = v;
+};
+const asRan = (s) => {
+	const v = s.trim();
+	if (!v) return null;
+	const n = Number(v);
+	if (!Number.isInteger(n) || n < 0 || n > 63) throw new Bad("range", { min: 0, max: 63 });
+	return n;
+};
+const nxdnField = (key, put, get) => ({
+	get: (r) => (r.kind === NXDN_KIND && r.params ? get(r.params) : ""),
+	set: (r, s) => {
+		const v = put(s);
+		if (v === null) return;
+		if (r.kind !== NXDN_KIND || !r.params) throw new Bad("bad_value", { value: s.trim(), allowed: "an NXDN channel" });
+		r.params = { ...r.params, [key]: v };
+	},
+});
+const asNxdnSquelch = (s) => {
+	const v = s.trim().toLowerCase();
+	if (!v) return null;
+	if (v === "ran") return 0;
+	if (v === "selective") return 1;
+	throw new Bad("bad_value", { value: s.trim(), allowed: "RAN, Selective" });
+};
