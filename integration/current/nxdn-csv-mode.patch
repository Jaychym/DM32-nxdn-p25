+test("CSV carries a conventional NXDN channel instead of dropping it to FM", () => {
+	const m = empty();
+	const text = [
+		"Name,Mode,RX Frequency (MHz),TX Frequency (MHz),NXDN Squelch,RX RAN,TX RAN,RX Only",
+		"NXDN,NXDN 4800,446.08625,446.08625,Selective,9,5,No",
+	].join("\n");
+	const r = importTable(m, text, "channels");
+	assert.deepEqual(r.problems, []);
+	const c = m.channels[0];
+	assert.equal(c.kind, 4);
+	assert.equal(c.mode, "dmr", "the record under the NXDN tag is the safe stand-in");
+	assert.equal(c.rxOnly, true);
+	assert.equal(c.tagTx, true);
+	assert.deepEqual(c.params, { rate9600: false, squelch: 1, rxRan: 9, txRan: 5, aes: false, keyId: 0 });
+
+	// The encoded tag comes back as NXDN, and export keeps its rate, RANs, squelch and transmit permission.
+	const back = decode(encode(m));
+	const b = back.channels[0];
+	assert.equal(b.kind, 4);
+	assert.equal(b.tagTx, true);
+	assert.deepEqual(b.params, { rate9600: false, squelch: 1, rxRan: 9, txRan: 5, aes: false, keyId: 0 });
+	const rows = parse(exportTable(back, "channels"));
+	const col = (name) => rows[0].indexOf(name);
+	assert.equal(rows[1][col("Mode")], "NXDN 4800");
+	assert.equal(rows[1][col("NXDN Squelch")], "Selective");
+	assert.equal(rows[1][col("RX RAN")], "9");
+	assert.equal(rows[1][col("TX RAN")], "5");
+	assert.equal(rows[1][col("RX Only")], "No");
+
+	// NXDN alone and the common rate names are accepted too; neither becomes an FM channel with a warning.
+	for (const word of ["NXDN", "NXDN96", "NXDN 9600", "NXDN48", "NXDN 4800"]) {
+		const n = empty();
+		const rr = importTable(n, `Name,Mode,RX Frequency (MHz),TX Frequency (MHz)\nNXDN,${word},446.08625,446.08625\n`, "channels");
+		assert.deepEqual(rr.problems, [], word);
+		assert.equal(n.channels[0].kind, 4, word);
+		assert.equal(n.channels[0].params.rate9600, !word.includes("48") && !word.includes("4800"), word);
+	}
+});
+
