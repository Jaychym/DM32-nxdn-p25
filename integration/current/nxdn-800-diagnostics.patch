+static void test_nxdn_trunk_rx_only(void)
+{
+	setup_codeplug_nxdn();
+	start();
+	board_rx_ext_set(true);
+	req(RREQ_VFO, 1);
+	req(RREQ_VFO_SET, 851000000);
+	req(RREQ_MODE, RADIO_MODE_NXDN);
+	radio_nxdn_settings_t set = nxdn_default_set;
+	set.trunk = RADIO_NXDN_TRUNK_ALL;
+	radio_req_nxdn_settings(&set);
+	CHECK(sm.view.ch.rx_hz == 851000000 && sm.view.ch.tx_hz == 851000000);
+	CHECK(radio_nxdn_trunked() && !radio_nxdn_trunk_tx());
+	CHECK(sm.view.nxdn.tstate == RADIO_NXDN_TS_CONTROL);
+	int before = hw.tx_calls;
+	req(RREQ_PTT, 1);
+	CHECK(sm.view.state == RS_TX_DENIED && sm.view.tx_deny == TXDENY_RX_ONLY);
+	req(RREQ_PTT, 0);
+	run(5000);
+	CHECK(hw.tx_calls == before);
+	uint8_t frame[NXDN_FRAME_BYTES] = {0};
+	uint8_t cac[NXDN_CAC_BYTES] = { 1, NXDN_MSG_SITE_INFO, 0x12, 0x34, 0x56 };
+	nxdn_frame_begin(frame, NXDN_LICH(NXDN_RF_RCCH, NXDN_USC_CAC, 0, NXDN_DIR_OUTBOUND));
+	nxdn_cac_put(frame, cac);
+	for (unsigned i = 0; i < 3; i++) {
+		air_deliver(&fair[0], frame, AIR_CHUNK);
+		fair[0].now_us += 30000;
+		air_deliver(&fair[0], frame + AIR_CHUNK / 4, NXDN_FRAME_SYMS - AIR_CHUNK);
+		fair[0].now_us += 10000;
+	}
+	run(RADIO_POLL_MS);
+	char buf[768];
+	dl_text_t t;
+	dl_text_init(&t, buf, sizeof buf);
+	debuglink_view_nxdn_trunk(&sm.view, &t);
+	CHECK(strstr(buf, "nxdn.trunk.cac_ok=3\n") && strstr(buf, "nxdn.trunk.cac_fail=0\n"));
+	CHECK(strstr(buf, "nxdn.trunk.site_known=1\n") && strstr(buf, "nxdn.trunk.location=123456\n"));
+	CHECK(strstr(buf, "nxdn.trunk.control_hz=851000000\n") && strstr(buf, "nxdn.trunk.listen_hz=851000000\n"));
+	CHECK(strstr(buf, "nxdn.trunk.tx_enabled=0\n") != NULL);
+	nxdn_defaults();
+	board_rx_ext_set(false);
+}
+
 static void test_nxdn(void)
 {
 	test_nxdn_rx();
+	test_nxdn_trunk_rx_only();
 	test_nxdn_monitor();
 #if CONFIG_AIR_AES
 	test_nxdn_aes();
