+static bool tune(uint32_t hz, void *ctx)
+{
+	const uint32_t *maximum = ctx;
+	if (maximum && hz > *maximum)
+		return false;
+	if (ntuned < 16)
+		tuned[ntuned] = hz;
+	ntuned++;
+	return true;
+}
 
