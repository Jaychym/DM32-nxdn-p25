+			(unsigned)trunk.control_hz, (unsigned)trunk.listen_hz, trunk.site_known,
+			(unsigned)trunk.location, trunk.dfa, trunk.base, trunk.step);
+		dl_text(t, "nxdn.trunk.assigns=%u\nnxdn.trunk.follows=%u\nnxdn.trunk.refusals=%u\n"
+			"nxdn.trunk.reason=%u\nnxdn.trunk.assigned_chan=%u\nnxdn.trunk.assigned_hz=%u\n",
+			(unsigned)trunk.assigns, (unsigned)trunk.follows, (unsigned)trunk.refusals, trunk.reason,
+			trunk.assigned_chan, (unsigned)trunk.assigned_hz);
