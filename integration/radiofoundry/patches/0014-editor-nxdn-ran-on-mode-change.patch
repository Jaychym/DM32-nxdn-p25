+test("a channel moved between P25 and NXDN gets that family's NAC or RAN, never the other's number", () => {
+	const table = columns("channels", empty(), t).find((c) => c.key === "mode");
+	const form = field("mode");
+	for (const set of [(r, v) => table.set(r, v), (r, v) => form.set(r, v)]) {
+		const r = { mode: "p25", nacRx: 0xF7E, nacTx: 0x293 };
+		set(r, "nxdn");
+		assert.deepEqual([r.mode, r.nacRx, r.nacTx], ["nxdn", 0, 1]);	// the decoder's RAN defaults (records.js)
+		r.nacTx = 12;
+		set(r, "nxdn");
+		assert.equal(r.nacTx, 12);	// the same mode again changes nothing
+		set(r, "p25");
+		assert.deepEqual([r.mode, r.nacRx, r.nacTx], ["p25", 0xF7E, 0x293]);
+		const fm = { mode: "fm", nacRx: 0x293, nacTx: 0x293 };
+		set(fm, "nxdn");
+		assert.deepEqual([fm.nacRx, fm.nacTx], [0, 1]);
+		const ran = { mode: "dmr", nacRx: 5, nacTx: 7 };
+		set(ran, "nxdn");
+		assert.deepEqual([ran.nacRx, ran.nacTx], [5, 7]);	// already RANs: kept
+		const trunk = { mode: "p25", nacRx: 0x123, nacTx: 0x456 };
+		set(trunk, "p25trunk");
+		assert.deepEqual([trunk.nacRx, trunk.nacTx], [0x123, 0x456]);	// P25 to P25: kept
+	}
+});
