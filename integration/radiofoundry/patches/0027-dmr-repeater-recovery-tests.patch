+// Failed repeater wake-ups and a rejected call must recover on the next PTT without reinitializing the stack.
+static void test_rmo_recovery_without_reboot(void)
+{
+	for (uint8_t ts = 1; ts <= 2; ts++) {
+		dmr_call_config_t c = base_cfg();
+		c.rmo = true;
+		c.ts = ts;
+		setup(&c);
+		for (int attempt = 0; attempt < 2; attempt++) {
+			dmr_call_ptt(true);
+			run_ms(3000);
+			CHECK(V()->phase == DMR_CALL_PHASE_TX_DENIED && V()->tx_error == DMR_TX_ERR_NO_REPEATER);
+			dmr_call_ptt(false);
+			run_ms(20);
+			CHECK(V()->phase == DMR_CALL_PHASE_IDLE);
+		}
+		sim.wake_repeater_on_csbk = true;
+		for (int call = 0; call < 3; call++) {
+			dmr_call_ptt(true);
+			run_ms(700);
+			CHECK(V()->phase == DMR_CALL_PHASE_TX_VOICE && sim.last_ts == ts);
+			dmr_call_ptt(false);
+			run_ms(800);
+			CHECK(V()->phase == DMR_CALL_PHASE_IDLE && V()->tx_error == DMR_TX_OK);
+		}
+		sim.reject_next = true;
+		dmr_call_ptt(true);
+		run_ms(100);
+		CHECK(V()->phase == DMR_CALL_PHASE_TX_DENIED && V()->tx_error == DMR_TX_ERR_REJECTED);
+		dmr_call_ptt(false);
+		run_ms(30);
+		dmr_call_ptt(true);
+		run_ms(700);
+		CHECK(V()->phase == DMR_CALL_PHASE_TX_VOICE && sim.last_ts == ts);
+		dmr_call_ptt(false);
+		run_ms(800);
+		CHECK(V()->phase == DMR_CALL_PHASE_IDLE && V()->tx_error == DMR_TX_OK);
+	}
 }
 
