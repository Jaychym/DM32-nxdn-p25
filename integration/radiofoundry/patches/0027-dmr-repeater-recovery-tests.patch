+// Abort an aligned call waiting for repeater timing, then acquire fresh timing and send again without run/init.
+static void test_repeater_abort_recovery(void)
+{
+	for (int8_t ts = 1; ts <= 2; ts++) {
+		setup();
+		hrc7000_dmr_run(&eng);
+		dmr_config_t cfg = { .own_id = 4001, .cc = 1, .repeater = true };
+		hrc7000_dmr_configure(&eng, &cfg);
+		tick(false);
+		deframe(rti(1, 0, 1, 1, 0, 0));
+		count_kind(0xFF, NULL);
+		CHECK(hrc7000_dmr_tx_begin(&eng, DMR_TIMING_ALIGNED, ts, DMR_ACCESS_IMPOLITE));
+		dmr_tx_burst_t a = voice(0, 1);
+		CHECK(hrc7000_dmr_tx_queue(&eng, &a));
+		hrc7000_dmr_tx_abort(&eng);
+		CHECK(!hrc7000_dmr_is_transmitting(&eng) && !rf_state && eng.tc_agree == 0);
+		CHECK(REG(C7_LAYER2_CONTROL) == 0xC4 && count_kind(DMR_EV_TX_DONE, NULL) == 1);
+		for (uint8_t tc = 0; tc < 4; tc++) {
+			tick(false);
+			deframe(rti(1, 0, 1, 1, tc & 1u, tc & 1u));
+			count_kind(0xFF, NULL);
+		}
+		CHECK(eng.tc_agree >= 4);
+		CHECK(hrc7000_dmr_tx_begin(&eng, DMR_TIMING_ALIGNED, ts, DMR_ACCESS_IMPOLITE));
+		CHECK(hrc7000_dmr_tx_queue(&eng, &a));
+		tick(false);
+		for (int i = 0; i < 3 && rf_on_calls == 0; i++) {
+			tick(true);
+			if (REG(C7_LAYER2_TXRX_CTRL) == 0x80) hrc7000_dmr_isr_rftx(&eng);
+		}
+		CHECK(rf_on_calls == 1 && rf_state);
+		hrc7000_dmr_tx_abort(&eng);
+		CHECK(!rf_state && !hrc7000_dmr_is_transmitting(&eng));
 	}
 }
 
