+
+static void test_dmr_call_end_tone(void)
+{
+    for (unsigned enabled = 0; enabled < 2; enabled++) {
+        dmr_start(false);
+        sm.set.call_end_tone = enabled != 0;
+        sm.set.beep_level = 50;
+        hear_call(true, 201, 3101234, 2, 1, false);
+        CHECK(sm.view.dmr.state == RDMR_RX);
+        beep_reset_stats();
+        uint8_t lc[9]; mk_lc(lc, true, 201, 3101234);
+        burst_lc(lc, 2, true); run(100);
+        beep_stats_t tones; beep_get_stats(&tones);
+        CHECK(sm.view.dmr.state == RDMR_IDLE && tones.played == enabled);
+    }
 }
 
