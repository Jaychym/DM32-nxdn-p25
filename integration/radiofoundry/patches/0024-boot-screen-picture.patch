+// scaled from SPLASH_IMG_SIZE (1:1 on the DM-32), corners rounded
+static void draw_picture(int cx, int cy, int side)
+{
+	for (int y = 0; y < side; y++) {
+		for (int x = 0; x < side; x++) {
+			if (!in_rrect(x, y, 0, 0, side, side, side / 8))
+				continue;
+			int sx = x * SPLASH_IMG_SIZE / side, sy = y * SPLASH_IMG_SIZE / side;
+			uint8_t b = splash_img_px[(sy * SPLASH_IMG_SIZE + sx) / 2];
+			gfx_pixel(cx - side / 2 + x, cy - side / 2 + y, splash_img_pal[(sx & 1) ? b & 0x0Fu : b >> 4]);
+		}
+	}
+}
