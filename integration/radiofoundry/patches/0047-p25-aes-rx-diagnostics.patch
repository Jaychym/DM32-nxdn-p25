+// Whether an encrypted P25 call has something to say for itself: why it is muted (an algorithm we do not decrypt, no
+// key slot on the channel, no key for its key ID, no sync yet, link control that refuses it), or that the key looks
+// wrong while it plays (the vocoder refuses clean frames of what was decrypted)
+static bool dv_enc_note(const radio_dv_view_t *d)
+{
+	return d->enc_state != RDV_ENC_NONE && d->enc_state != RDV_ENC_OK;
+}
+
+// "ALG 81 not supported", "KID 4660: no key", "AES: waiting for sync": what to tell whoever sets the radio up
+static void sb_dv_enc(sbuf_t *b, const radio_dv_view_t *d)
+{
+	switch (d->enc_state) {
+	case RDV_ENC_ALGO:
+		sb_str(b, "ALG ");
+		sb_hex8(b, d->enc_algid);
+		sb_str(b, TR(" not supported"));
+		break;
+	case RDV_ENC_OFF:
+		sb_str(b, TR("Pick an AES-256 key"));
+		break;
+	case RDV_ENC_NOKEY:
+	case RDV_ENC_BAD:
+		sb_str(b, "KID ");
+		sb_u32(b, d->enc_kid, 1);
+		sb_str(b, d->enc_state == RDV_ENC_BAD ? TR(": wrong key?") : TR(": no key"));
+		break;
+	case RDV_ENC_SYNC:
+		sb_str(b, "AES: ");
+		sb_str(b, TR("waiting for sync"));
+		break;
+	case RDV_ENC_LC:
+		sb_str(b, "AES: ");
+		sb_str(b, TR("bad link control"));
+		break;
+	default:
+		break;
 	}
 }
 
