+static void test_vfo_conventional_modes(void)
+{
+	uint32_t old_id = own_dmr_id;
+	own_dmr_id = 4001;
+	setup_codeplug();
+	start();
+	memset(&dv, 0, sizeof(dv));
+	req(RREQ_VFO_SET, 155475000);
+	for (int mode = RADIO_MODE_P25; mode <= RADIO_MODE_NXDN; mode++) {
+		if (!radio_vfo_mode_built(mode)) continue;
+		req(RREQ_MODE, mode);
+		run(30);
+		CHECK(sm.view.vfo && sm.view.ch.mode == mode && sm.dv_running && dv.cfg.mode == mode);
+		CHECK(dv.cfg.nac_rx == (mode == RADIO_MODE_NXDN ? 1 : CODEPLUG_NAC_DEFAULT));
+		CHECK(dv.cfg.nac_tx == dv.cfg.nac_rx && dv.cfg.talkgroup == 1 && sm.view.ch.bw == RADIO_BW_12K5);
+		req(RREQ_VFO_STEP, 1);
+		run(30);
+		CHECK(dv.cfg.rx_hz == sm.view.ch.rx_hz && dv.cfg.tx_hz == sm.view.ch.tx_hz);
+		boot();
+		run(30);
+		CHECK(sm.view.vfo && sm.view.ch.mode == mode && sm.dv_running && dv.cfg.talkgroup == 1);
+		CHECK(dv.cfg.nac_tx == (mode == RADIO_MODE_NXDN ? 1 : CODEPLUG_NAC_DEFAULT));
+		sm.set.talk_permit = false;
+		int downs = dv.downs;
+		req(RREQ_PTT, 1);
+		CHECK(sm.view.state == RS_TX && dv.downs == downs + 1 && dv.cfg.unit_id == 4001);
+		req(RREQ_PTT, 0);
+		dv_tx_ended(NT_TX_COMPLETE_);
+		run(30);
+		CHECK(sm.view.state == RS_IDLE);
+		req(RREQ_MODE, RADIO_MODE_FM);
+		CHECK(!sm.dv_running && sm.view.ch.mode == RADIO_MODE_FM);
+	}
+	// A programmed digital channel copied into the VFO keeps its NAC/RAN and group across a reboot.
+	for (int mode = RADIO_MODE_P25; mode <= RADIO_MODE_NXDN; mode++) {
+		if (!radio_vfo_mode_built(mode)) continue;
+		add(3, "Digital", 155475000, mode, false, 1);
+		chans[3].nac_rx = mode == RADIO_MODE_NXDN ? 0 : CODEPLUG_NAC_ANY;
+		chans[3].nac_tx = mode == RADIO_MODE_NXDN ? 12 : 0x321;
+		chans[3].talkgroup = 123;
+		req(RREQ_VFO, 0);
+		req(RREQ_ZONE_POS, 2);
+		run(30);
+		CHECK(sm.view.ch.mode == mode && radio_vfo_copy_check(&sm.view.ch, false) == VFO_COPY_OK);
+		req(RREQ_VFO_COPY, 0);
+		run(30);
+		CHECK(sm.view.vfo && sm.view.ch.mode == mode && dv.cfg.talkgroup == 123);
+		boot();
+		run(30);
+		CHECK(sm.view.vfo && sm.view.ch.mode == mode && dv.cfg.talkgroup == 123);
+		CHECK(dv.cfg.nac_rx == (mode == RADIO_MODE_NXDN ? 0 : CODEPLUG_NAC_ANY));
+		CHECK(dv.cfg.nac_tx == (mode == RADIO_MODE_NXDN ? 12 : 0x321));
+		settings_t *st = settings_begin();
+		st->vfo_rx_tone = st->vfo_tx_tone = 0xFFFF;
+		settings_set_vfo_talk(st, 65536, false);
+		settings_end(now);
+		boot();
+		run(30);
+		CHECK(dv.cfg.talkgroup == 1 && dv.cfg.nac_rx == dv.cfg.nac_tx);
+		CHECK(dv.cfg.nac_tx == (mode == RADIO_MODE_NXDN ? 1 : CODEPLUG_NAC_DEFAULT));
+		req(RREQ_MODE, RADIO_MODE_FM);
+	}
+	CHECK(!radio_vfo_mode_built(RADIO_MODE_P25_TRUNK) && !radio_vfo_mode_built(-1) && !radio_vfo_mode_built(256));
+	req(RREQ_MODE, RADIO_MODE_P25_TRUNK);
+	CHECK(sm.view.ch.mode == RADIO_MODE_FM);
+#if CONFIG_AM_RX
+	if (board.caps & CAP_AM_RX) {
+		req(RREQ_VFO_SET, 118100000);
+		req(RREQ_MODE, RADIO_MODE_P25);
+		req(RREQ_MODE, RADIO_MODE_NXDN);
+		CHECK(sm.view.ch.mode == RADIO_MODE_FM);
+	}
+#endif
+	req(RREQ_VFO, 0);
+	settings_defaults(settings_begin());
+	settings_end(now);
+	setup_codeplug();
+	own_dmr_id = old_id;
+}
