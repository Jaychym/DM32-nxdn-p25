+#if CONFIG_DMR
+// Why an encrypted DMR call on a channel with an AES key slot is not decrypted: "KID 14: no key", "ALG 24 not
+// supported". False when there is nothing to add (it is being decrypted)
+static bool sb_dmr_aes(sbuf_t *b, const radio_dmr_call_t *c)
+{
+	switch (c->aes) {
+	case RDMR_AES_NONE:
+		sb_str(b, "AES: ");
+		sb_str(b, TR("no PI header"));
+		return true;
+	case RDMR_AES_BAD:
+		sb_str(b, "AES: ");
+		sb_str(b, TR("bad PI header"));
+		return true;
+	case RDMR_AES_FID:
+		sb_str(b, "FID ");
+		sb_hex8(b, c->pi_fid);
+		sb_str(b, TR(" not supported"));
+		return true;
+	case RDMR_AES_ALGO:
+		sb_str(b, "ALG ");
+		sb_hex8(b, c->pi_alg);
+		sb_str(b, TR(" not supported"));
+		return true;
+	case RDMR_AES_NOKEY:
+		sb_str(b, "KID ");
+		sb_u32(b, c->pi_key, 1);
+		sb_str(b, TR(": no key"));
+		return true;
+	default:
+		return false;
+	}
+}
+#endif
 
