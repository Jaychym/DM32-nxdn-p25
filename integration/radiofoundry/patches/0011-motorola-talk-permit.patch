+static void dv_permit_poll(radio_sm_t *sm, uint32_t now_ms)
+{
+	if (sm->dv_permit_ms == 0 || (dv_permit_busy() && now_ms - sm->dv_permit_ms < DV_PERMIT_MAX_MS)) {
+		return;
+	}
+	sm->dv_permit_ms = 0;
+	dv_key(sm, now_ms);
