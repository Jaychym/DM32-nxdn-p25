+// A zone scan tunes the channel at pos. Digital monitor goes with the scan (#5): on where it started (or turned on at a
+// stop), it stays on at each channel the scan tunes and where the scan ends, not just on the channel it was latched on
+static void scan_channel(radio_sm_t *sm, uint16_t pos, const channel_t *ch, uint32_t now_ms)
+{
+	set_channel(sm, pos, ch);
+#if CONFIG_DMR
+	sm->latch_ch = sm->view.channel_number;	// read only while the latch is on
+#endif
+	tune(sm, now_ms);
+}
+
 // End the scan: stay where it is, or (cancel) go back to where it started
 static void scan_stop(radio_sm_t *sm, bool cancel, uint32_t now_ms)
 {
