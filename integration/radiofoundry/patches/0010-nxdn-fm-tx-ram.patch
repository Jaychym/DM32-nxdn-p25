+// --- FM transmit audio from the CPU (8.4, datasheet pp. 271, 339-340) ---
+#define C7_SYS_FM_TX		(1u << 15)
+#define C7_FM_TX_AUDIO		0x030u
+#define HRC7000_FM_TX_SAMPLES	256u
+
+void hrc7000_fm_tx_audio_irq(hrc7000_t *d, bool on);
+// half is the FM_ADDR_SW value captured at the interrupt (1 low, 2 high). High byte first, unlike the prompt FIFO.
+static inline bool hrc7000_fm_tx_audio(hrc7000_t *d, uint32_t half, const int16_t *pcm)
+{
+	if (half != 1u && half != 2u) {
+		return false;
+	}
+	volatile uint8_t *p = &d->buf[C7_FM_TX_AUDIO + (half - 1u) * HRC7000_FM_TX_SAMPLES * 2u];
+	for (uint16_t i = 0; i < HRC7000_FM_TX_SAMPLES; i++) {
+		uint16_t v = (uint16_t)pcm[i];
+		p[2u * i] = (uint8_t)(v >> 8);
+		p[2u * i + 1u] = (uint8_t)v;
+	}
+	return true;
+}
+
