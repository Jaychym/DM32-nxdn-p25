+test("AES slots and 56-byte channel records preserve keys, KIDs and neighboring bits", () => {
+ const m = empty(); m.general.aesKeys[0] = { kid: 42, key };
+ for (const mode of ["dmr", "p25"]) m.channels.push(newChannel({ name: mode, mode, rxHz: 450000000, txHz: 450000000, aesSlot: 1, talkgroup: 42, nacRx: 1, nacTx: 12500 }));
+ let img = encode(m), back = decode(img);
+ assert.deepEqual(back.general.aesKeys[0], { kid: 42, key });
+ assert.deepEqual(back.channels.map((c) => c.aesSlot), [1,1]);
+ assert.deepEqual(encode(back).bytes, img.bytes);
+ const a = channelAddr(1) + 0x32; img.bytes[a] |= 0xE0;
+ back = decode(img); back.channels[0].aesSlot = 4;
+ const edited = encode(back); assert.equal(edited.bytes[a], 0xF4);
+ assert.deepEqual(edited.bytes.subarray(0x7C00,0x7D90), img.bytes.subarray(0x7C00,0x7D90));
+ back.channels[0].aesSlot = 0; assert.equal(decode(encode(back)).channels[0].aesSlot,0);
