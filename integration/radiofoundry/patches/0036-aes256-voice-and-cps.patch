+  }
+  put(e, 92, crc(e.subarray(0, 92))); changed = true;
+ }
+ if (changed) {
+  const h = b.subarray(BASE, BASE + 16); h.fill(0); h.set(magic); h[8] = SLOTS; h[9] = ENTRY;
+  put(h, 12, crc(h.subarray(0, 12)));
+ }
+}
