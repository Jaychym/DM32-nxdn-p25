+#if CONFIG_DV_AES
+enum { AES_BASE = 0x7C00, AES_ENTRY = 96, AES_SLOTS = 4 };
+static uint32_t aes_u32(const uint8_t *p)
+{ return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24); }
+static void aes_put32(uint8_t *p, uint32_t n)
+{ for (unsigned i = 0; i < 4; i++) p[i] = (uint8_t)(n >> (i * 8)); }
+static bool aes_entry(uint8_t slot, uint8_t e[AES_ENTRY])
+{
+    uint8_t h[16];
+    return slot >= 1 && slot <= AES_SLOTS && board.flash &&
+        board.flash->read(EE(AES_BASE), h, sizeof h) && !memcmp(h, "DVAES1\0\0", 8) &&
+        h[8] == AES_SLOTS && h[9] == AES_ENTRY && aes_u32(h + 12) == storage_crc32(0, h, 12) &&
+        board.flash->read(EE(AES_BASE + 16 + (slot - 1) * AES_ENTRY), e, AES_ENTRY) &&
+        e[0] == 1 && e[1] == 0 && (e[2] || e[3]) &&
+        aes_u32(e + 92) == storage_crc32(0, e, 92);
+}
+bool codeplug_aes_key(uint8_t slot, uint8_t key[32], uint16_t *kid)
+{
+    uint8_t e[AES_ENTRY];
+    storage_lock();
+    bool ok = aes_entry(slot, e);
+    storage_unlock();
+    if (ok) { memcpy(key, e + 4, 32); *kid = (uint16_t)(e[2] | (e[3] << 8)); }
+    voice_aes_wipe(e, sizeof e);
+    return ok;
+}
+bool codeplug_aes_lookup(uint16_t kid, uint8_t key[32])
+{
+    bool found = false;
+    uint8_t candidate[32]; uint16_t id;
+    for (uint8_t slot = 1; slot <= AES_SLOTS; slot++) {
+        if (!codeplug_aes_key(slot, candidate, &id) || id != kid) continue;
+        if (found) { voice_aes_wipe(candidate, sizeof candidate); return false; }
+        memcpy(key, candidate, 32); found = true;
+    }
+    voice_aes_wipe(candidate, sizeof candidate);
+    return found;
+}
+static uint64_t aes_apply(const uint64_t m[64], uint64_t v)
+{
+    uint64_t result = 0;
+    for (unsigned i = 0; v; i++, v >>= 1) if (v & 1) result ^= m[i];
+    return result;
+}
+// Jump whole superframes without iterating over the radio's lifetime of reservations.
+static uint64_t aes_jump(uint64_t mi, uint32_t n, bool dmr)
+{
+    uint64_t m[64], square[64];
+    unsigned bits = dmr ? 32 : 64;
+    for (unsigned i = 0; i < bits; i++)
+        m[i] = dmr ? voice_aes_dmr_step((uint32_t)(1ULL << i)) : voice_aes_p25_step(1ULL << i);
+    while (n) {
+        if (n & 1) mi = aes_apply(m, mi);
+        n >>= 1;
+        if (!n) break;
+        for (unsigned i = 0; i < bits; i++) square[i] = aes_apply(m, m[i]);
+        memcpy(m, square, bits * sizeof *m);
+    }
+    voice_aes_wipe(m, sizeof m); voice_aes_wipe(square, sizeof square);
+    return mi;
+}
+bool codeplug_aes_reserve(uint8_t slot, uint64_t *p25_mi, uint32_t *dmr_mi)
+{
+    uint8_t e[AES_ENTRY], iv[16]; hal_chip_t chip;
+    struct AES_ctx cipher;
+    bool ok = false;
+    storage_lock();
+    if (!aes_entry(slot, e) || !board.system || !board.system->chip || !board.system->chip(&chip) ||
+        !(chip.uid[0] | chip.uid[1] | chip.uid[2])) goto done;
+    memcpy(iv, e + 36, 16);
+    for (unsigned i = 0; i < 12; i++) iv[i] ^= (uint8_t)(chip.uid[i / 4] >> (8 * (i % 4)));
+    AES_init_ctx(&cipher, e + 4); AES_ECB_encrypt(&cipher, iv);
+    uint64_t pmi = 0; uint32_t dmi = 0;
+    for (unsigned i = 0; i < 8; i++) pmi = (pmi << 8) | iv[i];
+    for (unsigned i = 8; i < 12; i++) dmi = (dmi << 8) | iv[i];
+    if (!pmi || !dmi) goto done; // zero is an LFSR fixed point
+    settings_t *settings = settings_begin();
+    uint32_t n = settings->aes_next_sf;
+    settings_end(hal_millis());
+    if ((!n && !memcmp(e + 52, chip.uid, 12)) || n > UINT32_MAX - VOICE_AES_RESERVE) goto done;
+    if (memcmp(e + 52, chip.uid, 12)) {
+        memcpy(e + 52, chip.uid, 12);
+        aes_put32(e + 92, storage_crc32(0, e, 92));
+        if (!storage_write(EE(AES_BASE + 16 + (slot - 1) * AES_ENTRY), e, AES_ENTRY)) goto done;
+    }
+    settings = settings_begin(); settings->aes_next_sf = n + VOICE_AES_RESERVE;
+    settings_end(hal_millis());
+    if (!settings_flush()) goto done;
+    *p25_mi = aes_jump(pmi, n, false); *dmr_mi = (uint32_t)aes_jump(dmi, n, true);
+    ok = true;
+done:
+    voice_aes_wipe(e, sizeof e); voice_aes_wipe(iv, sizeof iv); voice_aes_wipe(&cipher, sizeof cipher);
+    storage_unlock();
+    return ok;
+}
+#else
+bool codeplug_aes_key(uint8_t slot, uint8_t key[32], uint16_t *kid)
