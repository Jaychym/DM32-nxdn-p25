+static bool mixOn(int16_t *s) { (void)s; return true; }
+
+// A talk permit beep on its own stream holds the speaker route on as the voice stream takes it over at the key-up: the
+// voice's first block gives it back (on the radio the microphone reached the codec flat through the whole call)
+static void testRouteHandoff(void)
+{
+	const dmr_voice_source_t *src = ambeVoiceSource();
+	ambeVoiceStop();
+	fake_speaker(true);	// the beep's last block
+	int calls = speaker_calls;
+	src->begin(src->ctx);
+	block();
+	CHECK(!speaker_on && speaker_calls == calls + 1, "the first block gives the route back (on %d)", speaker_on);
+	block();
+	CHECK(speaker_calls == calls + 1, "once");
+	src->end(src->ctx);
+
+	// A beep still mixed in that first block keeps the route, then lets it go
+	ambeVoiceStop();
+	fake_speaker(true);
+	ambeVoiceSetMixer(mixOn);
+	src->begin(src->ctx);
+	block();
+	CHECK(speaker_on, "a mixed beep keeps the route");
+	ambeVoiceSetMixer(NULL);
+	block();
+	CHECK(!speaker_on, "off after the beep");
+	src->end(src->ctx);
+}
+
 int main(void)
 {
 	ambeVoiceInit(&audio, &vocoder);
@@ -492,6 +522,7 @@
 	CHECK(stops == 1 && !speaker_on, "stop");
 	ambeVoiceSink()->begin(NULL, NULL);
 	CHECK(starts == 2, "restarted after stop");
+	testRouteHandoff();
 	printf("# ambeVoiceTest: %d checks, %s\n", checks, failures ? "FAILED" : "PASSED");
 	return failures ? 1 : 0;
 }
