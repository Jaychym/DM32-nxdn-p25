--- a/core/dmr/ambe/ambeVoice.c
+++ b/core/dmr/ambe/ambeVoice.c
@@ -64,10 +64,14 @@
 static uint32_t enc_opts = VOCODER_OPT_DEFAULT;	// ambeVoiceSetEncodeOptions: any task
 static uint32_t cb_enc_opts;		// what the vocoder was last given (audio callback)
 static bool cb_enc_opts_set;		// cb_enc_opts is valid
+static bool route_stale;		// set by the call task before a start, cleared by the audio callback
 
 static void ensure_streaming(void)
 {
 	if (!streaming && aud != NULL) {
+		// The stream may be taken over from another user (a beep's own stream) that left the speaker route on: our
+		// first block sends our own route (ambeVoiceAudioBlock)
+		STORE(route_stale, true);
 		streaming = aud->start(ambeVoiceAudioBlock, NULL);
 	}
 }
@@ -445,6 +449,12 @@
 void ambeVoiceAudioBlock(const int16_t *mic, int16_t *spk, void *ctx)
 {
 	(void)ctx;
+	// A (re)started stream: our route is off until this block turns it on (ambeVoiceStop left cb_speaker as it was)
+	bool stale = LOAD(route_stale);
+	if (stale) {
+		STORE(route_stale, false);
+		cb_speaker = false;
+	}
 	// DMR is simplex: TX first (a fresh transmission resets the vocoder), then RX playback
 	tx_block(mic);
 	rx_block(spk);
@@ -458,6 +468,11 @@
 			speaker(false);
 		}
 	}
+	// A talk permit beep on its own stream, handed over at the key-up, left the route and the amplifier on through the
+	// whole first transmission, and the microphone reached the codec flat (measured on a radio: 3 dB against 39 dB)
+	if (stale && !cb_speaker && aud != NULL && aud->speaker_pcm != NULL) {
+		aud->speaker_pcm(false);
+	}
 }
 
