--- a/boards/dm32/radio_dm32.c
+++ b/boards/dm32/radio_dm32.c
@@ -182,6 +182,9 @@
 	if (!tx) {
 		pa_off();
 	} else {
+		// Every burst (DMR voice, P25 native) takes the microphone on the codec, whatever retuned the route before it:
+		// a stale receive route sends valid frames of near silence
+		hrc_pin_write(PIN_MIC_PATH, false);
 		lna(tx_hz, false);
 	}
 	// A split channel (repeater, duplex hotspot): the one synthesizer moves to the TX frequency for the burst and back
@@ -358,6 +361,10 @@
 	// synthesizer on the TX frequency here left the radio deaf to the repeater's downlink
 	fd6818_set_freq(&fd, synth_hz(mode == RADIO_MODE_DMR && have_rx ? rx_hz : hz));
 	hrc_dac_b_power(true);
+	// Claim TX before routing the microphone: speaker_source() (the audio task's speaker_pcm) leaves PIN_MIC_PATH alone
+	// only while transmitting. Set after the routing, a speaker change in between put the microphone back on the
+	// receive route and the first DMR call went out with near-silent voice (RadioFoundry 9e1f7209, #606)
+	transmitting = true;
 	if (mode == RADIO_MODE_DMR) {
 		// 8.5 "Enter DMR TX": the PA select and drive wait for the PA one-shot of each burst. Between bursts the radio
 		// receives: the FD6818 in RX and the LNA on until the RF TX interrupt switches to the first burst
@@ -380,7 +387,6 @@
 		fd6818_set_state(&fd, FD6818_STATE_TX);
 		pa_key();
 	}
-	transmitting = true;
 	ring_play();
 	return true;
 }
